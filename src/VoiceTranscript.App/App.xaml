<Application x:Class="VoiceTranscript.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:VoiceTranscript.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Styles/Theme.xaml" />
                <ResourceDictionary Source="Styles/Components.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:PageVisibilityConverter x:Key="PageVisibility" />
            <local:CountToVisibilityConverter x:Key="CountToVisibility" />
            <local:AsrModeNameConverter x:Key="AsrModeName" />
            <local:NullToBoolConverter x:Key="NullToBool" />
            <local:SpeakerAlignmentConverter x:Key="SpeakerAlignment" />
            <local:SpeakerBackgroundConverter x:Key="SpeakerBackground" />
            <local:InitialsConverter x:Key="Initials" />
            <local:NameToBrushConverter x:Key="NameBrush" />
            <local:DurationConverter x:Key="Duration" />
            <local:RelativeDateConverter x:Key="RelativeDate" />
            <local:LevelToWidthConverter x:Key="LevelWidth" />
            <local:ByteSizeConverter x:Key="ByteSize" />
            <local:PositiveToVisibilityConverter x:Key="PositiveToVisibility" />
            <local:RatioToStarConverter x:Key="RatioStar" />
            <local:SearchEmptyTitleConverter x:Key="SearchEmptyTitle" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:LedgerEmptyTitleConverter x:Key="LedgerEmptyTitle" />
            <local:LedgerEmptyBodyConverter x:Key="LedgerEmptyBody" />
            <local:ListeningToConverter x:Key="ListeningTo" />
            <local:ModelPresenceConverter x:Key="ModelPresence" />
            <local:SearchPeriodNameConverter x:Key="PeriodName" />
            <local:BrushFromKeyConverter x:Key="BrushFromKey" />
            <local:HealthHeadlineConverter x:Key="HealthHeadline" />
            <local:PhotoConverter x:Key="Photo" />
            <local:TagToIconConverter x:Key="TagIcon" />
            <local:TagToBrushConverter x:Key="TagBrush" />
            <local:SymbolFromNameConverter x:Key="SymbolFromName" />
            <local:EqualsParameterConverter x:Key="IsPage" />

            <!-- The same test under the name a filter chip uses: is this the selected value.
                 A chip that keeps its own IsChecked="True" in the markup is showing a
                 selection the view model does not know it has. -->
            <local:EqualsParameterConverter x:Key="IsValue" />
            <local:EqualToVisibilityConverter x:Key="EqualToVisibility" />
            <local:FilterToAppearanceConverter x:Key="FilterAppearance" />
            <local:BoolToCursorConverter x:Key="HandWhenTrue" />

            <!-- A circle's colour, and the pill that says which tab is chosen. The tab carries
                 its own IsSelected, so the strip reads the selection from the view model rather
                 than deciding for itself which pill looks pressed. -->
            <local:HexToBrushConverter x:Key="HexBrush" />
            <local:SelectedToAppearanceConverter x:Key="SelectedAppearance" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
