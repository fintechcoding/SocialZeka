<ui:FluentWindow x:Class="VoiceTranscript.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tb="http://www.hardcodet.net/taskbar"
                 xmlns:views="clr-namespace:VoiceTranscript.App.Views"
                 xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:ShellViewModel}"
                 Title="{Binding WindowTitle}"
                 Icon="pack://application:,,,/VoiceTranscript;component/icon.ico"
                 Width="1320" Height="880"
                 MinWidth="1200" MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <!-- The keyboard layer is built in code from ActionRegistry, so the keys, the rail order,
         the palette and the Ctrl+? sheet are one list. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/VoiceTranscript;component/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                Left rail.

                Three bands: what the application is doing right now, where to go, and the tools.
                The status band is at the top because this application spends nearly all its life
                doing nothing visible, so the one question a glance has to answer is whether it is
                actually watching — and, during a call, whether it is actually hearing anything.
            -->
            <!--
                A ground of its own, and a line where it ends.

                The rail and the page were painted the same colour, so the two read as one
                surface with some buttons floating in the left of it: nothing said where
                navigation stopped and content began. A slightly recessed panel with a single
                hairline down its edge is the whole fix — the eye needs a boundary, not a
                decoration.
            -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0" />

            <Grid Grid.Column="0" Margin="12,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status -->
                <Border Grid.Row="0" Style="{StaticResource HeroCard}" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                                       FontSize="{StaticResource TextBody}" VerticalAlignment="Center" />

                            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="8,0,0,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="22,5,0,0" />

                        <!--
                            Record on demand.

                            Detection is good but not perfect, and a conversation that was not
                            recorded cannot be recorded afterwards. One button that always works
                            is worth more than any amount of confidence in the heuristic.
                        -->
                        <ui:Button HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                   Content="{loc:T mainwindow.kaydi-baslat}" Command="{Binding StartManualRecordingCommand}"
                                   Visibility="{Binding IsManualRecording, Converter={StaticResource InverseBoolToVisibility}}"
                                   IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBool}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Record24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <ui:Button HorizontalAlignment="Stretch" Margin="0,12,0,0" Appearance="Danger"
                                   Content="{loc:T mainwindow.kaydi-durdur}" Command="{Binding StopManualRecordingCommand}"
                                   Visibility="{Binding IsManualRecording, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Stop24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <!--
                            Live level meters, shown only while recording.

                            This is the answer to "is it actually picking up sound", given while
                            there is still time to do something about it. Every other report in
                            the application can only say so afterwards, which is exactly when it
                            is useless.
                        -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Mic24" FontSize="14" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Border Style="{StaticResource MeterTrack}" />
                                    <Border Style="{StaticResource MeterFill}"
                                            Background="{DynamicResource MeBrush}"
                                            Width="{Binding MicLevel, Converter={StaticResource LevelWidth}, ConverterParameter=170}" />
                                </Grid>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Speaker224" FontSize="14" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Border Style="{StaticResource MeterTrack}" />
                                    <Border Style="{StaticResource MeterFill}"
                                            Background="{DynamicResource ThemBrush}"
                                            Width="{Binding FarLevel, Converter={StaticResource LevelWidth}, ConverterParameter=170}" />
                                </Grid>
                            </Grid>

                            <TextBlock Text="{Binding LevelHint}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding LevelHint, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation: grouped the way the product is used — the calls themselves, what
                     the calls left behind, and the two ways to look something up. The Ctrl digits
                     follow this order; ActionRegistry is the one list they and the rail come from. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{loc:T mainwindow.grup-gorusmeler}" Style="{StaticResource Caption}"
                               FontWeight="SemiBold" Margin="14,2,0,4" />

                    <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=Overview}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Overview">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T mainwindow.genel-bakis}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=Calls}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Calls">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Call24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T mainwindow.gorusmeler}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=Contacts}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Contacts">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T mainwindow.kisiler}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="{loc:T mainwindow.grup-hafiza}" Style="{StaticResource Caption}"
                               FontWeight="SemiBold" Margin="14,12,0,4" />

                    <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=Ledger}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Ledger">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Flag24" FontSize="17" Margin="0,0,12,0"
                                           VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{loc:T mainwindow.defter}" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource CountPill}"
                                    Visibility="{Binding OpenFlagCount, Converter={StaticResource PositiveToVisibility}}">
                                <TextBlock Style="{StaticResource CountPillText}" Text="{Binding OpenFlagCount}" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=Promises}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Promises">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Handshake24" FontSize="17" Margin="0,0,12,0"
                                           VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{loc:T mainwindow.sozler}" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource CountPill}"
                                    Visibility="{Binding OverduePromiseCount, Converter={StaticResource PositiveToVisibility}}">
                                <TextBlock Style="{StaticResource CountPillText}" Text="{Binding OverduePromiseCount}" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=Calendar}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Calendar">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T mainwindow.takvim}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=Todo}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Todo">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TaskListLtr24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T mainwindow.yapilacaklar}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- The one band about the user rather than about somebody they spoke to. -->
                    <TextBlock Text="{loc:T mainwindow.grup-kocluk}" Style="{StaticResource Caption}"
                               FontWeight="SemiBold" Margin="14,12,0,4" />

                    <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=Mirror}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Mirror">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PersonFeedback24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T mainwindow.aynam}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="{loc:T mainwindow.grup-bul}" Style="{StaticResource Caption}"
                               FontWeight="SemiBold" Margin="14,12,0,4" />

                    <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=Search}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Search">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T mainwindow.arama}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=Ask}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Ask">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Chat24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T mainwindow.sor}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                </ScrollViewer>

                <!-- Tools -->
                <StackPanel Grid.Row="3">
                    <Border Style="{StaticResource Hairline}" Margin="4,0,4,10" />

                    <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                 IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource IsPage}, ConverterParameter=Health}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Health">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Pulse24" FontSize="17" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T mainwindow.durum}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>


                    <!-- The bell: a missed toast is recoverable here. The badge counts what
                         arrived while nobody was looking; opening the list clears it. -->
                    <ui:Button x:Name="BellButton" HorizontalAlignment="Stretch" Appearance="Transparent"
                               Margin="0,0,0,2" HorizontalContentAlignment="Left" Padding="14,9"
                               Click="Bell_Click">
                        <Grid HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Alert24" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:T mainwindow.bildirimler}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Style="{StaticResource CountPill}" HorizontalAlignment="Right"
                                    Visibility="{Binding HasUnseenNotices, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource CountPillText}" Text="{Binding UnseenNoticeCount}" />
                            </Border>
                        </Grid>
                        <ui:Button.ContextMenu>
                            <ContextMenu x:Name="BellMenu" Placement="Right" MaxWidth="420">
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="{DynamicResource FlyoutBackground}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="8"
                                                MaxHeight="420">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:T mainwindow.son-bildirimler}" FontWeight="SemiBold"
                                                               Margin="6,2,6,6" />
                                                    <ItemsControl ItemsSource="{Binding NoticeHistory}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="6,4" MaxWidth="380">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon}"
                                                                                   FontSize="14" Margin="0,2,8,0"
                                                                                   VerticalAlignment="Top" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                                               TextWrapping="Wrap"
                                                                               FontSize="{StaticResource TextSecondary}" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding When}"
                                                                               Style="{StaticResource Caption}"
                                                                               Margin="8,2,0,0" VerticalAlignment="Top" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{loc:T mainwindow.henuz-bildirim-yok}" Margin="6,4">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NoticeHistory.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>

                    <ui:Button HorizontalAlignment="Stretch" Appearance="Transparent" Margin="0,0,0,2"
                               HorizontalContentAlignment="Left" Padding="14,9" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="{loc:T mainwindow.ayarlar}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ContentLayer}">
            <Grid>
                <views:OverviewPage Style="{StaticResource PageHost}" DataContext="{Binding Overview}">
                    <views:OverviewPage.Visibility>
                        <MultiBinding Converter="{StaticResource PageVisibility}">
                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Source="Overview" />
                        </MultiBinding>
                    </views:OverviewPage.Visibility>
                </views:OverviewPage>

                <views:CallsPage Style="{StaticResource PageHost}" DataContext="{Binding Calls}">
                    <views:CallsPage.Visibility>
                        <MultiBinding Converter="{StaticResource PageVisibility}">
                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Source="Calls" />
                        </MultiBinding>
                    </views:CallsPage.Visibility>
                </views:CallsPage>

                <views:LedgerPage Style="{StaticResource PageHost}" DataContext="{Binding Ledger}">
                    <views:LedgerPage.Visibility>
                        <MultiBinding Converter="{StaticResource PageVisibility}">
                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Source="Ledger" />
                        </MultiBinding>
                    </views:LedgerPage.Visibility>
                </views:LedgerPage>

                <views:CalendarPage Style="{StaticResource PageHost}" DataContext="{Binding Calendar}">
                    <views:CalendarPage.Visibility>
                        <MultiBinding Converter="{StaticResource PageVisibility}">
                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Source="Calendar" />
                        </MultiBinding>
                    </views:CalendarPage.Visibility>
                </views:CalendarPage>

                <views:TodoPage Style="{StaticResource PageHost}" DataContext="{Binding Todo}">
                    <views:TodoPage.Visibility>
                        <MultiBinding Converter="{StaticResource PageVisibility}">
                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Source="Todo" />
                        </MultiBinding>
                    </views:TodoPage.Visibility>
                </views:TodoPage>

                <views:PromisesPage Style="{StaticResource PageHost}" DataContext="{Binding Promises}">
                    <views:PromisesPage.Visibility>
                        <MultiBinding Converter="{StaticResource PageVisibility}">
                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Source="Promises" />
                        </MultiBinding>
                    </views:PromisesPage.Visibility>
                </views:PromisesPage>

                <views:MirrorPage Style="{StaticResource PageHost}" DataContext="{Binding Mirror}">
                    <views:MirrorPage.Visibility>
                        <MultiBinding Converter="{StaticResource PageVisibility}">
                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Source="Mirror" />
                        </MultiBinding>
                    </views:MirrorPage.Visibility>
                </views:MirrorPage>

                <views:ContactsPage Style="{StaticResource PageHost}" DataContext="{Binding Contacts}">
                    <views:ContactsPage.Visibility>
                        <MultiBinding Converter="{StaticResource PageVisibility}">
                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Source="Contacts" />
                        </MultiBinding>
                    </views:ContactsPage.Visibility>
                </views:ContactsPage>


                <views:HealthPage x:Name="HealthView" Style="{StaticResource PageHost}" DataContext="{Binding Health}">
                    <views:HealthPage.Visibility>
                        <MultiBinding Converter="{StaticResource PageVisibility}">
                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Source="Health" />
                        </MultiBinding>
                    </views:HealthPage.Visibility>
                </views:HealthPage>

                <views:AskPage Style="{StaticResource PageHost}" DataContext="{Binding Ask}">
                    <views:AskPage.Visibility>
                        <MultiBinding Converter="{StaticResource PageVisibility}">
                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Source="Ask" />
                        </MultiBinding>
                    </views:AskPage.Visibility>
                </views:AskPage>

                <views:SearchPage Style="{StaticResource PageHost}" DataContext="{Binding Search}">
                    <views:SearchPage.Visibility>
                        <MultiBinding Converter="{StaticResource PageVisibility}">
                            <Binding Path="DataContext.Page" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Source="Search" />
                        </MultiBinding>
                    </views:SearchPage.Visibility>
                </views:SearchPage>
            </Grid>
            </Border>
        </Grid>

        <!--
            Notices.

            A snackbar that appears, says its piece and leaves, rather than a bar that stays until
            somebody dismisses it. This application talks often — a call ended, a service was
            skipped, a stream was silent — and a permanent bar for each one either gets ignored or
            has to be closed by hand every time, which is worse than not saying anything.

            Anything that must not be missed does not come through here: a silent stream also
            turns the status dot, and a failed call also appears on the overview.
        -->
        <ui:SnackbarPresenter x:Name="Notices" Grid.Row="1" VerticalAlignment="Bottom"
                              HorizontalAlignment="Center" Margin="0,0,0,20" />

        <tb:TaskbarIcon x:Name="Tray"
                        IconSource="pack://application:,,,/VoiceTranscript;component/icon.ico"
                        ToolTipText="{Binding TrayText}"
                        NoLeftClickDelay="True"
                        TrayLeftMouseUp="Tray_Click">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:T mainwindow.pencereyi-goster}" Click="ShowWindow_Click" />

                    <!--
                        The switch, one click from the notification area.

                        Here rather than only in settings because of when somebody reaches for
                        it: they decide they do not want the next conversation recorded seconds
                        before it starts, and a settings window four clicks deep is not reachable
                        in that moment.
                    -->
                    <MenuItem x:Name="AutoRecordItem" Header="{loc:T mainwindow.otomatik-kayit}" IsCheckable="True"
                              Click="ToggleAutoRecord_Click" />

                    <Separator />
                    <MenuItem Header="{loc:T mainwindow.cikis}" Click="Exit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- In-window dialog layer: Dialogs.ConfirmAsync/InfoAsync present here, over
             everything, instead of the Win32-gray MessageBox. -->
        <ContentPresenter x:Name="DialogHost" Grid.RowSpan="99" Grid.ColumnSpan="99"
                          Panel.ZIndex="9999" />
    </Grid>
</ui:FluentWindow>