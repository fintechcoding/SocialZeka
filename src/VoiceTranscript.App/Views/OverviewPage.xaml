<UserControl x:Class="VoiceTranscript.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OverviewViewModel}">

    <!--
        Two columns: the day's report on the left, the user's own workspace pinned on the right.

        The workspace lives outside the scroll on purpose. It is the drop target for the rows on
        the left, and a drop target that may have been scrolled away is a feature that works only
        when the window happens to be arranged right. Pinned, it is always exactly where the drag
        is headed — and the wide-window emptiness on the right becomes the thing it was for.
    -->
    <Grid Margin="24,4,24,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,20,24">
        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">

            <TextBlock Text="{loc:T overviewpage.genel-bakis}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{loc:T overviewpage.ne-kaydedildi-ne-bekliyor-neye-bakman-gere}" />

            <!--
                Four numbers, one card.

                Separate cards for each would turn a summary into a grid of boxes; these belong
                together because they are read together, as one sentence about the archive.
            -->
            <Border Style="{StaticResource HeroCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalCalls}" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="{loc:T overviewpage.gorusme}" />
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Margin="16,4" VerticalAlignment="Stretch"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalContacts}" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="{loc:T overviewpage.kisi}" />
                    </StackPanel>

                    <Border Grid.Column="3" Width="1" Margin="16,4" VerticalAlignment="Stretch"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalRecorded}" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="{loc:T overviewpage.kayit-suresi}" />
                    </StackPanel>

                    <Border Grid.Column="5" Width="1" Margin="16,4" VerticalAlignment="Stretch"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!--
                        Not analysed, rather than "waiting to process".

                        The queue figure counted the resting state too, so with no model connected
                        every call landed in it and stayed: the number equalled the total number of
                        calls and could never fall. A real screen read "13 görüşme … 13 işlem
                        bekliyor" — the same number twice, one of them dressed up as a backlog.

                        This one is a fact rather than a queue, and it is the one that is true on a
                        machine with no model: the text is kept, and connecting one later repeats
                        only the analysis. The queue itself has a screen of its own, with reasons
                        beside each row, which is where a backlog belongs.
                    -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding Unanalysed}" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="{loc:T overviewpage.cozumlenmedi}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                Things that want a decision.

                First on the page on purpose. A recording nobody has named, a promise that came
                due, a job that failed — these are the reasons to open this window at all, and
                burying them under an archive listing is how they get missed.
            -->
            <StackPanel Visibility="{Binding Attention.Count, Converter={StaticResource CountToVisibility}}">
                <TextBlock Text="{loc:T overviewpage.dikkat}" Style="{StaticResource GroupHeader}" />

                <ItemsControl ItemsSource="{Binding Attention}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SettingCard}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--
                                        Colour follows severity, which it did not before.

                                        The view model has always computed a brush per kind — red
                                        for broken, amber for wants-a-decision, blue for worth
                                        knowing — and nothing read it: every notice was drawn amber
                                        regardless. A screen where a broken recorder and a spelling
                                        suggestion look identical is a screen where neither reads
                                        as urgent.
                                    -->
                                    <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon}" FontSize="18"
                                                   Margin="0,0,14,0" VerticalAlignment="Center"
                                                   Foreground="{Binding BrushKey, Converter={StaticResource BrushFromKey}}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   FontSize="{StaticResource TextBody}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="2" Content="{Binding ActionLabel}" Margin="14,0,0,0"
                                               MinWidth="112" VerticalAlignment="Center" Appearance="Primary"
                                               Command="{Binding DataContext.RunActionCommand,
                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Promises that came due. -->
            <StackPanel Visibility="{Binding Overdue.Count, Converter={StaticResource CountToVisibility}}">
                <TextBlock Text="{loc:T overviewpage.vadesi-gecen-sozler}" Style="{StaticResource GroupHeader}" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,10"
                           Text="{loc:T overviewpage.soylenmis-ve-tarihi-gecmis-alinti-konusmad}" />

                <ItemsControl ItemsSource="{Binding Overdue}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SettingCard}" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0" Symbol="Clock24" FontSize="18"
                                                   Margin="0,0,14,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Line}" FontWeight="SemiBold"
                                                   FontSize="{StaticResource TextBody}" TextWrapping="Wrap" />

                                        <Border Style="{StaticResource QuoteBlock}"
                                                BorderBrush="{StaticResource ThemBrush}">
                                            <TextBlock Style="{StaticResource QuoteText}" Text="{Binding Quote}" />
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Column="2" Style="{StaticResource CountPill}" Margin="14,0,0,0"
                                            VerticalAlignment="Top">
                                        <TextBlock Style="{StaticResource CountPillText}"
                                                   Text="{Binding DaysLate, StringFormat='{}{0} gün'}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- The archive. -->
            <StackPanel Visibility="{Binding Recent.Count, Converter={StaticResource CountToVisibility}}">
                <TextBlock Text="{loc:T overviewpage.son-gorusmeler}" Style="{StaticResource GroupHeader}"
                           Margin="0,18,0,0" />

                <ItemsControl ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                                The row opens the conversation.

                                It already looked like something you could press — a card that
                                lifts under the pointer — and did nothing when pressed, which is a
                                worse state than a plain list: it teaches people that the first
                                screen is a display rather than a way in. This is the shortest path
                                from "what happened today" to reading it.
                            -->
                            <Border Style="{StaticResource HoverCard}" Cursor="Hand"
                                    MouseLeftButtonUp="RecentCall_Click"
                                    PreviewMouseLeftButtonDown="Drag_Prime"
                                    PreviewMouseMove="RecentCall_DragMove"
                                    ToolTip="Görüşmeyi aç · yukarıdaki panele sürüklenebilir">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Görüşmeyi aç" Click="RecentOpen_Click" />
                                        <MenuItem Header="Önemlilere ekle" Click="RecentToBoard_Click" />
                                        <!-- One doorway for reminders everywhere: the dialog
                                             asks for the reason as well as the day, so the card
                                             that comes back says why it came back. -->
                                        <MenuItem Header="Hatırlat…" Click="RecentRemind_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Initials on a colour derived from the name, so the same
                                         person is the same colour everywhere and the eye finds
                                         them before it reads. -->
                                    <Border Grid.Column="0" Style="{StaticResource Avatar}" Margin="0,0,14,0"
                                            Background="{Binding ContactName, Converter={StaticResource NameBrush}}">
                                        <TextBlock Style="{StaticResource AvatarText}"
                                                   Text="{Binding ContactName, Converter={StaticResource Initials}}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ContactName}" FontWeight="SemiBold"
                                                   FontSize="{StaticResource TextBody}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Style="{StaticResource Caption}"
                                                       Text="{Binding StartedAt, Converter={StaticResource RelativeDate}}" />
                                            <TextBlock Style="{StaticResource Caption}" Text=" · " />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Status}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0"
                                                VerticalAlignment="Center">
                                        <!-- The user's labels, where they first look. A call
                                             marked "tehdit" that only shows it three screens
                                             deep is a label that does not work. -->
                                        <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center"
                                                      Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,0"
                                                            Background="{Binding Converter={StaticResource TagBrush}}"
                                                                Cursor="Hand" MouseLeftButtonUp="TagPill_Click"
                                                                ToolTip="Bu etiketi taşıyan görüşmeleri ara">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="{Binding Converter={StaticResource TagIcon}}"
                                                                           FontSize="11" Foreground="White" Margin="0,0,3,0"
                                                                           VerticalAlignment="Center" />
                                                            <TextBlock Style="{StaticResource PillText}"
                                                                       Foreground="White" Text="{Binding}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Style="{StaticResource Pill}">
                                            <TextBlock Style="{StaticResource PillText}" Text="{Binding AppName}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14"
                                                         Margin="0,0,10,0"
                                                         Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Length}" FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                                   FontSize="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--
                Removing the example.

                Offered wherever it is loaded, because a demonstration that cannot be cleared out
                stops being a demonstration and becomes clutter in somebody's real archive.
            -->
            <Border Style="{StaticResource SettingCard}" Margin="0,8,0,0"
                    Visibility="{Binding HasSample, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Sparkle24" FontSize="18" Margin="0,0,14,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T overviewpage.ornek-gorusmeler-yuklu}" FontWeight="SemiBold"
                                   FontSize="{StaticResource TextBody}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="{loc:T overviewpage.bunlar-gercek-kayit-degil-kendi-gorusmeler}" />
                    </StackPanel>

                    <ui:Button Grid.Column="2" Content="{loc:T overviewpage.kaldir}" Margin="14,0,0,0"
                               Command="{Binding RemoveSampleCommand}" />
                </Grid>
            </Border>

            <!-- Nothing recorded yet. -->
            <StackPanel Style="{StaticResource EmptyState}" Margin="24,64,24,24"
                        Visibility="{Binding HasAnyData, Converter={StaticResource InverseBoolToVisibility}}">
                <ui:SymbolIcon Symbol="Call24" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,16"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T overviewpage.henuz-kayit-yok}" />
                <TextBlock Style="{StaticResource EmptyBody}"
                           Text="{loc:T overviewpage.whatsapp-ya-da-telegram-uzerinden-bir-sesl}" />

                <!--
                    The worked example.

                    What this application is for does not appear in any one conversation; it
                    appears three calls later, when a price has moved twice and a promise has
                    come due. Nobody can see that on their first day, and asking somebody to
                    record their calls for a month on faith is asking a lot.
                -->
                <Border Style="{StaticResource Panel}" Margin="0,24,0,0"
                        Visibility="{Binding HasSample, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{loc:T overviewpage.nasil-calistigini-simdi-gor}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource EmptyBody}" Margin="0,6,0,12"
                                   Text="{loc:T overviewpage.alti-haftaya-yayilmis-uc-ornek-gorusme-yuk}" />
                        <ui:Button Content="{loc:T overviewpage.ornek-gorusmeleri-yukle}" Appearance="Primary"
                                   HorizontalAlignment="Center" Command="{Binding LoadSampleCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Sparkle24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <!--
        ==================== the workspace ====================

        The user's own side of the screen. Two tabs: the pile they curate, and what today asks
        back. Both are entirely their doing — a card they dragged in, a reminder they set — which
        is what makes a pane that is always on screen bearable: it never invents anything.
    -->
    <Border Grid.Column="1" Margin="8,8,0,20" CornerRadius="8" BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            Padding="10,8,10,10">
     <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Style="{StaticResource SegmentedTabs}" Padding="0,10,0,0">
            <TabItem Header="Önemli">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                <!--
                    ==================== önemli görüşmeler ====================

                    The workspace: the one part of this archive a person arranges themselves,
                    on the screen they see first. Conversations are dragged in from the list
                    below, dragged around to change their order, and taken off with the ✕ —
                    and every one of those has a right-click equivalent, because a feature
                    that exists only as a drag is invisible and unusable from the keyboard.
                -->

                <Border x:Name="BoardPanel" AllowDrop="True" CornerRadius="8" Padding="4"
                        BorderThickness="1" MinHeight="56"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource LayerFillColorDefaultBrush}"
                        DragOver="BoardPanel_DragOver" Drop="BoardPanel_Drop"
                        DragLeave="BoardPanel_DragLeave">
                  <Grid x:Name="BoardInner">

                    <!-- Where the drag would land, drawn while it is still in the air. The card
                         visibly settles either way; the line spares the small surprise of it
                         settling one slot off from where the hand expected. -->
                    <Border x:Name="DropLine" Height="2" CornerRadius="1" VerticalAlignment="Top"
                            Margin="6,0" Visibility="Collapsed" IsHitTestVisible="False"
                            Background="{DynamicResource AccentFillColorDefaultBrush}" />

                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Board}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HoverCard}" Cursor="Hand"
                                            MouseLeftButtonUp="PanelCard_Click"
                                            PreviewMouseLeftButtonDown="Drag_Prime"
                                            PreviewMouseMove="PanelCard_DragMove"
                                            ToolTip="Görüşmeyi aç · sürükleyerek sırala">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Görüşmeyi aç" Click="PanelOpen_Click" />
                                                <Separator />
                                                <MenuItem Header="Yukarı taşı" Click="PanelUp_Click" />
                                                <MenuItem Header="Aşağı taşı" Click="PanelDown_Click" />
                                                <Separator />
                                                <!-- The dialog carries reason, date and removal
                                                     in one place — a reminder is set, changed
                                                     and cancelled through the same door. -->
                                                <MenuItem Header="Hatırlat…" Click="PanelRemind_Click" />
                                                <Separator />
                                                <MenuItem Header="Panelden kaldır" Click="PanelRemove_Click" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Border Style="{StaticResource Avatar}"
                                                        Background="{Binding ContactName, Converter={StaticResource NameBrush}}"
                                                        Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource AvatarText}"
                                                               Text="{Binding ContactName, Converter={StaticResource Initials}}" />
                                                </Border>
                                                <Border Width="36" Height="36" CornerRadius="18"
                                                        Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding PhotoPath, Converter={StaticResource Photo}}"
                                                                    Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ContactName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding When}" Style="{StaticResource Caption}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasReminder, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Style="{StaticResource PillText}"
                                                                   Text="{Binding ReminderText}" />
                                                    </Border>
                                                    <ItemsControl ItemsSource="{Binding Tags}" Margin="4,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource Pill}" Margin="4,0,0,0"
                                                                        Background="{Binding Converter={StaticResource TagBrush}}"
                                                                Cursor="Hand" MouseLeftButtonUp="TagPill_Click"
                                                                ToolTip="Bu etiketi taşıyan görüşmeleri ara">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon Symbol="{Binding Converter={StaticResource TagIcon}}"
                                                                                       FontSize="11" Foreground="White" Margin="0,0,3,0"
                                                                                       VerticalAlignment="Center" />
                                                                        <TextBlock Style="{StaticResource PillText}"
                                                                                   Foreground="White" Text="{Binding}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SummaryLine}" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Length}" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" Style="{StaticResource Caption}"
                                                       FontFamily="Consolas, Cascadia Mono, Segoe UI" />

                                            <ui:Button Grid.Column="3" Appearance="Transparent" Margin="8,0,0,0"
                                                       Padding="6,4" ToolTip="Panelden kaldır"
                                                       Click="PanelRemove_Click">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="12,10" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                                   Text="Buraya sürükle: aşağıdaki görüşmelerden takip etmek istediklerini bırak ya da sağ tıklayıp 'Önemlilere ekle' de."
                                   Visibility="{Binding HasBoard, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                  </Grid>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <!-- The count on the tab itself: a due reminder must be visible from the other
                     tab too, or "Bugün" is a door that never says whether anything is behind it. -->
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bugün" VerticalAlignment="Center" />
                        <Border Style="{StaticResource CountPill}" Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding DataContext.HasDue,
                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                             Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding DataContext.Due.Count,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       FontSize="11" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                <ItemsControl ItemsSource="{Binding Due}"
                              Visibility="{Binding HasDue, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HoverCard}" Cursor="Hand"
                                    MouseLeftButtonUp="DueCard_Click" ToolTip="Görüşmeyi aç">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0" Symbol="Alert24" FontSize="17" Margin="0,0,14,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- The reminder's own verb. A due card with no way to say
                                         "done" just rings forever; this clears the reminder and
                                         leaves the card on the pile. -->
                                    <ui:Button Grid.Column="2" Appearance="Transparent" Padding="6,4"
                                               VerticalAlignment="Center" ToolTip="Tamamlandı — hatırlatmayı kapat"
                                               Click="DueDone_Click">
                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" />
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                        <!-- Birthdays within the week — every date typed by the user on a
                             profile; the application infers none of them. Absent entirely
                             until one is near: a permanently empty birthday box would be the
                             application talking to hear itself. -->
                        <StackPanel Margin="4,12,4,0"
                                    Visibility="{Binding HasBirthdays, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Yaklaşan doğum günleri" Style="{StaticResource GroupHeader}" />
                            <ItemsControl ItemsSource="{Binding Birthdays}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,4">
                                            <TextBlock Text="🎂" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                                       FontSize="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Margin="8,24" HorizontalAlignment="Center"
                                    Visibility="{Binding TodayIsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="28" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Text="Bugün için hatırlatma yok. Bir görüşmeye ya da karta sağ tıklayıp 'Hatırlat' diyebilirsin." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!--
            Outlook's little month, wired to the reminders. A day carrying one is dotted red
            (birthdays get the accent dot); hovering says what and with whom; clicking lists
            the day's reminders, each opening the conversation it hangs on. It sits under the
            panel because the two are one system: the panel is what you are tracking, the
            calendar is when it comes back.
        -->
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="8" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0" Appearance="Transparent" Padding="6,2"
                               Command="{Binding CalendarPrevCommand}" ToolTip="Önceki ay">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ChevronLeft24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <!-- The month name is also the way home: clicking it returns to today. -->
                    <TextBlock Grid.Column="1" Text="{Binding CalendarTitle}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Cursor="Hand" ToolTip="Bugüne dön">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding CalendarTodayCommand}" />
                        </TextBlock.InputBindings>
                    </TextBlock>

                    <ui:Button Grid.Column="2" Appearance="Transparent" Padding="6,2"
                               Command="{Binding CalendarNextCommand}" ToolTip="Sonraki ay">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ChevronRight24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>

                <UniformGrid Columns="7" Margin="0,6,0,2">
                    <TextBlock Text="Pzt" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="Sal" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="Çar" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="Per" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="Cum" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="Cmt" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="Paz" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                </UniformGrid>

                <ItemsControl ItemsSource="{Binding CalendarDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" MouseLeftButtonUp="CalendarDay_Click"
                                    ToolTip="{Binding Tooltip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnything}" Value="True">
                                                <Setter Property="Cursor" Value="Hand" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Margin="0,3,0,2">
                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InMonth}" Value="False">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- The marks: red = a reminder comes due, accent = a birthday. -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Height="5" Margin="0,1,0,0">
                                        <Ellipse Width="5" Height="5"
                                                 Fill="{DynamicResource SystemFillColorCriticalBrush}"
                                                 Visibility="{Binding HasReminders, Converter={StaticResource BoolToVisibility}}" />
                                        <Ellipse Width="5" Height="5" Margin="2,0,0,0"
                                                 Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                 Visibility="{Binding HasBirthday, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The picked day, unpacked: every reminder with the conversation it points at. -->
                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding HasSelectedCalendarDay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SelectedDayHeader}" FontWeight="SemiBold"
                               FontSize="{StaticResource TextSecondary}" Margin="2,0,0,4" />

                    <ItemsControl ItemsSource="{Binding SelectedCalendarDay.Reminders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" CornerRadius="4" Padding="6,4"
                                        Cursor="Hand" MouseLeftButtonUp="CalendarReminder_Click"
                                        ToolTip="Bağlı görüşmeyi açar">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Clock24" FontSize="13" Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <TextBlock Text="{Binding Line}" TextWrapping="Wrap"
                                                   FontSize="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding SelectedCalendarDay.BirthdayNames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="6,2">
                                    <TextBlock Text="🎂" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding}" FontSize="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
     </Grid>
    </Border>
    </Grid>
</UserControl>
