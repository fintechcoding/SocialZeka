<ui:FluentWindow x:Class="VoiceTranscript.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
                 Title="{loc:T settingswindow.ayarlar}"
                 Icon="pack://application:,,,/VoiceTranscript;component/icon.ico"
                 Width="1060" Height="780"
                 MinWidth="880" MinHeight="600"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:T settingswindow.ayarlar}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/VoiceTranscript;component/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Category rail, matching the shape of Windows 11 Settings. -->
            <StackPanel Grid.Column="0" Margin="12,4,0,12">
                <RadioButton GroupName="Cat" IsChecked="True" Style="{StaticResource NavButton}"
                             x:Name="NavGeneral" Checked="Category_Checked" Tag="General">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T settingswindow.genel}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="Cat" Style="{StaticResource NavButton}"
                             x:Name="NavRecording" Checked="Category_Checked" Tag="Recording">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Record24" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T settingswindow.kayit}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="Cat" Style="{StaticResource NavButton}"
                             x:Name="NavTranscription" Checked="Category_Checked" Tag="Transcription">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T settingswindow.yaziya-dokme}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="Cat" Style="{StaticResource NavButton}"
                             x:Name="NavAnalysis" Checked="Category_Checked" Tag="Analysis">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T settingswindow.cozumleme}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="Cat" Style="{StaticResource NavButton}"
                             x:Name="NavConsistency" Checked="Category_Checked" Tag="Consistency">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Scales24" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T settingswindow.tutarlilik}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="Cat" Style="{StaticResource NavButton}"
                             x:Name="NavCoaching" Checked="Category_Checked" Tag="Coaching">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PersonFeedback24" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T settingswindow.kocluk}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="Cat" Style="{StaticResource NavButton}"
                             x:Name="NavData" Checked="Category_Checked" Tag="Data">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T settingswindow.veriler}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="Cat" Style="{StaticResource NavButton}"
                             x:Name="NavExport" Checked="Category_Checked" Tag="Export">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T settingswindow.disa-aktarma}" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <ScrollViewer x:Name="PageScroll" Grid.Column="1" Padding="24,4,32,16" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="760" HorizontalAlignment="Left">

                    <!-- Recording -->
                    <!-- General: the interface itself — language, theme, startup. What Windows
                         applications put first, because it is what everybody recognises. -->
                    <StackPanel x:Name="PageGeneral">
                        <TextBlock Text="{loc:T settingswindow.genel}" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="{loc:T settingswindow.genel-aciklama}" />

                        <!--
                            What the reading calls you.

                            Only the reading uses it, and only because that is the one surface in
                            the product written TO somebody rather than about a recording. It said
                            "BEN" — the transcript's own label for the microphone stream — inside
                            prose meant for the person that microphone belonged to.
                        -->
                        <TextBlock Text="{loc:T settingswindow.sana-nasil-seslensin}" Style="{StaticResource GroupHeader}" Margin="0,0,0,8" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0" Symbol="Person24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.senin-adin}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.okumada-sana-bu-adla-seslenir-bos-birakirs}" />
                                </StackPanel>

                                <ui:TextBox Grid.Column="2" Width="180" Margin="14,0,0,0"
                                            PlaceholderText="{loc:T settingswindow.ornek-ahmet}"
                                            Text="{Binding PreferredName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:T settingswindow.arayuz-dili}" Style="{StaticResource GroupHeader}" Margin="0,16,0,8" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="LocalLanguage24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.dil}" FontSize="{StaticResource TextBody}" />

                                    <!-- Deliberately separate from the language people speak on a
                                         call. Conflating the two would mean switching the
                                         interface to English quietly told Whisper to stop
                                         expecting Turkish. -->
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.arayuzun-dili-konusulan-dili-degistirmez}" />

                                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding LanguageChanged, Converter={StaticResource BoolToVisibility}}"
                                               Text="{loc:T settingswindow.uygulama-yeniden-baslatildiginda-uygulanir}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2" MinWidth="150" VerticalAlignment="Center"
                                          ItemsSource="{Binding UiLanguages}"
                                          SelectedItem="{Binding UiLanguage}"
                                          DisplayMemberPath="Name" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:T settingswindow.gorunum}" Style="{StaticResource GroupHeader}" Margin="0,0,0,8" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="DarkTheme24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.tema}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.sistemi-izle-windows-un-acik-koyu-ayariyla}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2" MinWidth="150" VerticalAlignment="Center"
                                          SelectedValue="{Binding ThemeChoice}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="{loc:T settingswindow.sistemi-izle}" Tag="system" />
                                    <ComboBoxItem Content="{loc:T settingswindow.acik}" Tag="light" />
                                    <ComboBoxItem Content="{loc:T settingswindow.koyu}" Tag="dark" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:T settingswindow.baslangic}" Style="{StaticResource GroupHeader}" Margin="0,0,0,8" />

                        <!--
                            A call recorder that has to be remembered and launched before every
                            conversation records nothing — the calls worth having a record of are
                            the ones nobody saw coming. Here rather than only in the installer,
                            so a deliberate "no" cannot be overturned by an update rerunning the
                            installer with its defaults.
                        -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Power24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.windows-acilisinda-baslat}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.windows-acilisinda-baslat-aciklama}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding StartWithWindows}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PageRecording" Visibility="Collapsed">
                        <TextBlock Text="{loc:T settingswindow.kayit}" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="{loc:T settingswindow.gorusme-basladiginda-hangi-uygulamalarin-k}" />

                        <TextBlock Text="{loc:T settingswindow.ne-zaman-kaydedilsin}" Style="{StaticResource GroupHeader}" Margin="0,0,0,8" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Record24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.otomatik-kayit}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.kapaliyken-aramalar-izlenmeye-devam-eder-a}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding RecordAutomatically}" />
                            </Grid>
                        </Border>

                        <!-- Off by default: WhatsApp's second-screen call window is titled
                             "Voice call", and a binding learned on it filed every later call under
                             one person. -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="PersonQuestionMark24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.kisiyi-pencere-basligindan-kendiliginden-ata}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.kisiyi-pencere-basligindan-aciklama}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding AssignContactFromTitle}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Eye24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.kayit-seridi}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.kayit-surerken-ekranin-ustunde-ince-bir-se}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding ShowRecordingBar}" />
                            </Grid>
                        </Border>

                        <!-- Off by default, and the card says what it keeps rather than only what
                             it does. A switch that starts collecting something derived from a
                             person's body should read like a decision, not like a preference —
                             and it should have its undo next to it. -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Person24" FontSize="18" Margin="0,0,14,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T settingswindow.sesten-kisi-tanima}" FontSize="{StaticResource TextBody}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Text="{loc:T settingswindow.karsi-tarafi-sesinden-tanir-gorusme-suresi}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                     IsChecked="{Binding IdentifySpeakers}" />
                                </Grid>

                                <!-- Only while the feature is on. Learning voices with recognition
                                     switched off would collect biometric data nothing then uses. -->
                                <StackPanel Orientation="Horizontal" Margin="32,10,0,0"
                                            IsEnabled="{Binding IdentifySpeakers}">
                                    <ui:Button x:Name="LearnVoicesButton" Padding="10,4" Margin="0,0,8,0"
                                               Appearance="Secondary" Click="LearnVoices_Click"
                                               Content="{loc:T settingswindow.arsivden-ses-izlerini-kur}" />
                                    <ui:Button x:Name="ForgetVoicesButton" Padding="10,4"
                                               Appearance="Secondary" Click="ForgetVoices_Click"
                                               Content="{loc:T settingswindow.butun-ses-izlerini-sil}" />
                                </StackPanel>

                                <TextBlock x:Name="VoiceStatus" Margin="32,8,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource Caption}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- A setting that has been live in the orchestrator since it was written
                             and had no control anywhere, so it could only ever hold its default. -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="People24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.grup-aramalarini-yaziya-dok}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.grup-aramasinda-herkes-tek-akista-gelir}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding TranscribeGroupCalls}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:T settingswindow.uygulamalar}" Style="{StaticResource GroupHeader}" Margin="0,0,0,8" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Chat24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.whatsapp}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="{loc:T settingswindow.whatsapp-desktop-uzerinden-yapilan-sesli-a}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding RecordWhatsApp}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Send24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.telegram}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="{loc:T settingswindow.telegram-desktop-aramalari-kisi-adi-arama}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding RecordTelegram}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="ShieldTask24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.signal}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="{loc:T settingswindow.signal-desktop-aramalari}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding RecordSignal}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:T settingswindow.ses-yakalama}" Style="{StaticResource GroupHeader}" />

                        <!--
                            Which devices a call actually runs on.

                            Automatic is right most of the time and wrong in exactly the case
                            people hit: listening on Bluetooth earphones while talking into the
                            laptop microphone. Windows records those as two unrelated defaults,
                            and capturing the wrong output endpoint produces an hour of silence
                            from the other person with no error — an idle endpoint and a quiet
                            conversation are the same thing to a loopback client.
                        -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0" Symbol="Mic24" FontSize="18" Margin="0,0,14,0"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:T settingswindow.senin-sesin-nereden-alinsin}" FontSize="{StaticResource TextBody}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8"
                                                   Text="{loc:T settingswindow.konustugun-mikrofon-kulaklikla-dinleyip-bi}" />

                                        <ComboBox ItemsSource="{Binding Microphones}"
                                                  SelectedItem="{Binding SelectedMicrophone}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2">
                                                        <TextBlock Text="{Binding Name}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource Caption}"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <ui:Button Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Bottom"
                                               Content="{loc:T settingswindow.yenile}" MinWidth="90"
                                               Command="{Binding RefreshDevicesCommand}"
                                               ToolTip="{loc:T settingswindow.kulakligi-yeni-taktiysan-listeyi-tazele}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0" Symbol="Speaker224" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:T settingswindow.karsi-tarafin-sesi-nereden-alinsin}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8"
                                               Text="{loc:T settingswindow.karsi-tarafi-duydugun-cihaz-airpods-ile-di}" />

                                    <ComboBox ItemsSource="{Binding Outputs}"
                                              SelectedItem="{Binding SelectedOutput}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource Caption}"
                                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--
                            The Bluetooth trap, said plainly.

                            A headset presents itself twice: a hands-free pair that carries the
                            microphone at 16 kHz and drops the earphones out of stereo, and a
                            stereo output-only pair at full quality. Choosing the hands-free half
                            is how a conversation ends up sounding like a 1985 telephone, and
                            nothing in Windows explains it.
                        -->
                        <ui:InfoBar Margin="0,4,0,4" IsClosable="False" Severity="Warning"
                                    Title="{loc:T settingswindow.bluetooth-eller-serbest-modu-secili}"
                                    Message="{loc:T settingswindow.bluetooth-kulakliklar-windows-a-iki-kez-go}"
                                    IsOpen="{Binding WarnAboutHandsFree}" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Headphones24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.yanki-engelleme}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="{loc:T settingswindow.hoparlorle-konusurken-karsi-tarafin-sesi-m}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding UseEchoCancellation}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Desktop24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.uygulama-bazli-yakalama}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="{loc:T settingswindow.yalnizca-whatsapp-ve-telegram-sesini-alir}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding PreferProcessLoopback}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Mic24" FontSize="18" Margin="0,0,14,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T settingswindow.ses-yakalamayi-sina}" FontSize="{StaticResource TextBody}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   Text="{loc:T settingswindow.bes-saniye-kayit-alip-iki-akistan-da-gerce}" />
                                    </StackPanel>
                                    <ui:Button x:Name="TestCaptureButton" Grid.Column="2" Content="{loc:T settingswindow.sina}"
                                               MinWidth="96" VerticalAlignment="Center" Click="TestCapture_Click" />
                                </Grid>
                                <TextBlock x:Name="CaptureTestResult" Style="{StaticResource Secondary}"
                                           Margin="32,10,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{loc:T settingswindow.isleme}" Style="{StaticResource GroupHeader}" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Timer24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.bekleme-suresi-saniye}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="{loc:T settingswindow.gorusme-bittikten-sonra-ekran-kartini-kull}" />
                                </StackPanel>
                                <ui:NumberBox Grid.Column="2" Value="{Binding GpuCooldownSeconds}"
                                              Minimum="0" Maximum="600" Width="120" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- Data: where everything lives and how long it is kept.
                         Its own section because "kayıt" is about the microphone; what happens to
                         the files afterwards is a different question asked at a different time. -->
                    <StackPanel x:Name="PageData" Visibility="Collapsed">
                        <TextBlock Text="{loc:T settingswindow.veriler}" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,16" TextWrapping="Wrap"
                                   Text="{loc:T settingswindow.veriler-aciklama}" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.veri-klasoru}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock x:Name="DataFolderPath" Style="{StaticResource Caption}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ui:Button Grid.Column="2" Content="{loc:T settingswindow.klasoru-ac}"
                                           VerticalAlignment="Center" Click="OpenDataFolder_Click" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Delete24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.ses-kayitlarini-saklama-gun}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="{loc:T settingswindow.sifir-suresiz-saklamak-demektir-sabitlenmi}" />
                                </StackPanel>
                                <ui:NumberBox Grid.Column="2" Value="{Binding AudioRetentionDays}"
                                              Minimum="0" Maximum="3650" Width="120" VerticalAlignment="Center" />
                            </Grid>
                        </Border>


                        <!-- Two PCM streams are 230 MB an hour. Opus keeps the call and drops
                             the size twenty-fold; the two sides stay separate files. -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="FolderZip24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.sesi-sikistir}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.sesi-sikistir-aciklama}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding CompressAudio}"
                                                 VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Transcription -->
                    <StackPanel x:Name="PageTranscription" Visibility="Collapsed">
                        <TextBlock Text="{loc:T settingswindow.yaziya-dokme}" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="{loc:T settingswindow.konusmanin-metne-cevrilmesi-bu-makinede-ca}" />

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:T settingswindow.nerede-calissin}" FontSize="{StaticResource TextBody}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10"
                                           Text="{loc:T settingswindow.yerelde-calistirmak-varsayilandir-ve-hicbi}" />
                                <ComboBox ItemsSource="{Binding AsrModes}" SelectedItem="{Binding AsrMode}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource AsrModeName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!--
                                    What this actually means, in one sentence, here.

                                    The mode is a combo at the top of a long page and the local
                                    model has its own large card far below it. Choosing a model
                                    there is the act somebody remembers, so "yerel seçili" can be
                                    a true memory of something that had no effect while every call
                                    went to a hosted service.
                                -->
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="10,7" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding EffectiveEngineLine}" TextWrapping="Wrap"
                                               Style="{StaticResource Caption}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- The words the recogniser keeps getting wrong. "Sumsub" came out as
                             "samsatta"; a term list is the cheapest fix and works for the hosted
                             services too. -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:T settingswindow.sozluk}" FontSize="{StaticResource TextBody}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8" TextWrapping="Wrap"
                                           Text="{loc:T settingswindow.sozluk-aciklama}" />
                                <ui:TextBox Text="{Binding SpeechVocabulary, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{loc:T settingswindow.sozluk-ornek}"
                                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160"
                                            VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <!-- The setting the General page has always pointed at.
                             Its caption says the interface language does not change what is spoken
                             and that this is set "from the transcription section" — and for a long
                             time there was nothing here to set. The value was live in the engine
                             and permanently "tr" because nothing could write it. -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="LocalLanguage24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.konusulan-dil}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.gorusmelerde-hangi-dilin-konusuldugu}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2" MinWidth="150" VerticalAlignment="Center"
                                          IsEnabled="{Binding MixedLanguage, Converter={StaticResource InverseBool}}"
                                          ItemsSource="{Binding SpokenLanguages}"
                                          SelectedItem="{Binding SpokenLanguage}"
                                          DisplayMemberPath="Name" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Translate24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.karisik-dil}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.karisik-dil-aciklama}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding MixedLanguage}" />
                            </Grid>
                        </Border>

                        <!-- Hosted services. Always shown: in the default local mode the whole
                             block used to be invisible, and nothing said where a service could be
                             added. Adding one now switches the mode itself. -->
                        <StackPanel>
                            <ui:InfoBar Margin="0,8,0,4" IsOpen="True" IsClosable="False" Severity="Warning"
                                        Title="{loc:T settingswindow.ses-makineden-cikar}"
                                        Message="{loc:T settingswindow.bu-modda-gorusme-kaydi-sectigin-servise-yu}"
                                        Visibility="{Binding UsesCloudAsr, Converter={StaticResource BoolToVisibility}}" />

                            <Grid Margin="0,12,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:T settingswindow.servisler}" Style="{StaticResource GroupHeader}" Margin="0,0,0,4" />
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="{loc:T settingswindow.sirayla-denenir-biri-cevap-vermezse-ya-da}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Text="{loc:T settingswindow.su-an-kullanilmiyor-yalnizca-bu-makinede}"
                                               Visibility="{Binding UsesCloudAsr, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>

                                <!-- Which service, first: the card used to open as OpenAI and be
                                     re-pointed afterwards, rewriting its address and model. -->
                                <ui:DropDownButton Grid.Column="1" Content="{loc:T settingswindow.servis-ekle}" Margin="12,0,0,0"
                                                   VerticalAlignment="Bottom">
                                    <ui:DropDownButton.Icon>
                                        <ui:SymbolIcon Symbol="AddCircle24" />
                                    </ui:DropDownButton.Icon>
                                    <ui:DropDownButton.Flyout>
                                        <ContextMenu ItemsSource="{Binding AvailableSttProviders}">
                                            <ContextMenu.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="{Binding DisplayName}" />
                                                    <Setter Property="ToolTip" Value="{Binding Summary}" />
                                                    <Setter Property="Command" Value="{Binding DataContext.AddEndpointForCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                </Style>
                                            </ContextMenu.ItemContainerStyle>
                                        </ContextMenu>
                                    </ui:DropDownButton.Flyout>
                                </ui:DropDownButton>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding SttEndpoints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SettingCard}" Padding="16,14" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding DataContext.AvailableSttProviders,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedValue="{Binding Kind}"
                                                              SelectedValuePath="Kind"
                                                              DisplayMemberPath="DisplayName"
                                                              MinWidth="220" HorizontalAlignment="Left" />

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <!-- The one word that answers "does this service work":
                                                             a card with an empty key used to look exactly like a
                                                             working one. -->
                                                        <Border Style="{StaticResource Pill}" Margin="0,0,12,0" VerticalAlignment="Center"
                                                                Background="{Binding ReadinessBrushKey, Converter={StaticResource BrushFromKey}}">
                                                            <TextBlock Style="{StaticResource PillText}" Foreground="White"
                                                                       Text="{Binding ReadinessText}" />
                                                        </Border>

                                                        <ui:ToggleSwitch IsChecked="{Binding Enabled}"
                                                                         VerticalAlignment="Center" Margin="0,0,10,0"
                                                                         ToolTip="{loc:T settingswindow.kapaliyken-yapilandirma-korunur-ama-bu-ser}" />

                                                        <Button Style="{StaticResource GhostButton}" ToolTip="{loc:T settingswindow.yukari-tasi}"
                                                                Command="{Binding DataContext.MoveEndpointUpCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <ui:SymbolIcon Symbol="ArrowUp24" FontSize="15" />
                                                        </Button>

                                                        <Button Style="{StaticResource GhostButton}" ToolTip="{loc:T settingswindow.asagi-tasi}"
                                                                Command="{Binding DataContext.MoveEndpointDownCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <ui:SymbolIcon Symbol="ArrowDown24" FontSize="15" />
                                                        </Button>

                                                        <Button Style="{StaticResource GhostButton}" ToolTip="{loc:T settingswindow.kaldir}"
                                                                Command="{Binding DataContext.RemoveEndpointCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{Binding Provider.Summary}"
                                                           Style="{StaticResource Caption}" Margin="0,0,0,12" />

                                                <ui:InfoBar Margin="0,0,0,12" IsClosable="False" Severity="Warning"
                                                            Title="{loc:T settingswindow.bu-servise-yukleme-yapilamiyor}"
                                                            Message="{loc:T settingswindow.istek-bicimi-openai-ninkinden-farkli-kayit}"
                                                            IsOpen="{Binding CanUpload, Converter={StaticResource InverseBool}}" />

                                                <!-- What a new user needs first, first: get a key, paste it, pick the
                                                     model. The address is the one field they must not touch; it lives
                                                     under "Gelişmiş". -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{loc:T settingswindow.api-anahtari}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                    <ui:HyperlinkButton Grid.Column="1" Content="{loc:T settingswindow.anahtar-al}" Padding="4,0"
                                                                        NavigateUri="{Binding SignupUrl}"
                                                                        Visibility="{Binding HasSignupUrl, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                                <ui:PasswordBox Password="{Binding ApiKey, Mode=TwoWay}" Margin="0,0,0,10"
                                                                PlaceholderText="{loc:T settingswindow.anahtari-yapistir-kendiliginden-sinanir}" />

                                                <TextBlock Text="{loc:T settingswindow.model}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                                <!-- Opening the box asks the service; a refused key
                                                     or a missing list is said in the status line,
                                                     and a name can always be typed. -->
                                                <ComboBox IsEditable="True" ItemsSource="{Binding Models}"
                                                          Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                                          DropDownOpened="EndpointModelBox_DropDownOpened"
                                                          Margin="0,0,0,4" />

                                                <!-- The box shows the models that transcribe; the rest of the
                                                     provider's list is one click away, never gone. -->
                                                <ui:HyperlinkButton Content="{Binding ShowAllModelsText}" Padding="4,0" Margin="0,0,0,4"
                                                                    Command="{Binding ToggleShowAllModelsCommand}"
                                                                    Visibility="{Binding HasHiddenModels, Converter={StaticResource BoolToVisibility}}" />

                                                <!--
                                                    The two buttons that make this trustworthy.
                                                    Otherwise a wrong key or an exhausted balance is
                                                    discovered only when a real conversation has
                                                    already been recorded and fails to upload.
                                                    Directly under the model box: the address expander
                                                    used to sit between them, and the test was the last
                                                    thing on the card rather than the next.
                                                -->
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <ui:Button Content="{loc:T settingswindow.baglantiyi-sina}" MinWidth="128"
                                                               Command="{Binding TestCommand}"
                                                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="PlugConnected24" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>

                                                    <ui:Button Content="{loc:T settingswindow.krediyi-sor}" Margin="8,0,0,0" MinWidth="120"
                                                               Command="{Binding ReadBalanceCommand}"
                                                               Visibility="{Binding SupportsBalance, Converter={StaticResource BoolToVisibility}}">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="Wallet24" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>

                                                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16"
                                                                     Margin="10,0,0,0" VerticalAlignment="Center"
                                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding Status}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                           FontSize="{StaticResource TextSecondary}"
                                                           Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusIsGood}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <StackPanel Margin="0,10,0,0"
                                                            Visibility="{Binding HasBalance, Converter={StaticResource BoolToVisibility}}">
                                                    <ProgressBar Value="{Binding BalanceUsed}" Maximum="1" Height="6"
                                                                 Visibility="{Binding BalanceUsed, Converter={StaticResource NullToCollapsed}}" />
                                                    <TextBlock Text="{Binding Balance}" Margin="0,6,0,0"
                                                               FontSize="{StaticResource TextSecondary}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding BalanceIsLow}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <ui:CardExpander Margin="0,12,0,0" Icon="{ui:SymbolIcon Settings24}"
                                                                 Header="{loc:T settingswindow.gelismis-adres}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock Text="{loc:T settingswindow.adres}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                                            <ui:TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="1" Content="{loc:T settingswindow.varsayilana-don}"
                                                                   VerticalAlignment="Bottom" Appearance="Transparent"
                                                                   Command="{Binding ResetAddressCommand}" />
                                                    </Grid>
                                                </ui:CardExpander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Panel}"
                                    Visibility="{Binding SttEndpoints.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                                <StackPanel>
                                    <TextBlock Text="{loc:T settingswindow.henuz-servis-tanimlanmadi}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                               Text="{loc:T settingswindow.bulut-uzerinden-yaziya-dokmek-icin-en-az-b}" />
                                </StackPanel>
                            </Border>

                            <ui:InfoBar Margin="0,4,0,0" IsOpen="True" IsClosable="False" Severity="Informational"
                                        Title="{loc:T settingswindow.uzun-aramalar}"
                                        Message="{loc:T settingswindow.ses-opus-a-sikistirilip-gerekirse-sessiz-a}" />
                        </StackPanel>

                        <!-- Local model -->
                        <!-- Inert when everything is uploaded, and it did not say so.
                             The model table, the download and self-test buttons, the compute device
                             and the cool-down all only matter to the local engine; in CloudOnly
                             they stayed fully editable, so somebody could download two gigabytes of
                             weights that would never be loaded. -->
                        <ui:InfoBar Severity="Informational" IsClosable="False" Margin="0,8,0,12"
                                    IsOpen="{Binding UsesLocalAsr, Converter={StaticResource InverseBool}}"
                                    Message="{loc:T settingswindow.her-sey-buluta-gonderiliyor-yerel-model}" />

                        <!-- Gone rather than greyed: a disabled model table under "her şey buluta
                             gönderiliyor" reads as a broken screen, not as a choice already made. -->
                        <StackPanel Visibility="{Binding UsesLocalAsr, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:T settingswindow.yerel-model}" Style="{StaticResource GroupHeader}" />

                        <!--
                            The table alone answered none of the three questions somebody has on
                            this screen: which model is in use, whether its files are here, and
                            where it will run. The selected row was a thin line in a scrolling
                            grid, and the sentence underneath referred to whichever model had
                            been selected when the window last probed — so it regularly described
                            a different model from the highlighted one.
                        -->
                        <Border Style="{StaticResource SettingCard}"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0" Symbol="Checkmark24" FontSize="20"
                                               Margin="0,2,16,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="{loc:T settingswindow.su-an-kullanilan}" />

                                    <TextBlock Text="{Binding SelectedAsrModel.DisplayName}"
                                               FontWeight="SemiBold" Margin="0,2,0,0"
                                               FontSize="{StaticResource TextSubtitle}" />

                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Text="{Binding SelectedModelReadiness}" />

                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding DeviceSummary, Converter={StaticResource NullToCollapsed}}"
                                               Text="{Binding DeviceSummary}" />

                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Text="{Binding SelectedAsrModel.Summary}" />

                                    <TextBlock Text="{Binding SelectedAsrModel.Warning}"
                                               Style="{StaticResource Secondary}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding SelectedAsrModel.Warning, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,10"
                                   Text="{loc:T settingswindow.asagidaki-hata-oranlari-turkce-icin-gercek}" />

                        <Border Style="{StaticResource SettingCard}" Padding="0">
                            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Height="220"
                                      Background="Transparent" BorderThickness="0"
                                      SelectedItem="{Binding SelectedAsrModel, Mode=TwoWay}"
                                      ItemsSource="{Binding AsrModels}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:T settingswindow.model}" Binding="{Binding DisplayName}" Width="*" />
                                    <DataGridTextColumn Header="{loc:T settingswindow.wer}" Binding="{Binding Wer.MediaSpeech, StringFormat='{}{0:0.0}'}" Width="64" />
                                    <DataGridTextColumn Header="{loc:T settingswindow.vram}" Binding="{Binding VramGb, StringFormat='{}{0} GB'}" Width="74" />
                                    <DataGridTextColumn Header="{loc:T settingswindow.indirme}" Binding="{Binding DownloadGb, StringFormat='{}{0} GB'}" Width="80" />
                                    <DataGridTextColumn Header="{loc:T settingswindow.hiz}" Binding="{Binding SpeedHint}" Width="132" />

                                    <!--
                                        Whether the weights are already here.

                                        The table invited a choice between five models and left
                                        out the one thing needed to make it: whether picking a
                                        row means transcription starts now or stalls behind a
                                        three-gigabyte download.
                                    -->
                                    <DataGridTemplateColumn Header="{loc:T settingswindow.durum}" Width="84">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="{StaticResource TextSecondary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource ModelPresence}">
                                                            <Binding Path="ModelRef" />
                                                            <Binding Path="DataContext.DownloadedModelRefs"
                                                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedAsrModel.DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedAsrModel.Summary}" Style="{StaticResource Secondary}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SelectedAsrModel.Warning}" Style="{StaticResource Secondary}"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,8,0,0"
                                           Visibility="{Binding SelectedAsrModel.Warning, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T settingswindow.model-dosyalari}" FontSize="{StaticResource TextBody}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   Text="{loc:T settingswindow.model-ilk-kullanimda-kendiliginden-iner-am}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button x:Name="DownloadButton" Content="{loc:T settingswindow.indir}" MinWidth="76"
                                                   Click="DownloadModel_Click" Margin="0,0,6,0" />
                                        <ui:Button x:Name="SelfTestButton" Content="{loc:T settingswindow.sina}" MinWidth="76"
                                                   Click="SelfTestModel_Click" Margin="0,0,6,0" />
                                        <ui:Button x:Name="RefreshStatusButton" Content="{loc:T settingswindow.yenile}" MinWidth="76"
                                                   Click="RefreshModelStatus_Click" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="ModelProgress" Height="3" Margin="0,10,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="ModelStatus" Style="{StaticResource Secondary}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.hesaplama-cihazi}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="{loc:T settingswindow.otomatik-ekran-karti-erisilebiliyorsa-onu}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding AsrDevice}" Width="140" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Analysis -->
                    <StackPanel x:Name="PageAnalysis" Visibility="Collapsed">
                        <TextBlock Text="{loc:T settingswindow.cozumleme}" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="{loc:T settingswindow.metinden-taahhutleri-degisen-rakamlari-ve}" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.gorusme-bitince-otomatik-cozumle}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="{loc:T settingswindow.kapaliyken-kayit-ve-yaziya-dokme-yine-cali}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                 IsChecked="{Binding AnalyseAutomatically}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:T settingswindow.saglayici}" FontSize="{StaticResource TextBody}" />
                                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                          DisplayMemberPath="DisplayName" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding SelectedProvider.Summary}" Style="{StaticResource Caption}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <ui:InfoBar Margin="0,4,0,4" IsClosable="False" Severity="Warning"
                                    Title="{loc:T settingswindow.metin-makineden-cikar}"
                                    Message="{loc:T settingswindow.bu-saglayici-bulutta-calisir-gorusmenin-ya}"
                                    IsOpen="{Binding SelectedProvider.SendsDataOffMachine}" />

                        <ui:InfoBar Margin="0,4,0,4" IsClosable="False" Severity="Informational"
                                    Title="{loc:T settingswindow.cozumleme-servisi-secilmedi}"
                                    Message="{loc:T settingswindow.cozumleme-servisi-secilmedi-aciklama}"
                                    IsOpen="{Binding NoLlmChosen}" />

                        <Border Style="{StaticResource SettingCard}"
                                Visibility="{Binding SelectedProvider.RequiresApiKey, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:T settingswindow.api-anahtari}" FontSize="{StaticResource TextBody}" VerticalAlignment="Center" />
                                    <ui:HyperlinkButton Grid.Column="1" Content="{loc:T settingswindow.anahtar-al}" Padding="4,0"
                                                        NavigateUri="{Binding SelectedProvider.SignupUrl}"
                                                        Visibility="{Binding SelectedProvider.SignupUrl, Converter={StaticResource NullToCollapsed}}" />
                                </Grid>
                                <ui:PasswordBox Password="{Binding LlmApiKey, Mode=TwoWay}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}"
                                Visibility="{Binding NoLlmChosen, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:T settingswindow.adres}" FontSize="{StaticResource TextBody}" />
                                <ui:TextBox Text="{Binding LlmBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,8,0,10" />

                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="{loc:T settingswindow.baglantiyi-sina}" MinWidth="128"
                                               Command="{Binding TestLlmCommand}"
                                               IsEnabled="{Binding IsTestingLlm, Converter={StaticResource InverseBool}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="PlugConnected24" />
                                        </ui:Button.Icon>
                                    </ui:Button>

                                    <ui:Button Content="{loc:T settingswindow.yerel-sunucu-bul}" Margin="8,0,0,0" MinWidth="140"
                                               Command="{Binding DiscoverLocalServersCommand}"
                                               ToolTip="{loc:T settingswindow.ollama-llama-server-ve-lm-studio-bilinen-p}"
                                               IsEnabled="{Binding CanDiscoverNow}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Server24" />
                                        </ui:Button.Icon>
                                    </ui:Button>

                                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="10,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsTestingLlm, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <TextBlock Text="{Binding LlmStatus}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           FontSize="{StaticResource TextSecondary}"
                                           Visibility="{Binding LlmStatus, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LlmStatusIsGood}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}"
                                Visibility="{Binding UsesRemoteModelName, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:T settingswindow.model-adi}" FontSize="{StaticResource TextBody}" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" IsEditable="True"
                                              Text="{Binding LlmRemoteModel, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DiscoveredLlmModels}"
                                              DropDownOpened="LlmModelBox_DropDownOpened" />

                                    <!--
                                        Asks the provider what it actually has, rather than trusting
                                        a list written months ago. An identifier that no longer
                                        exists is refused with a message that usually does not
                                        mention the model, so a typo here presents as "analysis
                                        stopped working" and stays unexplained.
                                    -->
                                    <ui:Button Grid.Column="1" Margin="8,0,0,0" MinWidth="130"
                                               Content="{loc:T settingswindow.modellere-gozat}" Click="BrowseModels_Click"
                                               Visibility="{Binding CanBrowseModels, Converter={StaticResource BoolToVisibility}}"
                                               ToolTip="{loc:T settingswindow.saglayicidaki-modelleri-listeler-arayarak}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Search24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           Text="{loc:T settingswindow.baglantiyi-sinadiginda-liste-saglayicinin}" />

                                <!-- What this provider's identifiers look like.
                                     The spelling differs by provider and the box is free text, so
                                     until now the only place anybody saw a correct one was in a
                                     validation message after getting it wrong. AppSettings has
                                     carried these examples all along; nothing displayed them. -->
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasModelExamples, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="{loc:T settingswindow.ornegin}" />
                                    <Run Text="{Binding ModelExamplesLine, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono, Segoe UI" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Hidden when nothing is chosen, not only when a remote provider is.
                             "Seçilmedi" is not in UsesRemoteModelName, so this table used to be on
                             screen and selectable with no provider at all — writing LlmModelId,
                             which ResolvedModelName never reads in that state. -->
                        <StackPanel Visibility="{Binding UsesRemoteModelName, Converter={StaticResource InverseBoolToVisibility}}"
                                    IsEnabled="{Binding NoLlmChosen, Converter={StaticResource InverseBool}}">
                            <TextBlock Text="{loc:T settingswindow.yerel-model}" Style="{StaticResource GroupHeader}" />
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,10"
                                       Text="{loc:T settingswindow.toplam-sutunu-model-agirliklari-ile-baglam}" />

                            <Border Style="{StaticResource SettingCard}" Padding="0">
                                <DataGrid AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Height="180"
                                          Background="Transparent" BorderThickness="0"
                                          ItemsSource="{Binding LlmModels}" SelectedItem="{Binding SelectedLlmModel, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:T settingswindow.model}" Binding="{Binding DisplayName}" Width="*" />
                                        <DataGridTextColumn Header="{loc:T settingswindow.kuant}" Binding="{Binding Quantisation}" Width="84" />
                                        <DataGridTextColumn Header="{loc:T settingswindow.toplam}" Binding="{Binding TotalGb, StringFormat='{}{0} GB'}" Width="80" />
                                        <DataGridTextColumn Header="{loc:T settingswindow.baglam}" Binding="{Binding ContextTokens}" Width="76" />
                                        <DataGridTextColumn Header="{loc:T settingswindow.hiz}" Binding="{Binding SpeedHint}" Width="124" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedLlmModel.Summary}" Style="{StaticResource Secondary}" />
                                    <TextBlock Text="{Binding SelectedLlmModel.Warning}" Style="{StaticResource Secondary}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,8,0,0"
                                               Visibility="{Binding SelectedLlmModel.Warning, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{loc:T settingswindow.aksiyonlar-ve-okuma}" Style="{StaticResource GroupHeader}" Margin="0,16,0,4" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.gorusmeden-aksiyon-onerileri-cikar}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.cozumlemeyle-birlikte-atman-gereken-adimla}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                 IsChecked="{Binding ExtractActions}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.modelin-okumasi-paneli}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.gorusme-penceresinde-istek-uzerine-uretile}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                 IsChecked="{Binding CommentaryEnabled}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- The consistency check: a deliberate, separately billed read of one
                         conversation. Its own category at the user's request — the switches
                         were getting lost at the bottom of the analysis page. -->
                    <StackPanel x:Name="PageConsistency" Visibility="Collapsed">
                        <TextBlock Text="{loc:T settingswindow.tutarlilik}" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="{loc:T settingswindow.tutarlilik-aciklama}" />

                        <!-- Every switch below runs through the analysis client, so with no
                             provider chosen they were five controls that changed nothing. Said
                             rather than silently disabled: an inert control with no explanation
                             reads as a broken one. -->
                        <ui:InfoBar Severity="Informational" IsClosable="False" Margin="0,0,0,12"
                                    IsOpen="{Binding NoLlmChosen}"
                                    Message="{loc:T settingswindow.tutarlilik-icin-once-cozumleme-servisi}" />

                        <StackPanel IsEnabled="{Binding NoLlmChosen, Converter={StaticResource InverseBool}}">

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.cozumleme-bitince-tutarliligi-da-denetle}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="{loc:T settingswindow.kapaliyken-gorusme-penceresindeki-dugmeden}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                 IsChecked="{Binding ConsistencyAutomatically}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:T settingswindow.tutarlilik-icin-ayri-model}" FontSize="{StaticResource TextBody}" />
                                <ui:TextBox Text="{Binding ConsistencyModel, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{loc:T settingswindow.bos-cozumleme-modeli}" Margin="0,8,0,0" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="{loc:T settingswindow.defter-ucuz-bir-modelde-kalirken-bu-okuma}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.onceki-gorusmelerin-defter-alintilarini-ba}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.acikken-3-mart-ta-15-bin-demisti-turu-capr}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                 IsChecked="{Binding ConsistencyUsesLedgerContext}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.yalnizca-karsi-tarafi-denetle}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.kapaliyken-iki-tarafin-ifadeleri-de-gozlem}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                 IsChecked="{Binding ConsistencyOtherPartyOnly}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:T settingswindow.yalan-ve-manipulasyon}" Style="{StaticResource GroupHeader}" Margin="0,16,0,4" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.yalan-ve-manipulasyon-degerlendirmesi}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.acikken-model-denetimle-birlikte-acik-goru}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                 IsChecked="{Binding DeceptionEnabled}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:T settingswindow.kisi-karti}" Style="{StaticResource GroupHeader}" Margin="0,16,0,4" />

                        <!--
                            The contact card's bottom panel: what a model makes of a PERSON.

                            The broadest claim anything in this product makes, so the card says all
                            four things before the switch is touched — it is a paid request, the
                            text can be wrong, it is an impression and not a finding, and it is off
                            unless somebody turns it on. The caption underneath names the two
                            boundaries the panel itself repeats, so a reader deciding here knows
                            what they are NOT buying.

                            The badge shows only when the feature turned ITSELF off: three people
                            in a row whose reading the user rejected. Turning the switch back on
                            clears it, which is the user overruling the measurement knowingly.
                        -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:T settingswindow.kisi-karti-modelin-gorusu}" FontSize="{StaticResource TextBody}" />
                                        <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                Visibility="{Binding ContactReadingMeasuredNegative, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource PillText}" Text="{loc:T settingswindow.olcum-olumsuz}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.ucretli-istek-metin-yanlis-olabilir}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.panelin-iki-siniri}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.olcum-olumsuz-aciklama}"
                                               Visibility="{Binding ContactReadingMeasuredNegative, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                 IsChecked="{Binding ContactReadingEnabled}" />
                            </Grid>
                        </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--
                        Coaching: what the application says about how YOU speak.

                        Only switches whose feature exists are here. The Ses group holds exactly
                        one, the live meter, because that is the one thing in it that is built; the
                        loudness strip and the pitch measure the plan's wireframe drew beside it are
                        not, and neither is the Kişi group (evidence accumulation, the model's
                        opinion of a contact). A switch for a feature that does not exist is a lie
                        told in a control panel — somebody turns it on, nothing happens, and every
                        other switch on the page loses its credibility. They arrive with their
                        features.
                    -->
                    <StackPanel x:Name="PageCoaching" Visibility="Collapsed">
                        <TextBlock Text="{loc:T settingswindow.kocluk}" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="{loc:T settingswindow.kocluk-aciklama}" />

                        <TextBlock Text="{loc:T settingswindow.aynam}" Style="{StaticResource GroupHeader}" Margin="0,0,0,8" />

                        <!-- On by default, which nothing else derived from a conversation is: it
                             is arithmetic over lines already stored, so the caption says what it
                             costs (nothing) and what it counts (only your own channel). -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.aliskanlik-sayimi}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.bu-makinede-model-yok-ucretsiz}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                 IsChecked="{Binding HabitCountingEnabled}" />
                            </Grid>
                        </Border>

                        <!-- The dictionaries the counters read, with their sizes on the row: a
                             count is the only honest summary of a list this screen must not print.
                             Şive is named and excluded here rather than left off, because a
                             missing row reads as an oversight and an empty one as a bug. -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.sozlukler}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock x:Name="LexiconCounts" Style="{StaticResource Caption}"
                                               Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:Button Grid.Column="1" VerticalAlignment="Center" Padding="10,4"
                                           Appearance="Secondary" Click="EditLexicon_Click"
                                           Content="{loc:T settingswindow.duzenle}" />
                            </Grid>
                        </Border>

                        <!-- Off by default. Every other switch here changes what happens after a
                             call; this one puts a box in front of somebody about to speak. -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.niyet-karti}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.niyet-karti-aciklama}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                 IsChecked="{Binding IntentCardEnabled}" />
                            </Grid>
                        </Border>

                        <!-- A measurement that has not been made, said as such.
                             The plan's wireframe drew example numbers per engine here. There are
                             none: no threshold has been established for any engine, and printing a
                             plausible one would be the screen inventing a figure. -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:T settingswindow.kelime-guveni-esigi}" FontSize="{StaticResource TextBody}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="{loc:T settingswindow.kelime-guveni-esigi-henuz-olculmedi}" />
                            </StackPanel>
                        </Border>

                        <!-- The archive counted retroactively, on the user's press rather than on
                             every start: it is minutes of background work over months of calls,
                             and something that long must be asked for and must be visible. -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:T settingswindow.gecmis-gorusmeleri-say}" FontSize="{StaticResource TextBody}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="{loc:T settingswindow.gecmis-gorusmeleri-say-aciklama}" />

                                <ui:Button x:Name="CountBacklogButton" Padding="10,4" Margin="0,10,0,0"
                                           HorizontalAlignment="Left" Appearance="Secondary"
                                           Click="CountBacklog_Click"
                                           Content="{loc:T settingswindow.gecmis-gorusmeleri-say}" />

                                <TextBlock x:Name="BacklogStatus" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource Caption}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!--
                            Ses: the one thing this application is allowed to say, live, about how
                            the user sounds — which is a share of the speaking time and nothing
                            else. One switch, because one feature exists.
                        -->
                        <TextBlock Text="{loc:T settingswindow.ses}" Style="{StaticResource GroupHeader}" Margin="0,16,0,8" />

                        <!-- On by default, unlike everything else in this group, and the caption
                             says why: the measurement is what makes the next decision possible.
                             Whether a level band on the timeline tells anybody anything can only
                             be settled by listening to sixty of its peaks, and there is nothing to
                             listen to until the numbers exist. What it is NOT is said in the same
                             breath, because "ses ölçümü" is exactly the phrase people expect to be
                             followed by a mood or a stress reading. -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.ses-duzeyi-ve-perde-olcumu}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.ses-duzeyi-ve-perde-olcumu-aciklama}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                 IsChecked="{Binding ProsodyMeasurementEnabled}" />
                            </Grid>
                        </Border>

                        <!-- The band that is not drawn yet, and the gate it has to pass. Written
                             under the switch for the same reason the alarm's absence is written
                             under the meter: somebody who turns the measurement on will look for
                             where it shows, and the honest answer is "nowhere until it earns it". -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:T settingswindow.zaman-cizgisinde-ses-seridi}" FontSize="{StaticResource TextBody}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="{loc:T settingswindow.ses-seridi-henuz-olculmedi}" />
                            </StackPanel>
                        </Border>

                        <!-- Off by default, and more firmly than the intent card: the card shows
                             once at the start of a call, this is on screen for all of it. The
                             caption says exactly what appears and, in the same breath, that it
                             never warns — because a meter is the shape of thing people expect to
                             start shouting at them, and that expectation would change how they
                             speak more than the number does. -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.canli-konusma-olceri}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{loc:T settingswindow.canli-konusma-olceri-aciklama}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                 IsChecked="{Binding LiveTalkMeterEnabled}" />
                            </Grid>
                        </Border>

                        <!-- The alarm that is not here, and the measurement that would have to
                             come first. Written under the switch rather than left out, because
                             "why does it not just tell me when I am shouting" is the first
                             question this meter provokes, and the answer is a gate with a number
                             in it that nobody has run yet. -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:T settingswindow.canli-uyari}" FontSize="{StaticResource TextBody}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="{loc:T settingswindow.canli-uyari-henuz-olculmedi}" />
                            </StackPanel>
                        </Border>

                        <!--
                            What is deliberately not offered, listed where somebody would look for
                            it. Written out rather than silently absent: the difference between "we
                            did not think of it" and "we measured it and it does not work" is the
                            whole of this product's honesty, and the "neden" button carries the
                            reasons rather than a marketing sentence.
                        -->
                        <TextBlock Text="{loc:T settingswindow.olculmeyenler}" Style="{StaticResource GroupHeader}" Margin="0,16,0,8" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="{loc:T settingswindow.olculmeyenler-liste}" />
                                <ui:Button Grid.Column="1" VerticalAlignment="Center" Padding="10,4" Margin="12,0,0,0"
                                           Appearance="Transparent" Click="WhyNotMeasured_Click"
                                           Content="{loc:T settingswindow.neden}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Export -->
                    <StackPanel x:Name="PageExport" Visibility="Collapsed">
                        <TextBlock Text="{loc:T settingswindow.disa-aktarma}" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="{loc:T settingswindow.gorusme-ozetlerinin-uygulama-disina-yazilm}" />

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.obsidian}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="{loc:T settingswindow.vault-klasorune-markdown-dosyalari-yazar-t}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding ExportToObsidian}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}"
                                Visibility="{Binding ExportToObsidian, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" VerticalAlignment="Center"
                                            Text="{Binding ObsidianVaultPath, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{loc:T settingswindow.vault-klasoru}" />
                                <ui:Button Grid.Column="1" Content="{loc:T settingswindow.sec}" Margin="8,0,0,0" MinWidth="80"
                                           VerticalAlignment="Center" Click="BrowseVault_Click" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Cloud24" FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T settingswindow.notion}" FontSize="{StaticResource TextBody}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Text="{loc:T settingswindow.bulut-servisidir-ozetler-notion-sunuculari}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                 IsChecked="{Binding ExportToNotion}" />
                            </Grid>
                        </Border>

                        <StackPanel Visibility="{Binding ExportToNotion, Converter={StaticResource BoolToVisibility}}">
                            <!--
                                What goes and what never goes, written out.

                                A checkbox that quietly decides how much of somebody's private
                                conversation leaves the machine is not a checkbox anybody can
                                consent to. The list comes from the exporter itself, so it cannot
                                drift away from what the code actually does.
                            -->
                            <Border Style="{StaticResource Panel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{loc:T settingswindow.gonderilenler}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding NotionSends}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" Margin="0,0,8,0"
                                                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:T settingswindow.asla-gonderilmeyenler}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding NotionNeverSends}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Margin="0,0,8,0"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="{loc:T settingswindow.notion-anahtari}" FontSize="{StaticResource TextBody}" />
                                    <ui:PasswordBox Password="{Binding NotionApiKey, Mode=TwoWay}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="{loc:T settingswindow.veritabani-kimligi}" FontSize="{StaticResource TextBody}" />
                                    <ui:TextBox Text="{Binding NotionDatabaseId, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,8,0,10" />

                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="{loc:T settingswindow.baglantiyi-sina}" MinWidth="128"
                                                   Command="{Binding TestNotionCommand}"
                                                   IsEnabled="{Binding IsTestingNotion, Converter={StaticResource InverseBool}}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="PlugConnected24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="10,0,0,0"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsTestingNotion, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding NotionStatus}" Margin="0,10,0,0" TextWrapping="Wrap"
                                               FontSize="{StaticResource TextSecondary}"
                                               Visibility="{Binding NotionStatus, Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NotionStatusIsGood}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- The bar spans the window so its rule does; what sits on it sits under the content
             column: a spacer the width of the rail, then a star column capped at 760 — the same
             numbers as PageScroll above, so Kaydet ends where the last card ends. Right-aligned to
             the window, it was some 870 px from that card on a 1920 px screen: reachable in the
             sense that a target is reachable. (A left-aligned grid with MaxWidth would not do: it
             shrinks to its content when the problem list is empty, and the buttons drift left.) -->
        <Border Grid.Row="2" Padding="24,14,32,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" MaxWidth="760" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Problems}" VerticalAlignment="Center"
                                  Margin="0,0,16,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="14" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               FontSize="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Content="{loc:T settingswindow.vazgec}" Margin="0,0,8,0" MinWidth="96" Click="Cancel_Click" />
                        <ui:Button Content="{loc:T settingswindow.kaydet}" Appearance="Primary" MinWidth="96" Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- In-window dialog layer: Dialogs.ConfirmAsync/InfoAsync present here, over
             everything, instead of the Win32-gray MessageBox. -->
        <ContentPresenter x:Name="DialogHost" Grid.RowSpan="99" Grid.ColumnSpan="99"
                          Panel.ZIndex="9999" />
    </Grid>
</ui:FluentWindow>