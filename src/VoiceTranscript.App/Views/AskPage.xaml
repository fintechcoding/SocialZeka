<UserControl x:Class="VoiceTranscript.App.Views.AskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!--
            One quote, in the two places quotes appear on this page: under the answer that has
            just come back, and under every answer stored from before. Written once so the two
            cannot drift — a stored answer whose evidence looked different from a fresh one's
            would read as a weaker kind of evidence, and it is the same quote.

            The command is reached through the page rather than through the nearest ItemsControl,
            because in the history list the nearest one is the exchange's own.
        -->
        <DataTemplate x:Key="CitationCard">
            <Border Style="{StaticResource HoverCard}" Padding="16,13" Margin="0,0,0,8">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>

                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                Margin="0,0,8,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource ThemBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMe}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MeBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <TextBlock Grid.Column="1" Text="{Binding Who}" FontWeight="SemiBold"
                                   FontSize="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Text="{Binding When}" />
                            <TextBlock Style="{StaticResource TimeLink}" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding At}"
                                       ToolTip="{loc:T askpage.bu-ani-dinlemek-icin-tikla}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                               FontSize="{StaticResource TextBody}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PadPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:T askpage.sor}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{loc:T askpage.konusulanlara-dair-bir-soru-sor-cevap-yaln}" />
        </StackPanel>

        <!-- The question, and what to narrow it to. -->
        <Border Grid.Row="1" Style="{StaticResource SettingCard}" Margin="0,4,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0"
                                PlaceholderText="{loc:T askpage.ornek-ahmet-le-fiyat-konusunda-ne-konusuld}"
                                Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsThinking, Converter={StaticResource InverseBool}}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AskCommand}" />
                        </ui:TextBox.InputBindings>
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Chat24" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <ui:Button Grid.Column="1" Content="{loc:T askpage.sor}" Appearance="Primary"
                               MinWidth="92" Margin="10,0,0,0"
                               Command="{Binding AskCommand}"
                               Visibility="{Binding IsThinking, Converter={StaticResource InverseBoolToVisibility}}" />

                    <ui:Button Grid.Column="1" Content="{loc:T askpage.vazgec}"
                               MinWidth="92" Margin="10,0,0,0"
                               Command="{Binding CancelCommand}"
                               Visibility="{Binding IsThinking, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Contacts}" SelectedItem="{Binding Contact}"
                              DisplayMemberPath="Name" />

                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource PeriodName}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,20">
            <StackPanel>

                <!--
                    Before the first question.

                    An empty box with a cursor in it is the worst introduction to a feature whose
                    usefulness depends on knowing what it can be asked. Once the page has answers
                    stored on it there is nothing left to introduce, so the examples step aside.
                -->
                <StackPanel Visibility="{Binding ShowSuggestions, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:T askpage.sunlari-deneyebilirsin}" Style="{StaticResource GroupHeader}" />

                    <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Content="{Binding}" Margin="0,0,8,8"
                                           Command="{Binding DataContext.UseSuggestionCommand,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Working. -->
                <Border Style="{StaticResource SettingCard}"
                        Visibility="{Binding IsThinking, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Secondary}"
                                   Text="{loc:T askpage.kayitlar-taraniyor-ve-okunuyor-yerel-model}" />
                    </StackPanel>
                </Border>

                <!--
                    The answer.

                    Marked as coming from a model, every time. The excerpts below it are the
                    record; this sentence is a reading of them.
                -->
                <Border Style="{StaticResource SettingCard}"
                        Visibility="{Binding HasAnswer, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Sparkle24" FontSize="15" Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Text="{loc:T askpage.asagidaki-alintilardan-cikarildi}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Answer}" TextWrapping="Wrap"
                                   FontSize="{StaticResource TextBody}" LineHeight="22" />

                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding IsInsufficient, Converter={StaticResource BoolToVisibility}}"
                                   Text="{loc:T askpage.bulunan-alintilar-soruyu-tam-karsilamiyor}" />
                    </StackPanel>
                </Border>

                <!-- When the answer was withheld, this says why — and the excerpts still follow. -->
                <ui:InfoBar Severity="Warning" IsOpen="True" Margin="0,0,0,14"
                            Title="{loc:T askpage.cevap-gosterilmedi}"
                            Message="{Binding Problem}"
                            Visibility="{Binding Problem, Converter={StaticResource NullToCollapsed}}" />

                <TextBlock Text="{loc:T askpage.dayandigi-konusmalar}" Style="{StaticResource GroupHeader}"
                           Visibility="{Binding HasCitations, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Citations}"
                              ItemTemplate="{StaticResource CitationCard}" />

                <!--
                    What was asked before, and what came back.

                    The page opens on this list and it costs nothing: every answer here was paid
                    for once and written down, quotes included, so reading it again is a database
                    read. Nothing is re-asked without a press.

                    Each answer is signed and dated on its own line — the ≈ ground. The quotes
                    under it are the evidence and stay clickable; the sentence above them is one
                    model's reading of those quotes on one day, and the signature says so.
                -->
                <TextBlock Text="{loc:T askpage.sorulanlar-ve-cevaplari}" Style="{StaticResource GroupHeader}"
                           Margin="0,14,0,0"
                           Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Exchanges}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SettingCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Question}" TextWrapping="Wrap"
                                               FontWeight="SemiBold" FontSize="{StaticResource TextBody}" />

                                    <TextBlock Text="{Binding Scope}" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Scope, Converter={StaticResource NullToCollapsed}}" />

                                    <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               FontSize="{StaticResource TextBody}" LineHeight="22" />

                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding Insufficient, Converter={StaticResource BoolToVisibility}}"
                                               Text="{loc:T askpage.bulunan-alintilar-soruyu-tam-karsilamiyor}" />

                                    <ItemsControl ItemsSource="{Binding Citations}" Margin="0,12,0,0"
                                                  ItemTemplate="{StaticResource CitationCard}"
                                                  Visibility="{Binding HasCitations, Converter={StaticResource BoolToVisibility}}" />

                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Stamp}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" />

                                        <ui:Button HorizontalAlignment="Right" Appearance="Transparent"
                                                   Padding="8,1" FontSize="{StaticResource TextCaption}"
                                                   Content="{loc:T askpage.kaldir}"
                                                   ToolTip="{loc:T askpage.bu-soruyu-ve-cevabini-kaldir}"
                                                   Command="{Binding DataContext.RemoveCommand,
                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
