<UserControl x:Class="VoiceTranscript.App.Views.ProcessingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProcessingViewModel}">

    <UserControl.Resources>
        <!--
            One row body, two thin wrappers. The anatomy of a row is the same in either tab;
            what differs is the verb on its button — and the verb matters: "Yeniden işle" on the
            analysis tab used to reopen the full dialog and demand audio, locking out the one
            route (re-analysing from text) that tab exists for.
        -->
        <DataTemplate x:Key="ProcessingRowBody">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ContactName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding When}" Margin="10,0,0,0"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Length}" Margin="10,0,0,0"
                                                   FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding AppName}" Margin="10,0,0,0"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- On the row being worked on, the bar lives on the row too —
                                         the strip above says the same thing, but the eye scanning
                                         a list wants the answer where the question is. -->
                                    <StackPanel Margin="0,4,12,0">
                                        <StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource EqualToVisibility}">
                                                <Binding Path="Id" />
                                                <Binding Path="DataContext.ActiveCallId"
                                                         RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            </MultiBinding>
                                        </StackPanel.Visibility>
                                        <ProgressBar Height="3" Minimum="0" Maximum="1"
                                                     Value="{Binding DataContext.ActivePercent, Mode=OneWay,
                                                             RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                     IsIndeterminate="{Binding DataContext.HasActivePercent,
                                                             Converter={StaticResource InverseBool},
                                                             RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    </StackPanel>

                                    <!-- The reason, when there is one. Shown rather than hidden behind
                                         a click: one missing package explains every row at once, and
                                         seeing that is what turns eight mysteries into one problem. -->
                                    <TextBlock Text="{Binding Failure}" Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Failure, Converter={StaticResource NullToCollapsed}}"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               Style="{StaticResource Caption}" />

                                    <!-- Guidance dressed as guidance. "Yapılandırılmış servis
                                         yok, Ayarlar bölümünden…" is the application giving
                                         directions; in red it read as a crash, and the door it
                                         named had no handle. Now the sentence carries its own
                                         button to the section it means. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                Visibility="{Binding GuidanceText, Converter={StaticResource NullToCollapsed}}">
                                        <ui:SymbolIcon Symbol="Info24" FontSize="13" Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        <TextBlock Text="{Binding GuidanceText}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" MaxWidth="520"
                                                   Style="{StaticResource Caption}" />
                                        <ui:Button Content="{loc:T processingpage.ayarlari-ac}" Appearance="Transparent" Padding="8,2"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Click="RowOpenSettings_Click" />
                                    </StackPanel>

                                    <!-- Information on a row that did NOT fail — "çözümleme
                                         yapılmadı" on a transcribed call. It used to wear the
                                         failure red inside the error expander. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                Visibility="{Binding StateNote, Converter={StaticResource NullToCollapsed}}">
                                        <ui:SymbolIcon Symbol="Info24" FontSize="13" Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding StateNote}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" MaxWidth="620"
                                                   Style="{StaticResource Caption}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!--
                                        The whole reason, on demand.

                                        The summarised sentence has to fit a row; the original is
                                        what actually names the library, the status code or the
                                        rejected parameter. It used to live only in a tooltip,
                                        which cannot be selected, cannot be copied, and disappears
                                        while you are reading it — on the one screen whose purpose
                                        is explaining what went wrong.
                                    -->
                                    <Expander Margin="0,4,0,0" Padding="0"
                                              Visibility="{Binding RawFailure, Converter={StaticResource NullToCollapsed}}">
                                        <Expander.Header>
                                            <TextBlock Text="{loc:T processingpage.hatanin-tamami}" Style="{StaticResource Caption}" />
                                        </Expander.Header>

                                        <Border Style="{StaticResource QuoteBlock}" Margin="0,6,0,0">
                                            <StackPanel>
                                                <TextBox Text="{Binding RawFailure, Mode=OneWay}"
                                                         IsReadOnly="True" TextWrapping="Wrap"
                                                         BorderThickness="0" Background="Transparent"
                                                         MaxHeight="160"
                                                         VerticalScrollBarVisibility="Auto"
                                                         FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                                         FontSize="{StaticResource TextCaption}" />

                                                <ui:Button Content="{loc:T processingpage.kopyala}" Appearance="Transparent"
                                                           HorizontalAlignment="Left" Margin="0,6,0,0"
                                                           Click="CopyFailure_Click" Tag="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0"
                                            MinWidth="170">
                                    <TextBlock Text="{Binding TranscriptState}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding AnalysisState}" Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TranscriptRowTemplate">
            <Grid Margin="0,4" Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:T processingpage.gorusmeyi-ac}" Click="RowOpen_Click" FontWeight="SemiBold" />
                        <Separator />
                        <MenuItem Header="{loc:T processingpage.baska-kisiye-tasi}" Click="RowMove_Click" />
                        <MenuItem Header="{loc:T processingpage.yeniden-cevir}" Click="RowRetranscribe_Click" />
                        <MenuItem Header="{loc:T processingpage.yeniden-cozumle}" Click="RowReanalyse_Click" />
                        <MenuItem Header="{loc:T processingpage.ses-dosyasinin-yerini-ac}" Click="RowShowInFolder_Click" />
                        <Separator />
                        <MenuItem Header="{loc:T processingpage.gorusmeyi-sil}" Click="RowDelete_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="0" Content="{Binding}"
                                  ContentTemplate="{StaticResource ProcessingRowBody}" />

                <ui:Button Grid.Column="1" Content="{loc:T processingpage.yeniden-cevir}" VerticalAlignment="Center"
                           Appearance="Transparent"
                           IsEnabled="{Binding HasAudio}"
                           ToolTip="{loc:T processingpage.sesi-sececegin-bir-motorla-yeniden-yaziya}"
                           Click="Reprocess_Click" Tag="{Binding}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AnalysisRowTemplate">
            <Grid Margin="0,4" Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:T processingpage.gorusmeyi-ac}" Click="RowOpen_Click" FontWeight="SemiBold" />
                        <Separator />
                        <MenuItem Header="{loc:T processingpage.baska-kisiye-tasi}" Click="RowMove_Click" />
                        <MenuItem Header="{loc:T processingpage.yeniden-cevir}" Click="RowRetranscribe_Click" />
                        <MenuItem Header="{loc:T processingpage.yeniden-cozumle}" Click="RowReanalyse_Click" />
                        <MenuItem Header="{loc:T processingpage.ses-dosyasinin-yerini-ac}" Click="RowShowInFolder_Click" />
                        <Separator />
                        <MenuItem Header="{loc:T processingpage.gorusmeyi-sil}" Click="RowDelete_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="0" Content="{Binding}"
                                  ContentTemplate="{StaticResource ProcessingRowBody}" />

                <!-- Text is what analysis needs, so text is what unlocks the button — a call
                     whose audio was swept can still rebuild its ledger. -->
                <ui:Button Grid.Column="1" Content="{loc:T processingpage.yeniden-cozumle}" VerticalAlignment="Center"
                           Appearance="Transparent"
                           IsEnabled="{Binding HasTranscript}"
                           ToolTip="{loc:T processingpage.defteri-mevcut-metinden-yeniden-uretir-ses}"
                           Click="ReanalyseRow_Click" Tag="{Binding}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,4,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Four counts, and they are the whole point of the screen.

            Before this existed, a run of failures caused by one missing Python package looked like
            eight separate mysteries: the first screen said "N görüşme işlenemedi" and nothing
            about which, or why, or whether the audio was still there. On a machine without a
            usable GPU it matters more still — transcription runs several times slower than real
            time, so an application that is working looks exactly like one that has hung.
        -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Each counter is a door, not a decoration: clicking one lands on the tab and
                 filter that show exactly the rows it counted. The labels follow the tabs too —
                 "başarısız" used to sum two different failures and point at neither. -->
            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,8,0"
                    Cursor="Hand" MouseLeftButtonUp="CounterWaiting_Click"
                    ToolTip="{loc:T processingpage.yaziya-dokme-sekmesinde-bekleyenleri-goste}">
                <StackPanel>
                    <TextBlock Text="{Binding WaitingCount}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:T processingpage.sirada-isleniyor}" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="8,0"
                    Cursor="Hand" MouseLeftButtonUp="CounterTranscriptFailed_Click"
                    ToolTip="{loc:T processingpage.yaziya-dokme-sekmesinde-basarisizlari-gost}">
                <StackPanel>
                    <TextBlock Text="{Binding TranscriptFailedCount}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{loc:T processingpage.yaziya-dokulemedi}" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="8,0"
                    Cursor="Hand" MouseLeftButtonUp="CounterUnanalysed_Click"
                    ToolTip="{loc:T processingpage.cozumleme-sekmesinde-bekleyenleri-gosterir}">
                <StackPanel>
                    <TextBlock Text="{Binding UnanalysedCount}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:T processingpage.cozumlenmedi}" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource Panel}" Margin="8,0,0,0"
                    Cursor="Hand" MouseLeftButtonUp="CounterReady_Click"
                    ToolTip="{loc:T processingpage.cozumleme-sekmesinde-bitenleri-gosterir}">
                <StackPanel>
                    <TextBlock Text="{Binding ReadyCount}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:T processingpage.hazir}" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--
            What is happening right now.

            Only visible while something is being worked on, and it is the reason the rest of the
            screen is not enough on its own: a state field saying "Yazıya dökülüyor" is the same
            whether the job started ten seconds ago or is nearly done. Without a graphics card that
            distinction is the difference between waiting a minute and waiting an hour.
        -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,12"
                Visibility="{Binding IsWorkingOnSomething, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,8,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding ActiveLine}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Ends this one job; the queue behind it carries on. The recording is
                             parked, not lost — "Yeniden işle" stays one click away. -->
                        <ui:Button Content="{loc:T processingpage.durdur}" Appearance="Secondary" Padding="10,4"
                                   Click="StopCurrent_Click" ToolTip="{loc:T processingpage.bu-kaydin-islenmesini-durdur}" />

                        <!-- And the one that actually stops. Durdur on its own only interrupted:
                             the next of the five waiting started a second later, so on a screen
                             reading "5 sırada" there was no way to stop uploading short of closing
                             the application. Everything it takes out of the queue is parked. -->
                        <ui:Button Content="Hepsini durdur" Appearance="Secondary" Padding="10,4" Margin="8,0,0,0"
                                   Click="StopEverything_Click"
                                   ToolTip="Sıradaki bütün kayıtları da durdurur; hiçbiri silinmez."
                                   Visibility="{Binding HasQueue, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>

                <!-- Determinate when the worker gives a fraction, and a moving bar when it does
                     not — an empty bar sitting at zero reads as stuck. -->
                <ProgressBar Height="4" Minimum="0" Maximum="1"
                             Value="{Binding ActivePercent, Mode=OneWay}"
                             IsIndeterminate="{Binding HasActivePercent, Converter={StaticResource InverseBool}}" />
            </StackPanel>
        </Border>


        <!--
            Two tabs, two questions: did the audio become text, and did the text become a ledger.

            They used to share one list and one set of filters, and the user's verdict is on
            record: "kafa karıştırıyor ve çok hata çıktı". A call whose analysis failed sat
            between calls whose transcription failed, wearing the same red, offering the same
            buttons — different faults, different fixes, indistinguishable rows.
        -->
        <TabControl x:Name="Tabs" Grid.Row="2" Grid.RowSpan="2" Style="{StaticResource SegmentedTabs}"
                    Padding="0,10,0,0">

            <TabItem Header="{loc:T processingpage.yaziya-dokme}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:Button Content="{loc:T processingpage.bekleyenler}" Margin="0,0,6,0" Command="{Binding ShowTranscriptWaitingCommand}"
                                       Appearance="{Binding TranscriptFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Unfinished}" />
                            <ui:Button Content="{loc:T processingpage.bitenler}" Margin="0,0,6,0" Command="{Binding ShowTranscriptDoneCommand}"
                                       Appearance="{Binding TranscriptFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Done}" />
                            <ui:Button Content="{loc:T processingpage.hepsi}" Command="{Binding ShowTranscriptAllCommand}"
                                       Appearance="{Binding TranscriptFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=All}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="{loc:T processingpage.yenile}" Margin="0,0,6,0" Command="{Binding RefreshCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Content="{loc:T processingpage.listedekileri-yeniden-yaziya-dok}" Appearance="Primary"
                                       Click="RetranscribeAll_Click"
                                       ToolTip="{loc:T processingpage.bu-sekmede-gorunen-butun-gorusmeleri-yenid}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Panel}">
                        <Grid>
                            <ListBox Style="{StaticResource CleanList}" ItemsSource="{Binding TranscriptRows}"
                                     ItemTemplate="{StaticResource TranscriptRowTemplate}"
                                     Visibility="{Binding IsTranscriptEmpty, Converter={StaticResource InverseBoolToVisibility}}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                            <StackPanel Style="{StaticResource EmptyState}"
                                        Visibility="{Binding IsTranscriptEmpty, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="36" HorizontalAlignment="Center"
                                               Margin="0,0,0,14"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Style="{StaticResource EmptyTitle}" Text="{Binding TranscriptEmptyMessage}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:T processingpage.cozumleme}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:Button Content="{loc:T processingpage.bekleyenler}" Margin="0,0,6,0" Command="{Binding ShowAnalysisUnanalysedCommand}"
                                       Appearance="{Binding AnalyseFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Unanalysed}" />
                            <ui:Button Content="{loc:T processingpage.bitenler}" Margin="0,0,6,0" Command="{Binding ShowAnalysisDoneCommand}"
                                       Appearance="{Binding AnalyseFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=Done}" />
                            <ui:Button Content="{loc:T processingpage.hepsi}" Command="{Binding ShowAnalysisAllCommand}"
                                       Appearance="{Binding AnalyseFilter, Converter={StaticResource FilterAppearance}, ConverterParameter=All}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="{loc:T processingpage.yenile}" Margin="0,0,6,0" Command="{Binding RefreshCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <!-- Works from the text: fast, cheap, and possible even when the
                                 audio has since been swept. -->
                            <ui:Button Content="{loc:T processingpage.listedekileri-yeniden-cozumle}" Appearance="Primary"
                                       Click="ReanalyseAll_Click"
                                       ToolTip="{loc:T processingpage.bu-sekmede-gorunen-gorusmelerin-defterini}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Sparkle24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Panel}">
                        <Grid>
                            <ListBox Style="{StaticResource CleanList}" ItemsSource="{Binding AnalysisRows}"
                                     ItemTemplate="{StaticResource AnalysisRowTemplate}"
                                     Visibility="{Binding IsAnalysisEmpty, Converter={StaticResource InverseBoolToVisibility}}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                            <StackPanel Style="{StaticResource EmptyState}"
                                        Visibility="{Binding IsAnalysisEmpty, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="36" HorizontalAlignment="Center"
                                               Margin="0,0,0,14"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Style="{StaticResource EmptyTitle}" Text="{Binding AnalysisEmptyMessage}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!--
            What just happened.

            The view model has always written a sentence here — "1 görüşme yeniden kuyruğa
            alındı", or the reason nothing could be — and nothing displayed it. Pressing
            "Yeniden işle" therefore did its work in silence, which from the outside is
            indistinguishable from a button that does not work.
        -->
        <Border Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Margin="12" Padding="14,10" CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="16" Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

                <TextBlock Grid.Column="1" Text="{Binding Notice}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />

                <ui:Button Grid.Column="2" Appearance="Transparent" Margin="10,0,0,0"
                           Click="DismissNotice_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
