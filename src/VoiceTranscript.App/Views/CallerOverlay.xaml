<Window x:Class="VoiceTranscript.App.Views.CallerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VoiceTranscript.App"
        Title="{loc:T calleroverlay.kim-ariyor}"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ShowActivated="False">

    <!--
        Who is on the other end, and the two or three things worth knowing about them, while the
        call is still happening.

        The application has always held this — a note the user typed about somebody, a promise
        somebody made that has not come due — and has only ever shown it afterwards, when reading
        the transcript. Afterwards is the wrong time: the use for "he still owes an answer on the
        integration" is during the sentence where he does not mention it.

        Two rules shape the content and both come from elsewhere in this codebase.

        The sections are kept apart because the schema keeps them apart. contact_profile and
        contact_field are what the user typed and nothing in the analysis pipeline may write them;
        the ledger is what the machine heard, each line carrying a quote. Mixing them on screen
        would undo a separation the database is built around — the user would stop being able to
        tell which of these they said and which the application decided.

        And it stays small. This sits over a live call: it has to be readable in a glance taken
        while listening, and anything that needs a second glance will not get one.

        The card is dragged by its own body, and the strip above it comes along. It is over
        somebody's call window, and the one place a floating panel must never be is wherever the
        person needs to click next — which is a question only they can answer, so they move it.
    -->
    <Border x:Name="Body"
            CornerRadius="12"
            Padding="0"
            Background="#F2141414"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            MinWidth="260"
            MaxWidth="360"
            Cursor="SizeAll"
            ToolTip="{loc:T calleroverlay.surukleyerek-tasi}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <StackPanel>

            <!-- Who. The one line somebody reads mid-sentence, so it is the only large thing here. -->
            <Grid Margin="12,11,10,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                        Background="#2E6FF2" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="InitialText" Text="?" Foreground="#FFFFFF"
                               FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NameText" Text="—" Foreground="#FFFFFF"
                                   FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                        <!--
                            The score is a chip rather than a number stuck to the name, because
                            this is a guess. A name on its own reads as a fact and this one is not
                            one; a name wearing a percentage reads as an offer, which it is.
                        -->
                        <Border Background="#33FFFFFF" CornerRadius="7" Padding="6,1" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ConfidenceText" Text="%0" Foreground="#D8FFFFFF"
                                       FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="LastCallText" Foreground="#8AFFFFFF" FontSize="11"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="2" x:Name="HideButton" Content="✕" Click="HideForCall_Click"
                        ToolTip="{loc:T calleroverlay.kim-oldugunu-gizle}"
                        Background="Transparent" Foreground="#80FFFFFF" BorderThickness="0"
                        Padding="7,2" FontSize="12" Cursor="Hand" VerticalAlignment="Top" />
            </Grid>

            <!-- What the user typed about them. Theirs, and never written by the pipeline. -->
            <StackPanel x:Name="NotesSection" Margin="12,0,12,11">
                <Border Height="1" Background="#1FFFFFFF" Margin="0,0,0,9" />

                <TextBlock Text="{loc:T calleroverlay.senin-notlarin}" Foreground="#66FFFFFF"
                           FontSize="9.5" FontWeight="SemiBold" />

                <TextBlock x:Name="NotesText" Foreground="#E0FFFFFF" FontSize="12"
                           TextWrapping="Wrap" MaxHeight="54" Margin="0,3,0,0" />
            </StackPanel>

            <!-- What the machine heard, each line resting on a quote it can play back later.
                 Two directions, because they are read differently in the moment: what they owe
                 you is what to ask about; what you owe them is what not to be caught out on. -->
            <StackPanel x:Name="CommitmentsSection" Margin="12,0,12,11">
                <Border Height="1" Background="#1FFFFFFF" Margin="0,0,0,9" />

                <TextBlock x:Name="GivenTitle" Text="{loc:T calleroverlay.sana-verilen}" Foreground="#66FFFFFF"
                           FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,4" />

                <ItemsControl x:Name="GivenList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="6" Padding="5,1" Margin="0,1,7,0"
                                        MinWidth="30" VerticalAlignment="Top"
                                        Background="{Binding Tint}">
                                    <TextBlock Text="{Binding Who}" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="#F0FFFFFF" TextAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Foreground="#E0FFFFFF" FontSize="12"
                                           TextWrapping="Wrap">
                                    <Run Text="{Binding Text, Mode=OneWay}" />
                                    <Run Text="{Binding When, Mode=OneWay}" Foreground="#8AFFFFFF" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="MineTitle" Text="{loc:T calleroverlay.senin-verdigin}" Foreground="#66FFFFFF"
                           FontSize="9.5" FontWeight="SemiBold" Margin="0,6,0,4" />

                <ItemsControl x:Name="CommitmentsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--
                                    Who owes it, as a chip. "sen" and "o" were prefixes on the
                                    text and read as part of the sentence; whose promise it is
                                    is the first thing worth knowing about one.
                                -->
                                <Border Grid.Column="0" CornerRadius="6" Padding="5,1" Margin="0,1,7,0"
                                        MinWidth="30" VerticalAlignment="Top"
                                        Background="{Binding Tint}">
                                    <TextBlock Text="{Binding Who}" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="#F0FFFFFF" TextAlignment="Center" />
                                </Border>

                                <TextBlock Grid.Column="1" Foreground="#E0FFFFFF" FontSize="12"
                                           TextWrapping="Wrap">
                                    <Run Text="{Binding Text, Mode=OneWay}" />
                                    <Run Text="{Binding When, Mode=OneWay}" Foreground="#8AFFFFFF" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
