<Window x:Class="VoiceTranscript.App.Views.CallerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VoiceTranscript.App"
        Title="Kim arıyor"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ShowActivated="False">

    <!--
        Who is on the other end, and the two or three things worth knowing about them, while the
        call is still happening.

        The application has always held this — a note the user typed about somebody, a promise
        somebody made that has not come due — and has only ever shown it afterwards, when reading
        the transcript. Afterwards is the wrong time: the use for "he still owes an answer on the
        integration" is during the sentence where he does not mention it.

        Two rules shape the content and both come from elsewhere in this codebase.

        The sections are kept apart because the schema keeps them apart. contact_profile and
        contact_field are what the user typed and nothing in the analysis pipeline may write them;
        the ledger is what the machine heard, each line carrying a quote. Mixing them on screen
        would undo a separation the database is built around — the user would stop being able to
        tell which of these they said and which the application decided.

        And it stays small. This sits over a live call: it has to be readable in a glance taken
        while listening, and anything that needs a second glance will not get one.
    -->
    <Border CornerRadius="0,0,10,10"
            Padding="14,9,10,10"
            Background="#E6111111"
            BorderBrush="#40FFFFFF"
            BorderThickness="1,0,1,1"
            MaxWidth="420">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Foreground="#FFFFFF" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!--
                        The score is on screen, not buried in a log.

                        This is a guess and it is allowed to be wrong; saying how sure it is turns
                        a wrong name from something the application asserted into something it
                        offered. The same reasoning as the "belirsiz" marks on transcript lines.
                    -->
                    <TextBlock x:Name="ConfidenceText" Foreground="#80FFFFFF" FontSize="11"
                               VerticalAlignment="Center" Margin="8,1,0,0" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="HideButton" Content="✕" Click="HideForCall_Click"
                        ToolTip="{loc:T calleroverlay.kim-oldugunu-gizle}"
                        Background="Transparent" Foreground="#80FFFFFF" BorderThickness="0"
                        Padding="6,0" FontSize="11" Cursor="Hand" VerticalAlignment="Top" />
            </Grid>

            <TextBlock x:Name="LastCallText" Foreground="#80FFFFFF" FontSize="11" Margin="0,1,0,0" />

            <!-- What the user wrote. Their own words, needing no quote because they are the source. -->
            <StackPanel x:Name="NotesSection" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="{loc:T calleroverlay.senin-notlarin}" Foreground="#70FFFFFF"
                           FontSize="10" FontWeight="SemiBold" />
                <TextBlock x:Name="NotesText" Foreground="#E0FFFFFF" FontSize="12"
                           TextWrapping="Wrap" Margin="0,2,0,0" MaxHeight="76"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- What the machine heard, each one from a sentence somebody actually said. -->
            <StackPanel x:Name="CommitmentsSection" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="{loc:T calleroverlay.acik-sozler}" Foreground="#70FFFFFF"
                           FontSize="10" FontWeight="SemiBold" />
                <ItemsControl x:Name="CommitmentsList" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="#E0FFFFFF" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,1,0,0" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
