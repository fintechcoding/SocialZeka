<ui:FluentWindow x:Class="VoiceTranscript.App.Views.ContactWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:ContactWindowViewModel}"
                 Title="Kişi"
                 Width="1000" Height="760" MinWidth="760" MinHeight="520"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Name}" />

        <!--
            The heading counts and dates, and nothing else.

            No percentages, no trend arrows, no adjectives about the person. The rule this product
            rests on is that the machine remembers and the person judges — so every figure here is
            something you could count yourself from the rows below, and nothing is a verdict.
        -->
        <Border Grid.Row="1" Style="{StaticResource HeroCard}" Margin="20,4,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Avatar}" Margin="0,0,16,0"
                        Background="{Binding Name, Converter={StaticResource NameBrush}}">
                    <TextBlock Style="{StaticResource AvatarText}"
                               Text="{Binding Name, Converter={StaticResource Initials}}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   FontSize="{StaticResource TextTitle}" />
                        <Border Style="{StaticResource Pill}" Margin="10,4,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource PillText}" Text="{Binding AppName}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>

                <ui:Button Grid.Column="2" Content="Yenile" Appearance="Transparent"
                           VerticalAlignment="Center" Command="{Binding RefreshCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="20,14,20,16" Padding="0,14,0,0"
                    Style="{StaticResource SegmentedTabs}">

            <!-- ================= the conversations ================= -->
            <TabItem Header="Görüşmeler">
                <Grid>
                    <ListBox Style="{StaticResource CleanList}" ItemsSource="{Binding Calls}"
                             MouseDoubleClick="CallRow_DoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasCalls, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding When}" FontWeight="SemiBold" />

                                            <!-- A note is the one thing here a person wrote, so it
                                                 is worth finding again without opening each call. -->
                                            <ui:SymbolIcon Symbol="Note24" FontSize="13" Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           ToolTip="Bu görüşmede notun var"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding State}" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding LedgerText}" Margin="12,0"
                                               VerticalAlignment="Center" Style="{StaticResource Caption}"
                                               Visibility="{Binding HasLedger, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Grid.Column="2" Text="{Binding Length}" VerticalAlignment="Center"
                                               FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Style="{StaticResource EmptyState}"
                                Visibility="{Binding HasCalls, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Style="{StaticResource EmptyTitle}" Text="Bu kişiye ait kayıtlı görüşme yok." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ================= search within this person ================= -->
            <TabItem Header="Ara">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        Line-level, and scoped to this person in the query rather than afterwards.

                        The box on the contact page narrows the CALL list — a different question,
                        and the reason this is not simply a second box in the same place.
                    -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Bu kişiyle konuşulanlarda ara…"
                                    KeyDown="Query_KeyDown" />

                        <ui:ToggleSwitch Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                         Content="Yalnızca karşı taraf"
                                         IsChecked="{Binding OnlyOtherParty}" />

                        <ui:Button Grid.Column="2" Content="Ara" Appearance="Primary" Margin="10,0,0,0"
                                   Command="{Binding SearchCommand}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox Style="{StaticResource CleanList}" ItemsSource="{Binding Hits}"
                                 MouseDoubleClick="Hit_DoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasHits, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,7">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold"
                                                       FontSize="{StaticResource TextCaption}" />
                                            <TextBlock Text="{Binding When}" Margin="10,0,0,0"
                                                       FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Style="{StaticResource EmptyState}"
                                    Visibility="{Binding HasHits, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource EmptyTitle}"
                                       Text="Bu kişiyle konuşulanlarda ara." />
                            <TextBlock Style="{StaticResource EmptyBody}" Margin="0,6,0,0"
                                       Text="Bulunan satıra çift tıklayınca o görüşme açılır ve o andan dinlenir." />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= the ledger ================= -->
            <TabItem Header="Defter">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,10,4">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HasLedger, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Açık sözler" Style="{StaticResource GroupHeader}"
                                       Visibility="{Binding Commitments.Count, Converter={StaticResource CountToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Commitments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SettingCard}" Padding="14,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Obligation}" TextWrapping="Wrap"
                                                           FontWeight="SemiBold" />
                                                <Border Style="{StaticResource QuoteBlock}" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding Quote}" TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="İşaretler" Style="{StaticResource GroupHeader}" Margin="0,16,0,0"
                                       Visibility="{Binding Flags.Count, Converter={StaticResource CountToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Flags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SettingCard}" Padding="14,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                                           FontWeight="SemiBold" />
                                                <Border Style="{StaticResource QuoteBlock}" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding Quote}" TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Style="{StaticResource EmptyState}"
                                    Visibility="{Binding HasLedger, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource EmptyTitle}" Text="Defter boş." />
                            <TextBlock Style="{StaticResource EmptyBody}" Margin="0,6,0,0"
                                       Text="Sözler, değişen rakamlar ve işaretler çözümleme sırasında çıkarılır. Bir yapay zekâ servisi bağlanmamışsa görüşmeler yazıya dökülür ama defter üretilmez." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= notes about the person ================= -->
            <TabItem Header="Notlar">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        About the person, not about a call.

                        Everything else this archive holds was produced by a machine and is replaced
                        whenever a conversation is analysed again. This is the one part somebody
                        wrote, and it survives every reprocess, rename and merge.
                    -->
                    <TextBlock Grid.Row="0" Style="{StaticResource Caption}" Margin="0,0,0,10"
                               Text="Bu kişi hakkında kendi notun. Görüşme notlarından ayrıdır ve yeniden işlemede silinmez." />

                    <ui:TextBox Grid.Row="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True" TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                VerticalScrollBarVisibility="Auto"
                                PlaceholderText="Bu kişiyle ilgili hatırlamak istediklerin…" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <TextBlock Text="Kaydedildi" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Visibility="{Binding NoteSaved, Converter={StaticResource BoolToVisibility}}" />

                        <ui:Button Content="Notu kaydet" Appearance="Primary"
                                   Command="{Binding SaveNoteCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
