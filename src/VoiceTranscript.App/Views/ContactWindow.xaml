<ui:FluentWindow x:Class="VoiceTranscript.App.Views.ContactWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:ContactWindowViewModel}"
                 Title="{Binding Name}"
                 Width="1000" Height="760" MinWidth="760" MinHeight="520"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Name}" />

        <!--
            The heading counts and dates, and nothing else.

            No percentages, no trend arrows, no adjectives about the person. The rule this product
            rests on is that the machine remembers and the person judges — so every figure here is
            something you could count yourself from the rows below, and nothing is a verdict.

            Tighter than the card's default padding: this one sits above a tab strip and a
            list, and every pixel it keeps is one the flow below it loses.
        -->
        <Border Grid.Row="1" Style="{StaticResource HeroCard}" Margin="20,4,20,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The photo when the user gave one, initials otherwise. The photo is a copy the
                     archive owns — never a reference into somebody's Downloads folder. -->
                <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Border Style="{StaticResource Avatar}" Width="52" Height="52" CornerRadius="26"
                            Background="{Binding Name, Converter={StaticResource NameBrush}}"
                            Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Style="{StaticResource AvatarText}" FontSize="18"
                                   Text="{Binding Name, Converter={StaticResource Initials}}" />
                    </Border>

                    <Border Width="52" Height="52" CornerRadius="26"
                            Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding PhotoPath, Converter={StaticResource Photo}}"
                                        Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   FontSize="{StaticResource TextTitle}" />
                        <Border Style="{StaticResource Pill}" Margin="10,4,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource PillText}" Text="{Binding AppName}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />

                    <TextBlock Text="{Binding BirthdayLine}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Visibility="{Binding BirthdayLine, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>

                <ui:Button Grid.Column="2" Content="{loc:T contactwindow.yenile}" Appearance="Transparent"
                           VerticalAlignment="Center" Command="{Binding RefreshCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="20,14,20,16" Padding="0,14,0,0"
                    Style="{StaticResource SegmentedTabs}">

            <!-- ================= the flow ================= -->
            <!-- Everything with this person, one descending stream: calls, notes, findings,
                 promises, suggestions, reminders. "Bu kişiyle nerede kalmıştık" in one scroll
                 instead of four tabs — the CRM people-pane pattern. -->
            <TabItem Header="{loc:T contactwindow.akis}">
                <Grid>
                    <ListBox Style="{StaticResource CleanList}" ItemsSource="{Binding FlowView}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasFlow, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource GroupHeader}"
                                                   Margin="4,10,0,2" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2" Background="Transparent"
                                      MouseLeftButtonUp="FlowRow_Click" Cursor="Hand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- The rail and its dot: the timeline made visible. -->
                                    <Grid Grid.Column="0" Width="14">
                                        <Border Width="2" HorizontalAlignment="Center"
                                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding DotBrushKey, Converter={StaticResource BrushFromKey}}" />
                                    </Grid>

                                    <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Icon}" FontSize="14"
                                                   Margin="8,0,8,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <StackPanel Grid.Column="2" Margin="0,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                   FontSize="{StaticResource TextSecondary}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" Margin="0,1,0,0"
                                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding WhenText}"
                                               Style="{StaticResource Caption}" Margin="10,0,4,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Style="{StaticResource EmptyState}"
                                Visibility="{Binding HasFlow, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T contactwindow.bu-kisiyle-henuz-bir-akis-yok}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ================= the conversations ================= -->
            <TabItem Header="{loc:T contactwindow.gorusmeler}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        Two tiers, because there are two kinds of day. Most days are "browse,
                        maybe a period": one row of chips that read as words. The rare day is
                        an investigation: those controls live behind "Filtreler", each with a
                        LABEL — a naked date box next to two naked date boxes taught nobody
                        which was which, and the user said so.
                    -->
                    <StackPanel Grid.Row="0" Margin="4,0,4,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- The period, as words. One click, no calendar. -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ui:Button Content="{loc:T contactwindow.tumu}" Padding="10,4" Margin="0,0,4,0"
                                           Command="{Binding SetPresetCommand}" CommandParameter="Tümü"
                                           Appearance="{Binding PeriodPreset, Converter={StaticResource FilterAppearance}, ConverterParameter=Tümü}" />
                                <ui:Button Content="{loc:T contactwindow.bu-hafta}" Padding="10,4" Margin="0,0,4,0"
                                           Command="{Binding SetPresetCommand}" CommandParameter="Bu hafta"
                                           Appearance="{Binding PeriodPreset, Converter={StaticResource FilterAppearance}, ConverterParameter=Bu hafta}" />
                                <ui:Button Content="{loc:T contactwindow.bu-ay}" Padding="10,4" Margin="0,0,4,0"
                                           Command="{Binding SetPresetCommand}" CommandParameter="Bu ay"
                                           Appearance="{Binding PeriodPreset, Converter={StaticResource FilterAppearance}, ConverterParameter=Bu ay}" />
                                <ui:Button Content="3 ay" Padding="10,4" Margin="0,0,4,0"
                                           Command="{Binding SetPresetCommand}" CommandParameter="3 ay"
                                           Appearance="{Binding PeriodPreset, Converter={StaticResource FilterAppearance}, ConverterParameter=3 ay}" />
                                <ui:Button Content="{loc:T contactwindow.1-yil}" Padding="10,4" Margin="0,0,12,0"
                                           Command="{Binding SetPresetCommand}" CommandParameter="1 yıl"
                                           Appearance="{Binding PeriodPreset, Converter={StaticResource FilterAppearance}, ConverterParameter=1 yıl}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Text="{Binding Calls.Count, StringFormat='{}{0} görüşme'}" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SortOrder}"
                                          MinWidth="110" Margin="0,0,8,0" VerticalAlignment="Center"
                                          ToolTip="{loc:T contactwindow.siralama}" />

                                <ui:Button Content="{loc:T contactwindow.temizle}" Margin="0,0,8,0" Padding="10,4"
                                           Appearance="Secondary"
                                           Command="{Binding ResetFiltersCommand}"
                                           Visibility="{Binding FiltersActive, Converter={StaticResource BoolToVisibility}}" />

                                <!-- The door to the rare controls, wearing the count of what
                                     is on behind it — an invisible filter is data loss. -->
                                <ToggleButton IsChecked="{Binding FiltersOpen}" Padding="10,4"
                                              ToolTip="{loc:T contactwindow.gelismis-filtreler}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Filter24" FontSize="14" Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:T contactwindow.filtreler}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource CountPill}" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ActiveFilterCount, Converter={StaticResource CountToVisibility}}">
                                            <TextBlock Text="{Binding ActiveFilterCount}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <!-- The investigation drawer: every control labelled, nothing naked. -->
                        <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="6"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding FiltersOpen, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel>
                                <StackPanel Margin="0,0,14,6">
                                    <TextBlock Text="{loc:T contactwindow.tarih-araligi}" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                    <StackPanel Orientation="Horizontal">
                                        <DatePicker SelectedDate="{Binding FilterFrom}" Width="118"
                                                    ToolTip="{loc:T contactwindow.bu-tarihten-itibaren}" />
                                        <TextBlock Text="–" VerticalAlignment="Center" Margin="4,0" />
                                        <DatePicker SelectedDate="{Binding FilterTo}" Width="118"
                                                    ToolTip="{loc:T contactwindow.bu-tarihe-kadar}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="0,0,14,6">
                                    <TextBlock Text="{loc:T contactwindow.durum}" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding StateChoices}" SelectedItem="{Binding StateFilter}"
                                              MinWidth="130" />
                                </StackPanel>

                                <StackPanel Margin="0,0,14,6">
                                    <TextBlock Text="{loc:T contactwindow.etiket}" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding TagChoices}" SelectedItem="{Binding TagFilter}"
                                              MinWidth="120" />
                                </StackPanel>

                                <StackPanel Margin="0,0,14,6">
                                    <TextBlock Text="{loc:T contactwindow.en-az-sure-dk}" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                    <ui:NumberBox Value="{Binding MinMinutes}" Minimum="0" Maximum="600" Width="110" />
                                </StackPanel>

                                <StackPanel Margin="0,0,14,6">
                                    <TextBlock Text="{loc:T contactwindow.not}" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                    <CheckBox Content="{loc:T contactwindow.yalnizca-notlu}" IsChecked="{Binding OnlyNoted}"
                                              VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{loc:T contactwindow.tarihe-git}" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                    <DatePicker x:Name="JumpDate" Width="118"
                                                SelectedDateChanged="JumpDate_Changed"
                                                ToolTip="{loc:T contactwindow.bu-tarihe-en-yakin-gorusmeye-kaydirir-filt}" />
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="CallList"
                             Style="{StaticResource CleanList}" ItemsSource="{Binding CallsView}"
                             MouseDoubleClick="CallRow_DoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasCalls, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource GroupHeader}"
                                                   Margin="4,10,0,2" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,8" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <!-- The same verbs, in the same order, as every other call row. -->
                                        <ContextMenu>
                                            <MenuItem Header="{loc:T contactwindow.gorusmeyi-ac}" Click="RowOpen_Click" FontWeight="SemiBold" />
                                            <MenuItem Header="{loc:T contactwindow.onemlilere-ekle}" Click="RowToBoard_Click" />
                                            <MenuItem Header="{loc:T contactwindow.hatirlat}" Click="RowRemind_Click" />
                                            <Separator />
                                            <MenuItem Header="{loc:T contactwindow.baska-kisiye-tasi}" Click="RowMove_Click" />
                                            <MenuItem Header="{loc:T contactwindow.yeniden-yaziya-cevir}" Click="RowRetranscribe_Click" />
                                            <MenuItem Header="{loc:T contactwindow.yeniden-cozumle}" Click="RowReanalyse_Click" />
                                            <MenuItem Header="{loc:T contactwindow.ses-dosyasinin-yerini-ac}" Click="RowShowInFolder_Click" />
                                            <Separator />
                                            <MenuItem Header="{loc:T contactwindow.gorusmeyi-sil}" Click="RowDelete_Click">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Delete24" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding When}" FontWeight="SemiBold" />

                                            <!-- A note is the one thing here a person wrote, so it
                                                 is worth finding again without opening each call. -->
                                            <ui:SymbolIcon Symbol="Note24" FontSize="13" Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{loc:T contactwindow.bu-gorusmede-notun-var}"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <!--
                                            The detail strip: the same facts in the same order on
                                            every row — lines, analysis, reminder, then the user's
                                            tags. Uniform little cells are what make a list of
                                            mixed states scan like a table instead of prose.
                                        -->
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border CornerRadius="4" Padding="6,1" Margin="0,0,4,0"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="11" Margin="0,0,3,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding LineChip}" Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <Border CornerRadius="4" Padding="6,1" Margin="0,0,4,0"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Lightbulb24" FontSize="11" Margin="0,0,3,0"
                                                                   VerticalAlignment="Center">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnalysed}" Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                    <TextBlock Text="{Binding AnalysisChip}" Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Only when a reminder hangs on this conversation. -->
                                            <Border CornerRadius="4" Padding="6,1" Margin="0,0,4,0"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                    ToolTip="{loc:T contactwindow.bu-gorusmeye-bagli-hatirlatma}"
                                                    Visibility="{Binding HasReminder, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Clock24" FontSize="11" Margin="0,0,3,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    <TextBlock Text="{Binding ReminderChip}" Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding Tags}" Margin="2,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Pill}" Margin="4,0,0,0"
                                                                Background="{Binding Converter={StaticResource TagBrush}}"
                                                                Cursor="Hand" MouseLeftButtonUp="TagPill_Click"
                                                                ToolTip="{loc:T contactwindow.bu-etiketi-tasiyan-gorusmeleri-ara}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="{Binding Converter={StaticResource TagIcon}}"
                                                                               FontSize="11" Foreground="White" Margin="0,0,3,0"
                                                                               VerticalAlignment="Center" />
                                                                <TextBlock Style="{StaticResource PillText}"
                                                                           Foreground="White" Text="{Binding}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding LedgerText}" Margin="12,0"
                                               VerticalAlignment="Center" Style="{StaticResource Caption}"
                                               Visibility="{Binding HasLedger, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Grid.Column="2" Text="{Binding Length}" VerticalAlignment="Center"
                                               FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Style="{StaticResource EmptyState}"
                                Visibility="{Binding HasCalls, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T contactwindow.bu-kisiye-ait-kayitli-gorusme-yok}" />
                    </StackPanel>

                    <!-- History arrives a page at a time. The old silent cap of 200 made
                         everything older simply not exist on screen; this button is the cap
                         made visible and clickable. -->
                    <ui:Button Grid.Row="2" Content="{loc:T contactwindow.daha-eski-gorusmeleri-yukle}"
                               HorizontalAlignment="Center" Margin="0,8,0,4" Padding="14,6"
                               Appearance="Secondary"
                               Command="{Binding LoadMoreCallsCommand}"
                               Visibility="{Binding HasMoreCalls, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ChevronDown24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </TabItem>

            <!-- ================= search within this person ================= -->
            <TabItem Header="{loc:T contactwindow.ara}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        Line-level, and scoped to this person in the query rather than afterwards.

                        The box on the contact page narrows the CALL list — a different question,
                        and the reason this is not simply a second box in the same place.
                    -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{loc:T contactwindow.bu-kisiyle-konusulanlarda-ara}"
                                    KeyDown="Query_KeyDown" />

                        <ui:ToggleSwitch Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                         Content="{loc:T contactwindow.yalnizca-karsi-taraf}"
                                         IsChecked="{Binding OnlyOtherParty}" />

                        <ui:Button Grid.Column="2" Content="{loc:T contactwindow.ara}" Appearance="Primary" Margin="10,0,0,0"
                                   Command="{Binding SearchCommand}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- The verdict line the view model was writing into the void: "12 satır
                             bulundu" / "geçmiyor". A search that answers silently teaches people
                             it did not run. -->
                        <TextBlock Grid.Row="0" Text="{Binding SearchMessage}" Margin="2,0,0,8"
                                   Style="{StaticResource Caption}"
                                   Visibility="{Binding SearchMessage, Converter={StaticResource NullToCollapsed}}" />

                        <Grid Grid.Row="1">
                        <ListBox Style="{StaticResource CleanList}" ItemsSource="{Binding Hits}"
                                 MouseDoubleClick="Hit_DoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasHits, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,7">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold"
                                                       FontSize="{StaticResource TextCaption}" />
                                            <TextBlock Text="{Binding When}" Margin="10,0,0,0"
                                                       FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Style="{StaticResource EmptyState}"
                                    Visibility="{Binding HasHits, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource EmptyTitle}"
                                       Text="{loc:T contactwindow.bu-kisiyle-konusulanlarda-ara-2}" />
                            <TextBlock Style="{StaticResource EmptyBody}" Margin="0,6,0,0"
                                       Text="{loc:T contactwindow.bulunan-satira-cift-tiklayinca-o-gorusme-a}" />
                        </StackPanel>
                    </Grid>
                </Grid>
                </Grid>
            </TabItem>

            <!-- ================= the ledger ================= -->
            <TabItem Header="{loc:T contactwindow.defter}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,10,4">
                    <StackPanel>
                        <!--
                            What was just done to a row here, and the way back.

                            Said in the tab rather than as a toast: a ruling on a promise is the kind of act that
                            must not be one click away with no way back, and for as long as this line is on screen
                            it can be taken back with one.
                        -->
                        <Border Style="{StaticResource SettingCard}" Padding="10,6" Margin="0,0,0,10"
                                Visibility="{Binding LedgerUndo.Notice, Converter={StaticResource NullToCollapsed}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding LedgerUndo.Notice}" Style="{StaticResource Secondary}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <ui:Button Grid.Column="1" Content="{loc:T contactwindow.geri-al}" Appearance="Transparent"
                                           Margin="8,0,0,0" Command="{Binding LedgerUndo.UndoCommand}"
                                           Visibility="{Binding LedgerUndo.CanUndo, Converter={StaticResource BoolToVisibility}}" />

                                <ui:Button Grid.Column="2" Content="✕" Appearance="Transparent" Padding="8,2"
                                           Command="{Binding LedgerUndo.ClearCommand}" />
                            </Grid>
                        </Border>

                        <StackPanel Visibility="{Binding HasLedger, Converter={StaticResource BoolToVisibility}}">
                            <!-- Two owners, two groups — yours first: the obligation you can
                                 act on this minute is your own, and people forget what THEY
                                 promised at least as often as what they were promised. -->
                            <TextBlock Text="{loc:T contactwindow.senin-sozlerin}" Style="{StaticResource GroupHeader}"
                                       Visibility="{Binding MyCommitments.Count, Converter={StaticResource CountToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding MyCommitments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SettingCard}" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                                                                Background="{DynamicResource MeBrush}" VerticalAlignment="Center">
                                                            <TextBlock Text="{loc:T contactwindow.sen}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White" />
                                                        </Border>

                                                        <!-- The user's wording when they gave one, the machine's otherwise;
                                                             the badge says which. -->
                                                        <TextBlock Grid.Column="1" Text="{Binding EffectiveObligation}" TextWrapping="Wrap"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Style="{StaticResource PillText}" Text="{loc:T contactwindow.senin-duzeltmen}" />
                                                        </Border>
                                                    </Grid>

                                                    <Border Style="{StaticResource QuoteBlock}" Margin="0,8,0,0"
                                                            BorderBrush="{DynamicResource MeBrush}">
                                                        <TextBlock Text="{Binding Quote}" TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>

                                                <!--
                                                    The user's verbs, the same ones the ledger page has. Tutuldu is the one thing the
                                                    machine never concludes; ✎ and Ertele open the same dialog; Tutulmadı waits behind ⋯
                                                    because it is rare. Reddet stands 12 px apart — a ruling, not another look.
                                                -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                                    <ui:Button Content="{loc:T contactwindow.tutuldu}" Appearance="Secondary" Padding="10,4"
                                                               ToolTip="{loc:T contactwindow.bu-soz-tutuldu}"
                                                               Command="{Binding DataContext.FulfilCommitmentCommand,
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" />

                                                    <ui:Button Content="✎" Appearance="Transparent" Padding="8,4" Margin="6,0,0,0"
                                                               ToolTip="{loc:T contactwindow.duzenle}" Click="PromiseEdit_Click" />

                                                    <ui:DropDownButton Padding="6,4" Margin="6,0,0,0"
                                                                       ToolTip="{loc:T contactwindow.bu-sozle-ilgili-diger-kararlar}">
                                                        <ui:DropDownButton.Icon>
                                                            <ui:SymbolIcon Symbol="MoreHorizontal24" />
                                                        </ui:DropDownButton.Icon>
                                                        <ui:DropDownButton.Flyout>
                                                            <ContextMenu>
                                                                <MenuItem Header="{loc:T contactwindow.ertele}" Click="PromiseEdit_Click" />
                                                                <MenuItem Header="{loc:T contactwindow.tutulmadi}" Click="PromiseAbandon_Click" />
                                                            </ContextMenu>
                                                        </ui:DropDownButton.Flyout>
                                                    </ui:DropDownButton>

                                                    <ui:Button Content="{loc:T contactwindow.reddet}" Appearance="Transparent" Padding="10,4" Margin="12,0,0,0"
                                                               ToolTip="{loc:T contactwindow.bu-sozu-reddet}"
                                                               Command="{Binding DataContext.DismissCommitmentCommand,
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{loc:T contactwindow.onun-sozleri}" Style="{StaticResource GroupHeader}"
                                       Margin="0,10,0,0"
                                       Visibility="{Binding TheirCommitments.Count, Converter={StaticResource CountToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding TheirCommitments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SettingCard}" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- The user's wording when they gave one, the machine's otherwise;
                                                             the badge says which. -->
                                                        <TextBlock Grid.Column="0" Text="{Binding EffectiveObligation}" TextWrapping="Wrap"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Style="{StaticResource PillText}" Text="{loc:T contactwindow.senin-duzeltmen}" />
                                                        </Border>
                                                    </Grid>

                                                    <Border Style="{StaticResource QuoteBlock}" Margin="0,8,0,0">
                                                        <TextBlock Text="{Binding Quote}" TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>

                                                <!--
                                                    The user's verbs, the same ones the ledger page has. Tutuldu is the one thing the
                                                    machine never concludes; ✎ and Ertele open the same dialog; Tutulmadı waits behind ⋯
                                                    because it is rare. Reddet stands 12 px apart — a ruling, not another look.
                                                -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                                    <ui:Button Content="{loc:T contactwindow.tutuldu}" Appearance="Secondary" Padding="10,4"
                                                               ToolTip="{loc:T contactwindow.bu-soz-tutuldu}"
                                                               Command="{Binding DataContext.FulfilCommitmentCommand,
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" />

                                                    <ui:Button Content="✎" Appearance="Transparent" Padding="8,4" Margin="6,0,0,0"
                                                               ToolTip="{loc:T contactwindow.duzenle}" Click="PromiseEdit_Click" />

                                                    <ui:DropDownButton Padding="6,4" Margin="6,0,0,0"
                                                                       ToolTip="{loc:T contactwindow.bu-sozle-ilgili-diger-kararlar}">
                                                        <ui:DropDownButton.Icon>
                                                            <ui:SymbolIcon Symbol="MoreHorizontal24" />
                                                        </ui:DropDownButton.Icon>
                                                        <ui:DropDownButton.Flyout>
                                                            <ContextMenu>
                                                                <MenuItem Header="{loc:T contactwindow.ertele}" Click="PromiseEdit_Click" />
                                                                <MenuItem Header="{loc:T contactwindow.tutulmadi}" Click="PromiseAbandon_Click" />
                                                            </ContextMenu>
                                                        </ui:DropDownButton.Flyout>
                                                    </ui:DropDownButton>

                                                    <ui:Button Content="{loc:T contactwindow.reddet}" Appearance="Transparent" Padding="10,4" Margin="12,0,0,0"
                                                               ToolTip="{loc:T contactwindow.bu-sozu-reddet}"
                                                               Command="{Binding DataContext.DismissCommitmentCommand,
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The claims were loaded on every open and never drawn — a third
                                 of the ledger invisible, and HasLedger counting rows the tab
                                 could not show. A changed number IS the product's business. -->
                            <TextBlock Text="{loc:T contactwindow.degisen-rakamlar}" Style="{StaticResource GroupHeader}" Margin="0,16,0,0"
                                       Visibility="{Binding Claims.Count, Converter={StaticResource CountToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Claims}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SettingCard}" Padding="14,12">
                                            <StackPanel>
                                                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold">
                                                    <Run Text="{Binding Entity, Mode=OneWay}" /><Run Text=" · " /><Run
                                                        Text="{Binding Attribute, Mode=OneWay}" /><Run Text=": " /><Run
                                                        Text="{Binding Value, Mode=OneWay}" />
                                                </TextBlock>
                                                <Border Style="{StaticResource QuoteBlock}" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding Quote}" TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{loc:T contactwindow.isaretler}" Style="{StaticResource GroupHeader}" Margin="0,16,0,0"
                                       Visibility="{Binding Flags.Count, Converter={StaticResource CountToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Flags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SettingCard}" Padding="14,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                                               FontWeight="SemiBold" />
                                                    <Border Style="{StaticResource QuoteBlock}" Margin="0,8,0,0">
                                                        <TextBlock Text="{Binding Quote}" TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- A wrong finding is turned down here, and is not found again on the next run. -->
                                                <ui:Button Grid.Column="1" Content="{loc:T contactwindow.reddet}" Appearance="Transparent"
                                                           Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Top"
                                                           ToolTip="{loc:T contactwindow.bu-bulguyu-reddet}"
                                                           Command="{Binding DataContext.DismissFlagCommand,
                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Style="{StaticResource EmptyState}"
                                    Visibility="{Binding HasLedger, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T contactwindow.defter-bos}" />
                            <TextBlock Style="{StaticResource EmptyBody}" Margin="0,6,0,0"
                                       Text="{loc:T contactwindow.sozler-degisen-rakamlar-ve-isaretler-cozum}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= notes about the person ================= -->
            <TabItem Header="{loc:T contactwindow.notlar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        About the person, not about a call.

                        Everything else this archive holds was produced by a machine and is replaced
                        whenever a conversation is analysed again. This is the one part somebody
                        wrote, and it survives every reprocess, rename and merge.
                    -->
                    <TextBlock Grid.Row="0" Style="{StaticResource Caption}" Margin="0,0,0,10"
                               Text="{loc:T contactwindow.bu-kisi-hakkinda-kendi-notun-gorusme-notla}" />

                    <ui:TextBox Grid.Row="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True" TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                VerticalScrollBarVisibility="Auto"
                                PlaceholderText="{loc:T contactwindow.bu-kisiyle-ilgili-hatirlamak-istediklerin}" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <TextBlock Text="{loc:T contactwindow.kaydedildi}" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Visibility="{Binding NoteSaved, Converter={StaticResource BoolToVisibility}}" />

                        <ui:Button Content="{loc:T contactwindow.notu-kaydet}" Appearance="Primary"
                                   Command="{Binding SaveNoteCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ================= the profile ================= -->
            <TabItem Header="{loc:T contactwindow.hakkinda}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                        <!-- The rule, stated where it applies. -->
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Text="{loc:T contactwindow.bu-bilgileri-sen-girersin-uygulama-kisiler}" />

                        <TextBlock Text="{loc:T contactwindow.fotograf}" Style="{StaticResource GroupHeader}" />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,18">
                            <Grid Margin="0,0,14,0">
                                <Border Style="{StaticResource Avatar}" Width="72" Height="72" CornerRadius="36"
                                        Background="{Binding Name, Converter={StaticResource NameBrush}}"
                                        Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Style="{StaticResource AvatarText}" FontSize="24"
                                               Text="{Binding Name, Converter={StaticResource Initials}}" />
                                </Border>
                                <Border Width="72" Height="72" CornerRadius="36"
                                        Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding PhotoPath, Converter={StaticResource Photo}}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="{loc:T contactwindow.fotograf-sec}" Click="PickPhoto_Click" />
                                    <ui:Button Content="{loc:T contactwindow.kaldir}" Margin="8,0,0,0" Appearance="Secondary"
                                               Command="{Binding RemovePhotoCommand}"
                                               Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="{loc:T contactwindow.dosya-arsive-kopyalanir-ve-kucultulur-konu}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{loc:T contactwindow.dogum-tarihi}" Style="{StaticResource GroupHeader}" />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,18">
                            <DatePicker SelectedDate="{Binding BirthDatePick}" Width="160" />
                            <TextBlock Text="{Binding BirthdayLine}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{loc:T contactwindow.bilgiler}" Style="{StaticResource GroupHeader}" />

                        <ItemsControl ItemsSource="{Binding Fields}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HoverCard}" Padding="12,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />

                                            <ui:Button Grid.Column="2" Appearance="Transparent" Padding="6,4"
                                                       ToolTip="{loc:T contactwindow.bu-bilgiyi-sil}" Click="RemoveField_Click">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="{loc:T contactwindow.henuz-bilgi-yok-etiket-ve-deger-yazip-ekle}"
                                   Visibility="{Binding HasFields, Converter={StaticResource InverseBoolToVisibility}}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0" PlaceholderText="{loc:T contactwindow.etiket-label}"
                                        Text="{Binding NewFieldLabel, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:TextBox Grid.Column="1" PlaceholderText="{loc:T contactwindow.deger}" Margin="8,0"
                                        Text="{Binding NewFieldValue, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="2" Content="{loc:T contactwindow.ekle}" Appearance="Primary"
                                       Command="{Binding AddFieldCommand}" />
                        </Grid>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,20" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Text="{Binding ProfileMessage}"
                                   Visibility="{Binding ProfileMessage, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- In-window dialog layer: Dialogs.ConfirmAsync/InfoAsync present here, over
             everything, instead of the Win32-gray MessageBox. -->
        <ContentPresenter x:Name="DialogHost" Grid.RowSpan="99" Grid.ColumnSpan="99"
                          Panel.ZIndex="9999" />
    </Grid>
</ui:FluentWindow>