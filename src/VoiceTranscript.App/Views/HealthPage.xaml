<UserControl x:Class="VoiceTranscript.App.Views.HealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
             xmlns:views="clr-namespace:VoiceTranscript.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HealthViewModel}">

    <!--
        Two tabs rather than two entries in the menu.

        "İşlem durumu" and "Durum" sat next to each other in the navigation and both meant status,
        which is a distinction the user has to hold in their head rather than read. They are the
        same question at two levels — is the machinery set up, and is it getting through the work —
        so they belong on one screen with a tab between them.
    -->
    <TabControl Margin="24,8,24,16" Padding="0,12,0,0" BorderThickness="0" Background="Transparent">

        <TabItem Header="Sistem">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,8,24">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="{loc:T healthpage.durum}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{loc:T healthpage.bir-kaydedici-basariya-benzeyen-sekillerde}" />

            <!-- Summary -->
            <Border Style="{StaticResource HeroCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" FontSize="28" Margin="0,0,18,0" VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Warning24" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                        <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" FontSize="{StaticResource TextSubtitle}"
                                   Text="{Binding ProblemCount, Converter={StaticResource HealthHeadline}}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                                   Text="{loc:T healthpage.bu-sayfanin-ekran-goruntusu-yardim-isterke}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,12,0"
                                         Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />

                        <ui:Button Content="{loc:T healthpage.hepsini-denetle}" Appearance="Primary"
                                   Command="{Binding RefreshCommand}"
                                   IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBool}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Checks -->
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SettingCard}" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="26" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:SymbolIcon Symbol="{Binding StateIcon}" FontSize="20"
                                                   Foreground="{Binding StateBrushKey, Converter={StaticResource BrushFromKey}}"
                                                   Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>

                                <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Icon}" FontSize="18"
                                               Margin="0,0,14,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               FontSize="{StaticResource TextBody}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <ui:Button Grid.Column="3" Content="{Binding ActionLabel}" Margin="14,0,0,0"
                                           MinWidth="132" VerticalAlignment="Center"
                                           Command="{Binding DataContext.RunItemCommand,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}"
                                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                           Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Hardware -->
            <TextBlock Text="{loc:T healthpage.donanim}" Style="{StaticResource GroupHeader}" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,10"
                       Text="{loc:T healthpage.bu-makinenin-ne-kadar-hizli-oldugu-teknik}" />

            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T healthpage.donanim-olcumu}" FontSize="{StaticResource TextBody}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="{loc:T healthpage.kisa-bir-ornek-yaziya-dokulur-ve-gercek-za}" />
                    </StackPanel>

                    <ui:Button Grid.Column="1" Content="{loc:T healthpage.olc}" MinWidth="110" VerticalAlignment="Center"
                               Command="{Binding MeasureHardwareCommand}"
                               IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBool}}" />
                </Grid>
            </Border>

            <!--
                Data ownership.

                A product that keeps years of somebody's conversations owes them a way to take
                those conversations elsewhere. The export is deliberately plain markdown: the
                honest answer to "what if you stop working on this" has to be "it is a folder of
                text files you can read in anything".
            -->
            <TextBlock Text="{loc:T healthpage.veriler}" Style="{StaticResource GroupHeader}" />

            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Save24" FontSize="18" Margin="0,0,14,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T healthpage.yedekle}" FontSize="{StaticResource TextBody}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="{loc:T healthpage.veritabani-ve-ayarlar-tek-dosyada-ses-kayi}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="{loc:T healthpage.yedekle}" MinWidth="96" Margin="0,0,6,0"
                                   Command="{Binding BackupCommand}"
                                   IsEnabled="{Binding IsArchiving, Converter={StaticResource InverseBool}}" />
                        <ui:Button Content="{loc:T healthpage.sesle-birlikte}" MinWidth="120"
                                   Command="{Binding BackupWithAudioCommand}"
                                   IsEnabled="{Binding IsArchiving, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="DocumentText24" FontSize="18" Margin="0,0,14,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T healthpage.her-seyi-disa-aktar}" FontSize="{StaticResource TextBody}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="{loc:T healthpage.butun-gorusmeler-duz-markdown-olarak-kisi}" />
                    </StackPanel>

                    <ui:Button Grid.Column="2" Content="{loc:T healthpage.disa-aktar}" MinWidth="120" Margin="14,0,0,0"
                               Command="{Binding ExportEverythingCommand}"
                               IsEnabled="{Binding IsArchiving, Converter={StaticResource InverseBool}}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="ArrowCounterclockwise24" FontSize="18" Margin="0,0,14,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T healthpage.yedekten-geri-yukle}" FontSize="{StaticResource TextBody}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="{loc:T healthpage.hazirlanir-ve-uygulama-yeniden-baslatildig}" />
                    </StackPanel>

                    <ui:Button Grid.Column="2" Content="{loc:T healthpage.geri-yukle}" MinWidth="120" Margin="14,0,0,0"
                               Command="{Binding RestoreCommand}"
                               IsEnabled="{Binding IsArchiving, Converter={StaticResource InverseBool}}" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                        Visibility="{Binding DataMessage, Converter={StaticResource NullToCollapsed}}">
                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsArchiving, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding DataMessage}" Style="{StaticResource Secondary}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Style="{StaticResource HeroCard}" Margin="0,8,0,0"
                    Visibility="{Binding HardwareReport, Converter={StaticResource NullToCollapsed}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource StatValue}"
                                       Text="{Binding HardwareReport.GpuVramGb, StringFormat='{}{0:0.#} GB', FallbackValue='—'}" />
                            <TextBlock Style="{StaticResource StatLabel}"
                                       Text="{Binding HardwareReport.GpuName, FallbackValue='ekran kartı yok'}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource StatValue}"
                                       Text="{Binding HardwareReport.MeasuredSpeedFactor, StringFormat='{}{0:0.#}x', FallbackValue='—'}" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="{loc:T healthpage.gercek-zamana-gore-hiz}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource StatValue}"
                                       Text="{Binding HardwareReport.HourlyCallCost.TotalMinutes, StringFormat='{}{0:0} dk', FallbackValue='—'}" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="{loc:T healthpage.60-dakikalik-arama-icin}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding HardwareReport.Verdict}" Style="{StaticResource Secondary}"
                               Margin="0,14,0,0" />

                    <ui:Button Content="{loc:T healthpage.raporu-kopyala}" Appearance="Transparent" Margin="0,10,0,0"
                               HorizontalAlignment="Left" Click="CopyReport_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Copy24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Border>

            <!--
                The log.

                This application is developed on one machine and used on another, and the used
                one is the only place real calls, real capture and a real graphics card exist.
                So the file this card hands over is the entire diagnostic channel between the
                two, and it is worth a card of its own rather than a line in a menu.

                What it does not contain is stated where the decision to send it is made, not
                buried in a privacy page. Somebody about to send a file from an application that
                records their conversations is owed that sentence at that moment.
            -->
            <TextBlock Text="{loc:T healthpage.gunluk}" Style="{StaticResource GroupHeader}" />

            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T healthpage.ne-oldugunun-kaydi}" FontSize="{StaticResource TextBody}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="{loc:T healthpage.bir-sey-ters-gittiginde-son-uc-gunun-gunlu}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="{loc:T healthpage.gunlugu-kopyala}" MinWidth="140" Margin="14,0,6,0"
                                       Click="CopyLog_Click" />
                            <ui:Button Content="{loc:T healthpage.klasoru-ac}" MinWidth="110"
                                       Click="OpenLogFolder_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!--
            The processing list, reaching past its own DataContext.

            This page is given a HealthViewModel; the list needs the ProcessingViewModel the shell
            holds. Binding through the window rather than restructuring the shell keeps one owner
            for it, so the counts stay correct wherever it is shown from.
        -->
        <TabItem Header="İşlemler">
            <views:ProcessingPage
                DataContext="{Binding DataContext.Processing, RelativeSource={RelativeSource AncestorType=Window}}" />
        </TabItem>
    </TabControl>
</UserControl>
