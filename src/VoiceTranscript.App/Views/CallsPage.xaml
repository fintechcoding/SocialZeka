<UserControl x:Class="VoiceTranscript.App.Views.CallsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CallsViewModel}">

    <UserControl.Resources>
        <!-- The same row as the first screen: who, when, what state, what tags, which app, how
             long — and the same eight verbs behind the right click. -->
        <DataTemplate x:Key="CallRowTemplate" DataType="{x:Type vm:RecentCall}">
            <Border Style="{StaticResource HoverCard}" Cursor="Hand" MouseLeftButtonUp="Row_Click"
                    ToolTip="{loc:T callspage.gorusmeyi-ac}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:T callspage.gorusmeyi-ac}" Click="Open_Click" FontWeight="SemiBold" />
                        <MenuItem Header="{loc:T callspage.kim-oldugunu-soyle}" Click="Label_Click"
                                  Visibility="{Binding NeedsLabel, Converter={StaticResource BoolToVisibility}}" />
                        <MenuItem Header="{loc:T callspage.onemlilere-ekle}" Click="ToBoard_Click" />
                        <MenuItem Header="{loc:T callspage.hatirlat}" Click="Remind_Click" />
                        <Separator />
                        <MenuItem Header="{loc:T callspage.baska-kisiye-tasi}" Click="Move_Click" />
                        <MenuItem Header="{loc:T callspage.yeniden-yaziya-dok}" Click="Retranscribe_Click"
                                  IsEnabled="{Binding CanRetranscribe}" />
                        <MenuItem Header="{loc:T callspage.yeniden-cozumle}" Click="Reanalyse_Click"
                                  IsEnabled="{Binding CanReanalyse}" />
                        <MenuItem Header="{loc:T callspage.ses-dosyasinin-yerini-ac}" Click="ShowInFolder_Click"
                                  IsEnabled="{Binding HasAudio}" />
                        <Separator />
                        <MenuItem Header="{loc:T callspage.gorusmeyi-sil}" Click="Delete_Click" IsEnabled="{Binding CanDelete}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,14,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Avatar}">
                                <Setter Property="Background" Value="{Binding ContactName, Converter={StaticResource NameBrush}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsLabel}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AvatarText}">
                                    <Setter Property="Text" Value="{Binding ContactName, Converter={StaticResource Initials}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedsLabel}" Value="True">
                                            <Setter Property="Text" Value="?" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{StaticResource TextBody}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Call.StartedAt, Converter={StaticResource RelativeDate}}" />
                            <TextBlock Style="{StaticResource Caption}" Text=" · "
                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Status}" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding FailureLine}"
                                   Visibility="{Binding HasFailureLine, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center"
                                      Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,0"
                                            Background="{Binding Converter={StaticResource TagBrush}}">
                                        <TextBlock Style="{StaticResource PillText}" Foreground="White" Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Text="{loc:T callspage.ses-yok}"
                                   Visibility="{Binding AudioGone, Converter={StaticResource BoolToVisibility}}" />
                        <Border Style="{StaticResource Pill}" Visibility="{Binding HasApp, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource PillText}" Text="{Binding AppName}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="{Binding Length}" VerticalAlignment="Center" MinWidth="44" TextAlignment="Right"
                               FontFamily="Consolas, Cascadia Mono, Segoe UI" FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PadPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:T callspage.gorusmeler}" Style="{StaticResource PageTitle}" />
            <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
        </Grid>

        <!-- Whatever the user knows about the call they want: who, when, which app, what
             state, which tag. Each narrows the list at once; nothing to submit. -->
        <WrapPanel Grid.Row="1" Margin="0,8,0,10">
            <ComboBox ItemsSource="{Binding ContactChoices}" SelectedItem="{Binding SelectedContact}" DisplayMemberPath="Name"
                      MinWidth="170" Margin="0,0,8,6" />
            <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" MinWidth="130" Margin="0,0,8,6">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource PeriodName}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox ItemsSource="{Binding AppChoices}" SelectedItem="{Binding AppChoice}" MinWidth="110" Margin="0,0,8,6" />
            <ComboBox ItemsSource="{Binding StateChoices}" SelectedItem="{Binding StateChoice}" MinWidth="150" Margin="0,0,8,6" />
            <ComboBox ItemsSource="{Binding TagChoices}" SelectedItem="{Binding TagChoice}" MinWidth="120" Margin="0,0,8,6" />
            <ui:TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" Margin="0,0,8,6"
                        PlaceholderText="{loc:T callspage.kisi-adi}" Icon="{ui:SymbolIcon Search24}" />
            <ui:Button Content="{loc:T callspage.temizle}" Appearance="Transparent" Margin="0,0,0,6" Click="Clear_Click"
                       Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T callspage.gorusme-yok}" />
                    <TextBlock Style="{StaticResource EmptyBody}" Text="{loc:T callspage.gorusme-yok-aciklama}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CallDayGroup}">
                            <StackPanel Margin="0,0,0,10">
                                <Grid Margin="4,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Day}" Style="{StaticResource GroupHeader}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Calls}" ItemTemplate="{StaticResource CallRowTemplate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
