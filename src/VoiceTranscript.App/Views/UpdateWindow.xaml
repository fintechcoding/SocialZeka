<ui:FluentWindow x:Class="VoiceTranscript.App.Views.UpdateWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{loc:T updatewindow.yeni-surum}"
                 Width="520" SizeToContent="Height"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <StackPanel Margin="0,0,0,16">
        <ui:TitleBar Title="{loc:T updatewindow.yeni-surum}" />

        <StackPanel Margin="20,8,20,0">
            <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

            <TextBlock x:Name="SizeText" Margin="0,4,0,0" Style="{StaticResource Caption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- What changed, straight from the release. Nobody should agree to replace a
                 program without being told what is in it. -->
            <TextBlock Text="{loc:T updatewindow.degisenler}" Margin="0,16,0,6" FontWeight="SemiBold" />

            <Border BorderThickness="1" CornerRadius="4"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    Padding="12" MaxHeight="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                               Style="{StaticResource Secondary}" />
                </ScrollViewer>
            </Border>

            <!-- Shown only when something makes now a bad moment. The application says what it is
                 doing rather than greying a button out for reasons the user cannot see. -->
            <Border x:Name="BlockedPanel" Visibility="Collapsed" Margin="0,14,0,0"
                    Padding="12" CornerRadius="4"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning24" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="BlockedText" TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock x:Name="ProgressText" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="1" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button x:Name="SkipButton" Content="{loc:T updatewindow.bu-surumu-atla}" Margin="0,0,8,0" Click="Skip_Click" />
                <ui:Button x:Name="LaterButton" Content="{loc:T updatewindow.sonra}" Margin="0,0,8,0" Click="Later_Click" IsCancel="True" />
                <ui:Button x:Name="UpdateButton" Content="{loc:T updatewindow.simdi-guncelle}" Appearance="Primary" Click="Update_Click" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
