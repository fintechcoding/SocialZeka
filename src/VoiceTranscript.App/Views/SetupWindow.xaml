<ui:FluentWindow x:Class="VoiceTranscript.App.Views.SetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:SetupViewModel}"
                 Title="{loc:T setupwindow.kurulum}"
                 Width="880" Height="760"
                 MinWidth="760" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:T setupwindow.voicetranscript-kurulumu}" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/VoiceTranscript;component/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Header -->
        <StackPanel Grid.Row="1" Margin="32,4,32,16">
            <TextBlock Text="{loc:T setupwindow.hazirlaniyor}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,0"
                       Text="{loc:T setupwindow.voicetranscript-whatsapp-ve-telegram-gorus}" />
        </StackPanel>

        <!--
            One card per prerequisite, in the order they depend on each other.

            Each row carries its own spinner and its own line of progress. That is not decoration:
            the previous version put a single progress panel below the list, where on a smaller
            window it fell under the fold — so pressing "Kur" greyed out a button and then nothing
            visible happened for four minutes. Progress has to appear where the click was.
        -->
        <ScrollViewer Grid.Row="2" Padding="32,0,32,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SettingCard}" Padding="16,14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- State: a ring while it works, a verdict when it stops. -->
                                    <Grid Grid.Column="0" Width="26" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:SymbolIcon Symbol="{Binding Glyph}" FontSize="20"
                                                       Foreground="{Binding StateBrush}"
                                                       Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </Grid>

                                    <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Icon}" FontSize="18"
                                                   Margin="0,0,14,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   FontSize="{StaticResource TextBody}" />

                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}"
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />

                                        <TextBlock Text="{Binding Activity}" Margin="0,3,0,0"
                                                   FontSize="{StaticResource TextSecondary}"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="3" Content="{Binding ActionLabel}" Margin="14,0,0,0"
                                               MinWidth="104" VerticalAlignment="Center"
                                               Command="{Binding DataContext.RunStepCommand,
                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               IsEnabled="{Binding DataContext.IsIdle,
                                                           RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:InfoBar Margin="0,8,0,0"
                            Title="{loc:T setupwindow.bu-adim-tamamlanamadi}"
                            Message="{Binding Problem}"
                            Severity="Warning"
                            IsClosable="True"
                            IsOpen="{Binding Problem, Converter={StaticResource NullToBool}, Mode=OneWay}" />

                <!-- The measured hardware verdict, once there is one. -->
                <Border Style="{StaticResource HeroCard}" Margin="0,12,0,0"
                        Visibility="{Binding HardwareReport, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="18" Margin="0,0,10,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{loc:T setupwindow.donanim-raporu}" FontWeight="SemiBold"
                                       FontSize="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource StatValue}"
                                           Text="{Binding HardwareReport.GpuVramGb, StringFormat='{}{0:0.#} GB', FallbackValue='—'}" />
                                <TextBlock Style="{StaticResource StatLabel}" Text="{Binding HardwareReport.GpuName, FallbackValue='ekran kartı yok'}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource StatValue}"
                                           Text="{Binding HardwareReport.MeasuredSpeedFactor, StringFormat='{}{0:0.#}x', FallbackValue='—'}" />
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:T setupwindow.gercek-zamana-gore-hiz}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource StatValue}"
                                           Text="{Binding HardwareReport.HourlyCallCost.TotalMinutes, StringFormat='{}{0:0} dk', FallbackValue='—'}" />
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:T setupwindow.60-dakikalik-arama-icin}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding HardwareReport.Verdict}" Style="{StaticResource Secondary}"
                                   Margin="0,14,0,0" />

                        <ui:Button Content="{loc:T setupwindow.raporu-kopyala}" Appearance="Transparent" Margin="0,10,0,0"
                                   HorizontalAlignment="Left" Click="CopyReport_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Border>

                <!--
                    The cloud route needs none of the above. Said here rather than letting somebody
                    without a GPU conclude the application will not work for them and give up.
                -->
                <ui:CardExpander Margin="0,12,0,0" Icon="{ui:SymbolIcon Cloud24}"
                                 Header="{loc:T setupwindow.hicbirini-kurmadan-da-kullanabilirsin}">
                    <TextBlock Style="{StaticResource Secondary}"
                               Text="{loc:T setupwindow.yaziya-dokmeyi-bir-api-uzerinden-yaptirirs}" />
                </ui:CardExpander>

                <!-- The log. Collapsed by default; opened when somebody wants to see the detail. -->
                <ui:CardExpander Margin="0,8,0,0" Icon="{ui:SymbolIcon TextBulletListLtr24}"
                                 Header="{loc:T setupwindow.ayrintili-gunluk}">
                    <ItemsControl ItemsSource="{Binding Log}" MaxHeight="240">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}"
                                           FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                           TextWrapping="Wrap" Margin="0,0,0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>

        <!--
            Always-visible activity strip.

            Pinned above the buttons rather than inside the scrolling list, so that what the
            machine is doing right now can never scroll out of sight.
        -->
        <Border Grid.Row="3" Padding="32,12" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,12,0" />
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding BusyTitle, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" — " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Run Text="{Binding LastMessage, Mode=OneWay}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Padding="32,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button Content="{loc:T setupwindow.bastan-calistir}" Appearance="Transparent"
                               IsEnabled="{Binding IsIdle}" Command="{Binding RunAllCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="{loc:T setupwindow.simdilik-atla}" Margin="0,0,8,0" Click="Skip_Click" />
                    <ui:Button Content="{loc:T setupwindow.bitir}" Appearance="Primary" MinWidth="104" Click="Finish_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
