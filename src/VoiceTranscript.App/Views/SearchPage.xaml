<UserControl x:Class="VoiceTranscript.App.Views.SearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SearchViewModel}">

    <Grid Margin="{StaticResource PadPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:T searchpage.arama}" Style="{StaticResource PageTitle}" />

        <!--
            Turkish search needs its own normalisation.

            The default Unicode folding gets İ/ı wrong, so "ışık" would not find "IŞIK" — and it
            would not report an error either, just no rows, which reads as "nothing was said about
            that". The index is built over a Turkish-folded shadow column and the query goes
            through the same rules, so the two always agree.
        -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" PlaceholderText="{loc:T searchpage.butun-gorusmelerde-ara}"
                        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="{StaticResource TextBody}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!--
                    Clearing was written and had no button.

                    It matters more here than on an ordinary search box: results stay on screen
                    until they are replaced, so a page left showing what somebody searched for is
                    a page showing part of a conversation to whoever walks past. Emptying the box
                    should empty the screen, and until now it could not.
                -->
                <ui:Button Content="{loc:T searchpage.temizle}" Margin="8,0,0,0" MinWidth="90"
                           Command="{Binding ClearCommand}"
                           ToolTip="{loc:T searchpage.aramayi-ve-sonuclari-temizler}"
                           Visibility="{Binding HasSearched, Converter={StaticResource BoolToVisibility}}" />

                <ui:Button Content="{loc:T searchpage.ara}" Appearance="Primary" MinWidth="96"
                           Margin="8,0,0,0" Command="{Binding SearchCommand}" />
            </StackPanel>
        </Grid>

        <!--
            Filters.

            Three, and each one answers a question people really ask: who, when, and which side
            said it. The last is only possible because the two streams were recorded separately —
            on a single mixed recording "only what they said" would be a guess.
        -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <ComboBox ItemsSource="{Binding ContactChoices}" SelectedItem="{Binding SelectedContact}"
                      DisplayMemberPath="Name" MinWidth="180" VerticalAlignment="Center"
                      ToolTip="{loc:T searchpage.yalnizca-bu-kisiyle-olan-gorusmelerde-ara}" />

            <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}"
                      MinWidth="150" Margin="8,0,0,0" VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource PeriodName}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- The labels the user put on conversations, as a filter: "işaretlediklerimin
                 içinde ara" was impossible archive-wide until this box existed. -->
            <CheckBox Content="{loc:T searchpage.yalnizca-karsi-taraf}" Margin="16,0,0,0"
                      IsChecked="{Binding OnlyOtherParty}" VerticalAlignment="Center"
                      ToolTip="{loc:T searchpage.kimin-ne-soyledigi-tahmin-degil-iki-akis-a}" />

            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="20,0,0,0"
                       Visibility="{Binding HasSearched, Converter={StaticResource BoolToVisibility}}"
                       Text="{Binding ResultCount, StringFormat='{}{0} sonuç'}" />
        </StackPanel>

        <!--
            The tag vocabulary, spread out where it can be seen — Outlook's category strip, as a
            query surface. One click narrows to a tag; with no words typed, the tag IS the query
            and every conversation wearing it lists below. A dropdown held the same power and hid
            it behind a click; a screen for asking questions should show its own axes.
        -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding TagChips}" Margin="0,0,0,14"
                      Visibility="{Binding TagChips.Count, Converter={StaticResource CountToVisibility}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.SetTagCommand,
                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Tag}"
                            Cursor="Hand" Margin="0,0,6,6" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="{loc:T searchpage.bu-etiketi-tasiyan-gorusmeleri-listeler-ik}">
                        <Border Style="{StaticResource Pill}"
                                Background="{Binding Tag, Converter={StaticResource TagBrush}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{Binding Tag, Converter={StaticResource TagIcon}}"
                                               FontSize="12" Foreground="White" Margin="0,0,4,0"
                                               VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource PillText}" Foreground="White"
                                           Text="{Binding Label}" VerticalAlignment="Center" />
                                <!-- The active chip says so with a check, not just a hue shift. -->
                                <TextBlock Text=" ✓" Foreground="White" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
            Results.

            One list, not two nested ones. The headings and the lines under them used to be an
            ItemsControl inside an ItemsControl inside a ScrollViewer, and nothing in that stack
            could virtualise: an ItemsControl has no scrolling panel of its own, so it was
            measured with unlimited height and built a visual tree for every hit the query
            returned. The archive grows by about nine conversations a day and a common word
            already reaches the five hundred the query is capped at, so pressing Enter meant
            waiting for five hundred cards to be constructed before seeing the first one.

            Laid end to end — heading, its lines, next heading — the same rows fit a ListBox,
            which does have a scrolling panel and builds only what is on screen. Nothing about
            what a result looks like or which person it sits under changed; the gap above a
            heading, which used to be the group box's own margin, is now the heading's.
        -->
        <ListBox Grid.Row="4" Style="{StaticResource CleanList}" ItemsSource="{Binding Rows}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 Visibility="{Binding Groups.Count, Converter={StaticResource CountToVisibility}}">

            <!--
                The rows carry their own surfaces — a heading, or a HoverCard — so the container
                is nothing at all. CleanList's own row chrome would draw a second hover behind
                every card and pad it away from the one beside it.
            -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.Resources>
                <!-- One person's heading: initials, name, how many of their lines matched. -->
                <DataTemplate DataType="{x:Type vm:SearchGroup}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Margin" Value="0,18,0,8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Style="{StaticResource Avatar}" Width="26" Height="26" CornerRadius="13"
                                Margin="0,0,10,0"
                                Background="{Binding ContactName, Converter={StaticResource NameBrush}}">
                            <TextBlock Style="{StaticResource AvatarText}" FontSize="11"
                                       Text="{Binding ContactName, Converter={StaticResource Initials}}" />
                        </Border>
                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>

                <!-- One matched line. -->
                <DataTemplate DataType="{x:Type vm:SearchResult}">
                    <Border Style="{StaticResource HoverCard}" Padding="14,12"
                            ToolTip="{loc:T searchpage.gorusmeyi-bu-andan-ac}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.OpenCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}" />
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,1,12,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ThemBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource MeBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <StackPanel Grid.Column="1" Width="76" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Who}" FontWeight="SemiBold"
                                           FontSize="{StaticResource TextSecondary}" />
                                <TextBlock Text="{Binding Timestamp}"
                                           Style="{StaticResource TimeLink}" Margin="0,2,0,0" />
                            </StackPanel>

                            <!--
                                Match highlighted in place.

                                Without it every row is a paragraph of similar-looking text and
                                the eye has to read all of them to find the one word it came for.
                            -->
                            <TextBlock Grid.Column="2" TextWrapping="Wrap"
                                       FontSize="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding Before, Mode=OneWay}" />
                                <Run Text="{Binding Match, Mode=OneWay}" FontWeight="Bold"
                                     Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                                <Run Text="{Binding After, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Grid.Column="3" Text="{Binding When}"
                                       Style="{StaticResource Caption}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>

        <!-- Nothing found, or nothing searched for yet. -->
        <StackPanel Grid.Row="4" Style="{StaticResource EmptyState}"
                    Visibility="{Binding Groups.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
            <ui:SymbolIcon Symbol="Search24" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,16"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <TextBlock Style="{StaticResource EmptyTitle}"
                       Text="{Binding HasSearched, Converter={StaticResource SearchEmptyTitle}}" />

            <TextBlock Style="{StaticResource EmptyBody}" Text="{Binding Message}"
                       Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />

            <TextBlock Style="{StaticResource EmptyBody}"
                       Visibility="{Binding HasSearched, Converter={StaticResource InverseBoolToVisibility}}"
                       Text="{loc:T searchpage.butun-gorusmelerin-metni-aranir-turkce-buy}" />
        </StackPanel>
    </Grid>
</UserControl>
