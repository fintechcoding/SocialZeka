<ui:FluentWindow x:Class="VoiceTranscript.App.Views.ReprocessWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{loc:T reprocesswindow.yeniden-isle}"
                 Width="620" Height="560" MinWidth="520" MinHeight="440"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="{loc:T reprocesswindow.yeniden-isle}" />

        <StackPanel Grid.Row="1" Margin="20,8,20,12">
            <TextBlock x:Name="Subject" FontWeight="SemiBold" FontSize="{StaticResource TextBody}" />

            <!--
                One purpose per dialog now. The two-mode version put "hangi yarı?" back on the
                user every single time, when the button they had just pressed already answered
                it — "Yeniden çevir" opens engines, "Çözümle" opens models, and neither asks.
            -->
            <TextBlock x:Name="Reassurance" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="{loc:T reprocesswindow.ses-diskte-duruyor-yalnizca-bu-asama-basta}" />

            <!-- Whether the service this list depends on is actually answering, and — where the
                 provider exposes it — how much credit is left. Asked when the dialog opens,
                 because "seç, bekle, patla" is the flow this line exists to prevent. -->
            <StackPanel x:Name="ServiceLine" Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="Collapsed">
                <ui:SymbolIcon x:Name="ServiceIcon" Symbol="PlugConnected24" FontSize="14"
                               Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ServiceText" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ListHeading" Grid.Column="0" Style="{StaticResource GroupHeader}"
                           VerticalAlignment="Center" />

                <!-- Where the list gets long, the choice that matters most — does the audio stay
                     here — becomes a filter instead of a scroll. The settings row survives every
                     filter, so the default is never out of sight. -->
                <StackPanel x:Name="ScopeBar" Grid.Column="1" Orientation="Horizontal"
                            Visibility="Collapsed">
                    <ui:Button x:Name="ScopeAllButton" Content="{loc:T reprocesswindow.tumu}" Padding="10,4" Margin="0,0,6,0"
                               Appearance="Primary" Tag="All" Click="Scope_Click" />
                    <ui:Button x:Name="ScopeLocalButton" Content="{loc:T reprocesswindow.bu-makinede}" Padding="10,4" Margin="0,0,6,0"
                               Appearance="Secondary" Tag="Local" Click="Scope_Click" />
                    <ui:Button x:Name="ScopeCloudButton" Content="{loc:T reprocesswindow.bulut}" Padding="10,4"
                               Appearance="Secondary" Tag="Cloud" Click="Scope_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Margin="20,0,20,0" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ListBox x:Name="Methods" Style="{StaticResource CleanList}"
                     BorderThickness="0" Background="Transparent"
                     MouseDoubleClick="Methods_DoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!--
                    Split by where the audio goes, because that is the part of this choice that
                    cannot be undone. Speed and cost are recoverable mistakes; sending a private
                    conversation to a hosted service is not, and it should never be something a
                    person discovers afterwards from a row they skimmed.
                -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource GroupHeader}"
                                           Margin="6,12,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon}" FontSize="18"
                                           Margin="0,0,14,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />

                                    <!-- Said on the row rather than in a help page: this is the
                                         moment the decision is actually being made. -->
                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding SendsDataOffMachine, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource PillText}" Text="{Binding OffMachineLabel}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Speed}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource Caption}"
                                       FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="20,14,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Hint" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Style="{StaticResource Caption}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="{loc:T reprocesswindow.vazgec}" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
                <ui:Button x:Name="StartButton" Content="{loc:T reprocesswindow.yeniden-isle}" Appearance="Primary" Click="Start_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
