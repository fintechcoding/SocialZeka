<ui:FluentWindow x:Class="VoiceTranscript.App.Views.ReprocessWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Yeniden işle"
                 Width="620" Height="560" MinWidth="520" MinHeight="440"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Yeniden işle" />

        <StackPanel Grid.Row="1" Margin="20,8,20,12">
            <TextBlock x:Name="Subject" FontWeight="SemiBold" FontSize="{StaticResource TextBody}" />

            <!--
                Which engine, chosen per attempt.

                A recording that failed on one route is exactly the one somebody wants to try on
                another: the local model when an upload keeps breaking, a hosted one when the
                processor would take four hours. Retrying could previously only repeat the route
                that had already failed — the button was least useful exactly when it was needed.
            -->
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Ses diskte duruyor; yalnızca seçtiğin aşama baştan üretilir. Kişi ve notların korunur." />

            <!--
                Which half to redo.

                Transcription is the expensive one — hours on a machine with no usable GPU — and it
                is usually the one that does not need repeating. Somebody who connects a model
                after the fact already has the text and wants the ledger built from it; charging
                them the audio again is the difference between a minute and an afternoon.
            -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <RadioButton x:Name="ModeTranscribe" GroupName="Mode" IsChecked="True"
                             Checked="Mode_Changed" Margin="0,0,20,0">
                    <StackPanel>
                        <TextBlock Text="Baştan yazıya dök" FontWeight="SemiBold" />
                        <TextBlock Text="Sesi yeniden çevirir. Metin ve çözümleme yenilenir."
                                   Style="{StaticResource Caption}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="ModeAnalyse" GroupName="Mode" Checked="Mode_Changed">
                    <StackPanel>
                        <TextBlock Text="Yalnızca yeniden çözümle" FontWeight="SemiBold" />
                        <TextBlock Text="Mevcut metni kullanır. Çok daha hızlı ve ucuzdur."
                                   Style="{StaticResource Caption}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <TextBlock x:Name="ListHeading" Style="{StaticResource GroupHeader}" Margin="0,16,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Margin="20,0,20,0" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ListBox x:Name="Methods" Style="{StaticResource CleanList}"
                     BorderThickness="0" Background="Transparent"
                     MouseDoubleClick="Methods_DoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!--
                    Split by where the audio goes, because that is the part of this choice that
                    cannot be undone. Speed and cost are recoverable mistakes; sending a private
                    conversation to a hosted service is not, and it should never be something a
                    person discovers afterwards from a row they skimmed.
                -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource GroupHeader}"
                                           Margin="6,12,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon}" FontSize="18"
                                           Margin="0,0,14,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />

                                    <!-- Said on the row rather than in a help page: this is the
                                         moment the decision is actually being made. -->
                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding SendsDataOffMachine, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource PillText}" Text="ses makineden çıkar" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Speed}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource Caption}"
                                       FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="20,14,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Hint" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Style="{StaticResource Caption}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Vazgeç" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
                <ui:Button Content="Yeniden işle" Appearance="Primary" Click="Start_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
