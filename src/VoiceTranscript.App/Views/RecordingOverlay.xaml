<Window x:Class="VoiceTranscript.App.Views.RecordingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{loc:T recordingoverlay.kaydediliyor}"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ShowActivated="False">

    <!--
        A strip that says the microphone is open.

        This exists because the alternative is a recorder that is indistinguishable from one that
        is switched off. The tray icon is not enough: it is eight pixels of a colour nobody has
        memorised, on a bar that is frequently collapsed. Somebody who cannot tell at a glance
        whether their conversations are being recorded will eventually assume the worst and stop
        using the application — and they would be right to.

        Deliberately small and at the top edge rather than a banner across the screen. It has to
        be noticeable while a call is up and ignorable while working, and it must never be the
        thing covering the button somebody is trying to press.
    -->
    <Border x:Name="Body"
            CornerRadius="10"
            Padding="14,7,10,8"
            Cursor="SizeAll"
            ToolTip="{loc:T recordingoverlay.surukleyerek-tasi}"
            Background="#E6111111"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal">

            <!--
                The dot pulses.

                A static red dot reads as an icon; a pulsing one reads as something happening
                now. That difference is the whole job of this strip.
            -->
            <Ellipse x:Name="Pulse" Width="9" Height="9" Fill="#FF4D4D"
                     VerticalAlignment="Center" Margin="0,0,9,0">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.25" Duration="0:0:0.9"
                                                 AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <TextBlock x:Name="Label" Text="{loc:T recordingoverlay.kaydediliyor}" Foreground="#FFFFFF"
                       VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />

            <TextBlock x:Name="Elapsed" Text="0:00" Foreground="#B0FFFFFF"
                       VerticalAlignment="Center" Margin="9,0,0,0" FontSize="12"
                       FontFamily="Consolas, Cascadia Mono, Segoe UI" />

            <Border Width="1" Margin="12,2,10,2" Background="#33FFFFFF" />

            <!--
                What you have decided not to say, written while there is still time to act on it.

                On the strip because it is the only surface visible during a call, and this note is
                worthless afterwards. Hidden unless the setting is on: a box put in front of
                somebody who is about to speak to another person has to have been asked for.
            -->
            <Button x:Name="IntentButton" Content="{loc:T recordingoverlay.niyet}" Click="Intent_Click"
                    ToolTip="{loc:T recordingoverlay.bu-gorusmede-soylemek-istemedigin-sey}"
                    Visibility="Collapsed"
                    Background="Transparent" Foreground="#CCFFFFFF" BorderThickness="0"
                    Padding="8,2" Margin="0,0,4,0" FontSize="12" Cursor="Hand" />

            <!--
                Stopping is on the strip itself, not only in the window.

                Deciding not to record a conversation is a decision made *during* it, usually a
                few seconds in, and requiring somebody to find a window in the tray first means
                the part they wanted kept out is already recorded.
            -->
            <Border Background="#33FF4D4D" CornerRadius="7" Margin="0,0,2,0">
                <Button x:Name="StopButton" Content="{loc:T recordingoverlay.durdur}" Click="Stop_Click"
                        Background="Transparent" Foreground="#FFD2D2" BorderThickness="0"
                        Padding="9,2" FontSize="12" FontWeight="SemiBold" Cursor="Hand" />
            </Border>

            <Button x:Name="HideButton" Content="✕" Click="HideForCall_Click"
                    ToolTip="{loc:T recordingoverlay.bu-gorusme-boyunca-seridi-gizle-kayit-sure}"
                    Background="Transparent" Foreground="#80FFFFFF" BorderThickness="0"
                    Padding="6,2" FontSize="11" Cursor="Hand" />
        </StackPanel>
    </Border>
</Window>
