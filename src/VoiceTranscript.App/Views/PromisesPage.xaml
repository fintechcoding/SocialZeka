<UserControl x:Class="VoiceTranscript.App.Views.PromisesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
             xmlns:controls="clr-namespace:VoiceTranscript.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PromisesViewModel}">

    <UserControl.Resources>
        <!--
            A card is its own surface, so its row is nothing at all: CleanList's chrome would draw
            a second hover behind every card and pad it away from the one beside it. Same shape as
            the search page's rows, and for the same reason.
        -->
        <Style x:Key="PromiseRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            One promise. The head says where it stands (how late, whether it was marked), the
            body says what and by when, the quote is the evidence and plays where it was said,
            and the verbs are the user's — nothing on this card was decided by the machine
            except the dates it did arithmetic on.
        -->
        <DataTemplate x:Key="PromiseCardTemplate" DataType="{x:Type vm:PromiseCard}">
            <Border Style="{StaticResource SettingCard}" Padding="14,10" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding HeadText}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKept}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ContactName}" Style="{StaticResource Caption}" Margin="0,0,6,0" />
                            <Border Style="{StaticResource Pill}" Padding="6,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource PillText}" Text="{Binding Initial}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- One promise: what was promised. A grouped card shows the candidates instead. -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding IsGrouped, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{Binding Obligation}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   FontSize="{StaticResource TextBody}" />
                        <Border Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource PillText}" Text="{loc:T promisespage.senin-duzeltmen}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding DeadlineText}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsGrouped, Converter={StaticResource InverseBoolToVisibility}}" />

                    <!-- The words, playable: ▸ opens the conversation at the moment they were said. -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Appearance="Transparent" Padding="4,0" Margin="0,0,6,0"
                                   ToolTip="{loc:T promisespage.sozun-verildigi-ani-dinle}"
                                   Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="14" />
                                <TextBlock Text="{Binding Timestamp}" Style="{StaticResource Caption}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                        <Border Grid.Column="1" Style="{StaticResource QuoteBlock}">
                            <TextBlock Style="{StaticResource QuoteText}" Text="{Binding Quote}" />
                        </Border>
                    </Grid>

                    <!--
                        ⌂ S1 — sözün etrafı. The two transcript lines before this moment and the two
                        after, from the same conversation, each playable. Raw transcript: no label,
                        no reading, and nothing here says whether the sentence is a promise. It does
                        not need to — "yav bir kulaklık alacağım" beside "sesim çok kötü geliyor"
                        answers the question by itself, and the answer is the user's to give.

                        Folded away by default: four extra lines on each of thirteen cards would
                        turn the page back into a transcript.
                    -->
                    <ui:HyperlinkButton Padding="0" Margin="0,6,0,0"
                                        Content="{loc:T promisespage.sozun-etrafi}"
                                        ToolTip="{loc:T promisespage.sozun-etrafini-dinle}"
                                        Visibility="{Binding HasAround, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.ToggleAroundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />

                    <ItemsControl ItemsSource="{Binding Around}" Margin="0,2,0,0"
                                  Visibility="{Binding IsAroundOpen, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PromiseLine}">
                                <ui:Button Appearance="Transparent" Padding="4,2" Margin="0,0,0,1"
                                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                           ToolTip="{loc:T promisespage.sozun-verildigi-ani-dinle}"
                                           Command="{Binding DataContext.OpenLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Style="{StaticResource TimeLink}"
                                                   VerticalAlignment="Top" Margin="0,1,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Speaker}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Top" Margin="0,0,8,0" MinWidth="24" />
                                        <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        ⌂ S2 — one sentence, two promises. The pipeline drew more than one obligation
                        out of these same words, so the card asks which one was meant instead of
                        listing them as two promises nobody made twice.

                        The candidates sit INSIDE the card, in their own frame, because they are
                        evidence: the machine's readings, never rewritten. What the user answers
                        appears below the card, under a rule, as their own writing.
                    -->
                    <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="4"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                            Visibility="{Binding IsGrouped, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding CandidateQuestion}" Style="{StaticResource Caption}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding Candidates}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PromiseCard}">
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Obligation}" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" FontSize="{StaticResource TextBody}" />
                                            <ui:Button Grid.Column="1" Content="{loc:T promisespage.bu-secim}"
                                                       Margin="8,0,0,0" Appearance="Secondary"
                                                       Command="{Binding DataContext.PickCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="0,10,0,0">
                                <ui:Button Content="{loc:T promisespage.ikisi-de-kalsin}" Margin="0,0,6,0" Appearance="Secondary"
                                           Command="{Binding DataContext.KeepAllCandidatesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Content="{loc:T promisespage.bu-soz-degil}" Appearance="Transparent"
                                           Command="{Binding DataContext.JudgeNotAPromiseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Postponing, inline: the spoken date stays; this is the user's own. -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding IsPostponing, Converter={StaticResource BoolToVisibility}}">
                        <DatePicker SelectedDate="{Binding PostponeTo}" MinWidth="150" VerticalAlignment="Center" />
                        <ui:Button Content="{loc:T promisespage.uygula}" Appearance="Primary" Margin="8,0,0,0"
                                   Command="{Binding DataContext.ApplyPostponeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{loc:T promisespage.vazgec}" Appearance="Transparent" Margin="4,0,0,0"
                                   Command="{Binding DataContext.CancelPostponeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </StackPanel>

                    <!--
                        The one verb anybody uses, and the way to the rest.

                        Counted over this archive: "Tutuldu" has been pressed four times and every
                        other control on the card zero. So the card shows that one and a link, and
                        folds the rest away — see PromiseCard.AreActionsOpen for the count that
                        decided it.

                        The second verb is here because the extraction is wrong sometimes and the
                        reader can see it at a glance: a sentence that was never a promise sits in
                        the list until somebody says so, and making that a two-click job left it
                        sitting. It is a ruling, not a tidy-up — the extractor's own measurement
                        reads these, which is why this and not "Reddet" is the one on the front.
                    -->
                    <WrapPanel Margin="0,8,0,0"
                               Visibility="{Binding IsGrouped, Converter={StaticResource InverseBoolToVisibility}}">
                        <ui:Button Content="{loc:T promisespage.tutuldu}" Margin="0,0,8,0"
                                   Visibility="{Binding CanFulfil, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.FulfilCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Checkmark24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="{loc:T promisespage.bu-soz-degil}" Margin="0,0,10,0" Appearance="Secondary"
                                   ToolTip="{loc:T promisespage.bu-soz-degil-aciklama}"
                                   Visibility="{Binding CanJudge, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.JudgeNotAPromiseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:HyperlinkButton Padding="0" VerticalAlignment="Center"
                                            Content="{loc:T promisespage.diger-secenekler}"
                                            ToolTip="{loc:T promisespage.diger-secenekler-aciklama}"
                                            Command="{Binding DataContext.ToggleActionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                    </WrapPanel>

                    <!-- Everything below is one click away, and nothing below was removed. -->
                    <StackPanel Visibility="{Binding AreActionsOpen, Converter={StaticResource BoolToVisibility}}">

                    <!--
                        S3 — "Ne zamana?". Twelve of the archive's thirteen promises have no date,
                        so this strip is on almost every card.

                        The first four write the USER's date; what the words said stays in the
                        machine's column, because the consistency check reads that one to see
                        whether the other person moved a deadline. The fifth is the point of the
                        feature: "tarihsiz" stops being a hole in the page and becomes an answer.
                    -->
                    <WrapPanel Margin="0,8,0,0"
                               Visibility="{Binding NeedsDeadline, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:T promisespage.ne-zamana}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,8,4" />
                        <ui:Button Content="{loc:T promisespage.bu-hafta}" Margin="0,0,6,4" Appearance="Secondary"
                                   Command="{Binding DataContext.DeadlineThisWeekCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{loc:T promisespage.onumuzdeki-hafta}" Margin="0,0,6,4" Appearance="Secondary"
                                   Command="{Binding DataContext.DeadlineNextWeekCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{loc:T promisespage.bu-ay-icinde}" Margin="0,0,6,4" Appearance="Secondary"
                                   Command="{Binding DataContext.DeadlineThisMonthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{loc:T promisespage.tarih-sec}" Margin="0,0,6,4" Appearance="Secondary"
                                   Command="{Binding DataContext.BeginPostponeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{loc:T promisespage.tarihsiz-kalsin}" Margin="0,0,6,4" Appearance="Transparent"
                                   Command="{Binding DataContext.KeepUndatedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </WrapPanel>

                    <!-- The strip, answered. It stops asking, and the answer can be taken back. -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding IsKeptUndated, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Pill}">
                            <TextBlock Style="{StaticResource PillText}" Text="{Binding UndatedText}" />
                        </Border>
                        <ui:HyperlinkButton Content="{loc:T promisespage.yine-de-sor}" Padding="0" Margin="8,0,0,0"
                                            Command="{Binding DataContext.AskAgainForDeadlineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                    </StackPanel>

                    <!-- The verbs. Only the user marks anything; each can be taken back from the notice below. -->
                    <WrapPanel Margin="0,8,0,0"
                               Visibility="{Binding IsGrouped, Converter={StaticResource InverseBoolToVisibility}}">
                        <ui:Button Content="{loc:T promisespage.tutulmadi}" Margin="0,0,6,4" Appearance="Secondary"
                                   Visibility="{Binding CanFulfil, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.AbandonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{loc:T promisespage.ertele}" Margin="0,0,6,4" Appearance="Secondary"
                                   Visibility="{Binding CanPostpone, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.BeginPostponeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{loc:T promisespage.soylenen-tarihe-don}" Margin="0,0,6,4" Appearance="Transparent"
                                   Visibility="{Binding HasUserDeadline, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.ClearPostponeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{loc:T promisespage.hatirlat}" Margin="0,0,6,4" Appearance="Secondary"
                                   Visibility="{Binding CanRemind, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.RemindCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Margin="0,0,6,4" Appearance="Secondary" ToolTip="{loc:T promisespage.duzenle}"
                                   Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="14" />
                        </ui:Button>
                        <ui:Button Content="{loc:T promisespage.yeniden-ac}" Margin="0,0,6,4" Appearance="Secondary"
                                   Visibility="{Binding CanReopen, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{loc:T promisespage.geri-getir}" Margin="0,0,6,4" Appearance="Secondary"
                                   Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{loc:T promisespage.reddet}" Margin="12,0,0,4" Appearance="Transparent"
                                   ToolTip="{loc:T promisespage.reddedersen-listeden-cikar}"
                                   Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </WrapPanel>

                    <!-- Past its date and spoken about since: said, never concluded. -->
                    <TextBlock Text="{Binding LeftOpenText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding IsLeftOpen, Converter={StaticResource BoolToVisibility}}" />

                    <!-- A question, not a mark: a later line that sounds like the same subject. -->
                    <ui:HyperlinkButton Content="{Binding HintText}" Padding="0" Margin="0,4,0,0"
                                        Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.OpenHintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />

                    <!--
                        S4 — the ear, on a promise. Aynam's confirmation widened from what the user
                        said to what somebody was held to: the words are that promise, or the
                        transcript misheard them.

                        The third ruling, "and they are not a promise at all", moved to the front
                        of the card. It was never really an ear question — the other two ask
                        whether the words were heard right, that one asks whether the words were
                        a commitment — and it is the one the reader reaches for most.

                        The machine never gives this ruling and never asks it as a leading question;
                        it asks whether the user listened.
                    -->
                    <WrapPanel Margin="0,8,0,0"
                               Visibility="{Binding CanJudge, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:T promisespage.dinledin-mi}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,8,4" />
                        <ui:Button Content="{loc:T promisespage.dogru}" Margin="0,0,6,4" Appearance="Transparent"
                                   Command="{Binding DataContext.JudgeCorrectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{loc:T promisespage.yanlis-duyulmus}" Margin="0,0,6,4" Appearance="Transparent"
                                   Command="{Binding DataContext.JudgeMisheardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </WrapPanel>

                    </StackPanel>

                    <!--
                        ✎ The user's own writing, below a rule.

                        Everything above this line is the machine's — its quote, its reading, the
                        candidates it drew. Everything below is the user's ruling on it. The two
                        grounds may share a card; they may not share a region without a boundary,
                        and this is the boundary.
                    -->
                    <Border Margin="0,8,0,0" Padding="0,6,0,0" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Visibility="{Binding HasUserMark, Converter={StaticResource BoolToVisibility}}">
                        <WrapPanel>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,0"
                                    Visibility="{Binding IsChosen, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource PillText}" Text="{Binding ChosenText}" />
                            </Border>
                            <Border Style="{StaticResource Pill}"
                                    Visibility="{Binding JudgementText, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Style="{StaticResource PillText}" Text="{Binding JudgementText}" />
                            </Border>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PadPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:T promisespage.sozler}" Style="{StaticResource PageTitle}" />
            <ui:TextBox Grid.Column="1" MinWidth="200" VerticalAlignment="Center" Margin="12,0,0,0"
                        PlaceholderText="{loc:T promisespage.kisiye-gore-suz}"
                        Text="{Binding PersonFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
        </Grid>

        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}" Text="{loc:T promisespage.aciklama}" />

        <!-- The slices. Counts on the chips, so the numbers are read before anything is clicked. -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <ui:Button Margin="0,0,6,6" Command="{Binding SetFilterCommand}" CommandParameter="Open"
                       Appearance="{Binding Filter, Converter={StaticResource FilterAppearance}, ConverterParameter=Open}">
                <!-- Open, and only open: this number used to be the total of everything, kept and
                     dismissed rows included, under a chip labelled "Açık". -->
                <TextBlock><Run Text="{loc:T promisespage.acik}" /><Run Text=" " /><Run Text="{Binding OpenCount, Mode=OneWay}" /></TextBlock>
            </ui:Button>
            <ui:Button Margin="0,0,6,6" Command="{Binding SetFilterCommand}" CommandParameter="Overdue"
                       Appearance="{Binding Filter, Converter={StaticResource FilterAppearance}, ConverterParameter=Overdue}">
                <TextBlock><Run Text="{loc:T promisespage.vadesi-gecti}" /><Run Text=" " /><Run Text="{Binding OverdueCount, Mode=OneWay}" /></TextBlock>
            </ui:Button>
            <ui:Button Margin="0,0,6,6" Command="{Binding SetFilterCommand}" CommandParameter="ThisWeek"
                       Appearance="{Binding Filter, Converter={StaticResource FilterAppearance}, ConverterParameter=ThisWeek}">
                <TextBlock><Run Text="{loc:T promisespage.bu-hafta}" /><Run Text=" " /><Run Text="{Binding ThisWeekCount, Mode=OneWay}" /></TextBlock>
            </ui:Button>
            <ui:Button Margin="0,0,6,6" Command="{Binding SetFilterCommand}" CommandParameter="Undated"
                       Appearance="{Binding Filter, Converter={StaticResource FilterAppearance}, ConverterParameter=Undated}">
                <TextBlock><Run Text="{loc:T promisespage.tarihsiz}" /><Run Text=" " /><Run Text="{Binding UndatedCount, Mode=OneWay}" /></TextBlock>
            </ui:Button>
            <ui:Button Margin="0,0,6,6" Command="{Binding SetFilterCommand}" CommandParameter="Conditional"
                       Appearance="{Binding Filter, Converter={StaticResource FilterAppearance}, ConverterParameter=Conditional}">
                <TextBlock><Run Text="{loc:T promisespage.kosullu}" /><Run Text=" " /><Run Text="{Binding ConditionalCount, Mode=OneWay}" /></TextBlock>
            </ui:Button>
            <ui:Button Margin="0,0,6,6" Command="{Binding SetFilterCommand}" CommandParameter="Kept"
                       Appearance="{Binding Filter, Converter={StaticResource FilterAppearance}, ConverterParameter=Kept}">
                <TextBlock><Run Text="{loc:T promisespage.tutulanlar}" /><Run Text=" " /><Run Text="{Binding KeptCount, Mode=OneWay}" /></TextBlock>
            </ui:Button>
            <ui:Button Margin="0,0,6,6" Command="{Binding SetFilterCommand}" CommandParameter="Dismissed"
                       Appearance="{Binding Filter, Converter={StaticResource FilterAppearance}, ConverterParameter=Dismissed}">
                <TextBlock><Run Text="{loc:T promisespage.reddedilenler}" /><Run Text=" " /><Run Text="{Binding DismissedCount, Mode=OneWay}" /></TextBlock>
            </ui:Button>
            <ui:Button Margin="0,0,6,6" Command="{Binding SetFilterCommand}" CommandParameter="All"
                       Appearance="{Binding Filter, Converter={StaticResource FilterAppearance}, ConverterParameter=All}">
                <TextBlock><Run Text="{loc:T promisespage.hepsi}" /><Run Text=" " /><Run Text="{Binding AllCount, Mode=OneWay}" /></TextBlock>
            </ui:Button>
        </WrapPanel>

        <!--
            The columns scroll themselves, and that is what makes the page quick.

            They used to be two plain ItemsControls inside one ScrollViewer, which is the shape
            the search page was already found in and fixed (a199332): an ItemsControl has no
            scrolling panel of its own, so it is measured with unlimited height and builds a
            visual tree for every row the query returned — a hundred and forty-five cards, each
            with its own nested lists, before the first one appears. A ListBox has a scrolling
            panel and builds only what is on screen.
        -->
        <Grid Grid.Row="3">
            <Grid>
                <!-- Two ways to land here: no promises at all, or a chip that happens to be
                     empty. The body says both, because from the page they look identical. -->
                <StackPanel Style="{StaticResource EmptyState}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="Handshake24" FontSize="38" HorizontalAlignment="Center"
                                   Margin="0,0,0,14"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T promisespage.bos-baslik}" />
                    <TextBlock Style="{StaticResource EmptyBody}" Text="{loc:T promisespage.bos}" />
                </StackPanel>

                <!-- Two columns, by who owes whom. The two sides read differently: one is a list of
                     things to do, the other a list of things to ask about. -->
                <Grid Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding MineHeader}" Style="{StaticResource GroupHeader}" Margin="4,0,0,6" />
                        <ListBox Grid.Row="1" Style="{StaticResource CleanList}" ItemsSource="{Binding Mine}"
                                 ItemTemplate="{StaticResource PromiseCardTemplate}"
                                 ItemContainerStyle="{StaticResource PromiseRow}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.ScrollUnit="Pixel" />
                        <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding MineTally}" Style="{StaticResource Caption}" Margin="4,2,0,0" />

                        <!-- Where the column came from. A count with no denominator beside it reads
                             as a fact about a person. -->
                        <TextBlock Text="{Binding SourceLine}" Style="{StaticResource Caption}" Margin="4,2,0,0"
                                   TextWrapping="Wrap" />

                        <!-- And what a lopsided pair of columns may actually be. Under the user's own
                             column, because that is the one the extraction under-reads. -->
                        <TextBlock Text="{Binding AsymmetryNote}" Style="{StaticResource Caption}" Margin="4,4,0,12"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding HasAsymmetryNote, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding TheirsHeader}" Style="{StaticResource GroupHeader}" Margin="4,0,0,6" />
                        <ListBox Grid.Row="1" Style="{StaticResource CleanList}" ItemsSource="{Binding Theirs}"
                                 ItemTemplate="{StaticResource PromiseCardTemplate}"
                                 ItemContainerStyle="{StaticResource PromiseRow}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.ScrollUnit="Pixel" />
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{Binding TheirsTally}" Style="{StaticResource Caption}" Margin="4,2,0,0" />
                            <TextBlock Text="{Binding SourceLine}" Style="{StaticResource Caption}" Margin="4,2,0,12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!--
            What just happened, and the way back — the shared strip, not a copy of it.

            The copy that stood here was one of two that never asked whether there was anything
            to take back: its "Geri al" was drawn whenever the line was.
        -->
        <controls:UndoBar Grid.Row="4" Slot="{Binding Undo}" Margin="0,8,0,0" />
    </Grid>
</UserControl>
