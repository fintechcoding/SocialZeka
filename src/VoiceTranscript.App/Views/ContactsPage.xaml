<UserControl x:Class="VoiceTranscript.App.Views.ContactsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ContactsViewModel}">

    <Grid Margin="16,4,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Contact list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TextBox Grid.Row="0" Margin="0,0,0,12"
                        PlaceholderText="{loc:T contactspage.kisi-ara}"
                        Text="{Binding ContactFilter, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <ListBox Grid.Row="1" Style="{StaticResource CleanList}"
                     ItemsSource="{Binding Contacts}"
                     SelectedItem="{Binding SelectedContact}"
                     PreviewKeyDown="ContactList_KeyDown"
                     Visibility="{Binding HasContacts, Converter={StaticResource BoolToVisibility}}">

                <!--
                    Repairing a contact, on the contact.

                    These three exist because automatic attribution cannot be made reliable: all
                    the messengers offer is a window title, and a title is sometimes the person,
                    sometimes the conversation that was open, sometimes an unread counter. Wrong
                    names and duplicated people are therefore normal, not exceptional, and fixing
                    them has to be as ordinary as making them.

                    F2 renames, because that is what F2 does everywhere else in Windows and
                    somebody who has just spotted a misspelling will press it before looking for a
                    menu.
                -->
                <!--
                    The menu lives on the list, not on the item.

                    A ContextMenu inside an ItemContainerStyle's Setter.Value cannot carry compiled
                    Click handlers: the generated Connect() maps handlers by index over the file,
                    and a menu instantiated once per container breaks that mapping. It fails as an
                    InvalidCastException while the page is being built — caught here only because
                    the smoke test really constructs every screen.

                    On the list it is created once, and the EventSetter below guarantees the row
                    under the cursor is selected before it opens, so it always acts on what was
                    right-clicked.
                -->
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Yeniden adlandır" InputGestureText="F2" Click="RenameContact_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Rename24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Başka kişiyle birleştir…" Click="MergeContact_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="PeopleSwap24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Kişiyi sil…" Click="DeleteContact_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="ContactRow_RightClick" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Avatar}" Margin="0,0,12,0"
                                    Background="{Binding Name, Converter={StaticResource NameBrush}}">
                                <TextBlock Style="{StaticResource AvatarText}"
                                           Text="{Binding Name, Converter={StaticResource Initials}}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           FontSize="{StaticResource TextBody}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource CountPill}"
                                    Visibility="{Binding HasFlags, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource CountPillText}" Text="{Binding FlagCount}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Style="{StaticResource EmptyState}"
                        Visibility="{Binding HasContacts, Converter={StaticResource InverseBoolToVisibility}}">
                <ui:SymbolIcon Symbol="People24" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,14"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T contactspage.henuz-kisi-yok}" />
                <TextBlock Style="{StaticResource EmptyBody}"
                           Text="{loc:T contactspage.bir-gorusme-kaydedilip-kime-ait-oldugunu-s}" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Width="1" Margin="16,0" VerticalAlignment="Stretch"
                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <!-- Detail -->
        <Grid Grid.Column="2">

            <!-- Nothing selected. -->
            <StackPanel Style="{StaticResource EmptyState}"
                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                <ui:SymbolIcon Symbol="Person24" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,16"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T contactspage.bir-kisi-sec}" />
                <TextBlock Style="{StaticResource EmptyBody}"
                           Text="{loc:T contactspage.soldaki-listeden-birini-sectiginde-o-kisiy}" />
            </StackPanel>

            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Style="{StaticResource HeroCard}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource AvatarLarge}" Margin="0,0,16,0"
                                Background="{Binding SelectedContact.Name, Converter={StaticResource NameBrush}}">
                            <TextBlock Style="{StaticResource AvatarTextLarge}"
                                       Text="{Binding SelectedContact.Name, Converter={StaticResource Initials}}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedContact.Name}" FontWeight="SemiBold"
                                       FontSize="{StaticResource TextTitle}" />
                            <TextBlock Text="{Binding SelectedContact.Detail}" Style="{StaticResource Secondary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!--
                                Sits beside the other per-call actions because that is where
                                somebody looking at a call filed under the wrong person already is.

                                It is not a rare repair. All the messengers offer for attribution is
                                a window title, and a title is sometimes the person, sometimes the
                                conversation that happened to be open, and sometimes an unread
                                counter — so calls land under the wrong contact no matter how
                                careful the guessing gets, and correcting it has to be ordinary.
                            -->
                            <ui:Button Content="Kişiyi değiştir" Margin="0,0,8,0" Click="MoveCall_Click"
                                       ToolTip="Bu görüşmeyi başka bir kişinin altına taşı."
                                       IsEnabled="{Binding SelectedCall, Converter={StaticResource NullToBool}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="PersonSwap24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Content="{loc:T contactspage.yeniden-isle}" Margin="0,0,8,0" Click="Reprocess_Click"
                                       ToolTip="{loc:T contactspage.bu-gorusmeyi-bastan-yaziya-dok-ve-cozumle}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Content="{loc:T contactspage.disa-aktar}" Margin="0,0,8,0" Click="Export_Click"
                                       ToolTip="{loc:T contactspage.bu-kisinin-gorusmelerini-obsidian-kasasina}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Save24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Appearance="Danger" Click="DeleteContact_Click"
                                       ToolTip="{loc:T contactspage.bu-kisiye-ait-her-seyi-kalici-olarak-sil}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Three views of one contact. -->
                <TabControl Grid.Row="1" Padding="0,12,0,0">

                    <!-- calls and transcript -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Call24" FontSize="16" Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T contactspage.gorusmeler}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
<Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--
                                The call list, with its own filters above it.

                                A person you speak to often accumulates hundreds of conversations
                                and they all look the same in a list: a date and a duration. The
                                text box searches inside the transcripts of *this contact's*
                                calls, so "on sekiz bin" narrows two hundred rows to the one
                                where a number was agreed.
                            -->
                            <Grid Grid.Column="0" Margin="0,0,14,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ui:TextBox Grid.Row="0" Margin="0,0,0,6"
                                            PlaceholderText="{loc:T contactspage.bu-kisiyle-konusulanlarda-ara}"
                                            Text="{Binding CallFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}">
                                    <ui:TextBox.Icon>
                                        <ui:SymbolIcon Symbol="Search24" />
                                    </ui:TextBox.Icon>
                                </ui:TextBox>

                                <ComboBox Grid.Row="1" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Periods}"
                                          SelectedItem="{Binding CallPeriod}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource PeriodName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!--
                                    What the filters are hiding, and one click to stop hiding it.

                                    Without this line a filter left on from ten minutes ago looks
                                    exactly like a contact who has only had two conversations —
                                    and the natural conclusion is that recordings have gone
                                    missing.
                                -->
                                <Border Grid.Row="2" Margin="0,0,0,8"
                                        Visibility="{Binding IsFilteringCalls, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Style="{StaticResource Caption}"
                                                   Text="{Binding HiddenCallCount, StringFormat={}{0} görüşme gizli}" />

                                        <ui:Button Grid.Column="1" Content="{loc:T contactspage.suzgeci-kaldir}"
                                                   Appearance="Transparent" Padding="6,2"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Command="{Binding ClearCallFiltersCommand}" />
                                    </Grid>
                                </Border>

                            <ListBox Grid.Row="3" Style="{StaticResource CleanList}"
                                     ItemsSource="{Binding Calls}" SelectedItem="{Binding SelectedCall}">

                                <!--
                                    The per-call actions, on the call itself.

                                    The toolbar above has the same commands, but a toolbar is the
                                    wrong place to look when the thing you have noticed is a
                                    particular row filed under the wrong person. Right-clicking the
                                    row is where a Windows user reaches first, and putting the
                                    action on the object removes the step of hunting for it.

                                    The menu is on the list rather than on the item: a ContextMenu
                                    inside an ItemContainerStyle's Setter.Value cannot carry
                                    compiled Click handlers, and fails while the page is built.
                                    The EventSetter selects the row under the cursor first, so the
                                    menu always acts on what was right-clicked — without it, "move
                                    this to somebody else" would quietly move a different call.
                                -->
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Başka kişiye taşı…" Click="MoveCall_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="PersonSwap24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Yeniden işle" Click="Reprocess_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ArrowSync24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Ses dosyasının yerini aç" Click="ShowInFolder_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="FolderOpen24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="CallRow_RightClick" />
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontWeight="SemiBold"
                                                           FontSize="{StaticResource TextSecondary}"
                                                           Text="{Binding StartedAt, Converter={StaticResource RelativeDate}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Length}"
                                                           FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                                           FontSize="{StaticResource TextCaption}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Grid>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Summary -->
                                <Border Grid.Row="0" Style="{StaticResource Panel}"
                                        Visibility="{Binding Summary, Converter={StaticResource NullToCollapsed}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{loc:T contactspage.ozet}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </Border>

                                <!--
                                    Who did the talking.

                                    Free from the recording design, and impossible to produce
                                    honestly from a single mixed stream. Stated as a measurement,
                                    never as a verdict about the other person.
                                -->
                                <Border Grid.Row="1" Style="{StaticResource Panel}"
                                        Visibility="{Binding HasTalkStats, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T contactspage.konusma-payi}" FontWeight="SemiBold" Margin="0,0,0,8" />

                                        <Grid Height="8" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding TalkRatio, Converter={StaticResource RatioStar}, ConverterParameter=me}" />
                                                <ColumnDefinition Width="{Binding TalkRatio, Converter={StaticResource RatioStar}, ConverterParameter=them}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource MeBrush}"
                                                    CornerRadius="4,0,0,4" />
                                            <Border Grid.Column="1" Background="{StaticResource ThemBrush}"
                                                    CornerRadius="0,4,4,0" />
                                        </Grid>

                                        <TextBlock Text="{Binding TalkSummary}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding InterruptionSummary}" Style="{StaticResource Caption}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="2" Text="{Binding TranscriptMessage}"
                                           Style="{StaticResource Secondary}" Margin="0,8,0,8"
                                           Visibility="{Binding TranscriptMessage, Converter={StaticResource NullToCollapsed}}" />

                                <!--
                                    The transcript.

                                    Speaker colour on the leading edge, the name beside it, and a
                                    clickable timestamp. Colour is never the only signal: the name
                                    is always written, so the transcript survives being printed or
                                    read by somebody who cannot tell the two colours apart.
                                -->
                                <ListBox Grid.Row="3" Style="{StaticResource CleanList}"
                                         ItemsSource="{Binding Transcript}"
                                         Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,12,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource ThemBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource MeBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <StackPanel Grid.Column="1" Width="92" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold"
                                                               FontSize="{StaticResource TextSecondary}"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Style="{StaticResource TimeLink}" Margin="0,2,0,0"
                                                               Text="{Binding Timestamp}"
                                                               ToolTip="{loc:T contactspage.bu-andan-itibaren-dinle}">
                                                        <TextBlock.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.PlayFromCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                          CommandParameter="{Binding StartMs}" />
                                                        </TextBlock.InputBindings>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                               FontSize="{StaticResource TextSecondary}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Warning}" Style="{StaticResource Caption}"
                                                               FontStyle="Italic" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!--
                                    The player.

                                    Two mirrored waveforms: you above the line, the other party
                                    below. No recorder that captures a call as one mixed stream
                                    can draw this, because it does not know whose sound is whose
                                    at any moment. Here it is two files, so the shape is a fact.
                                -->
                                <Border Grid.Row="4" Style="{StaticResource Panel}" Margin="0,10,0,0"
                                        Visibility="{Binding Playback.IsLoaded, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <Grid x:Name="WaveformHost" Height="76" Margin="0,0,0,8"
                                              Background="Transparent"
                                              MouseLeftButtonDown="Waveform_Click"
                                              Cursor="Hand"
                                              ToolTip="{loc:T contactspage.tikla-oradan-dinle}">
                                            <Viewbox Stretch="Fill">
                                                <Canvas Width="1000" Height="68">
                                                    <Polygon Points="{Binding Playback.MicShape}"
                                                             Fill="{StaticResource MeBrush}" Opacity="0.85" />
                                                    <Polygon Points="{Binding Playback.FarShape}"
                                                             Fill="{StaticResource ThemBrush}" Opacity="0.85" />

                                                    <!-- Centre line, so the two bands read as one timeline. -->
                                                    <Line X1="0" Y1="34" X2="1000" Y2="34" StrokeThickness="0.6"
                                                          Stroke="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                                    <Line Y1="0" Y2="68" StrokeThickness="1.6"
                                                          X1="{Binding Playback.PlayheadX}"
                                                          X2="{Binding Playback.PlayheadX}"
                                                          Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Button Style="{StaticResource GhostButton}" ToolTip="{loc:T contactspage.10-saniye-geri}"
                                                        Command="{Binding Playback.SkipBackCommand}">
                                                    <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="16" />
                                                </Button>

                                                <Button Style="{StaticResource GhostButton}" Margin="2,0"
                                                        Command="{Binding Playback.TogglePlayCommand}"
                                                        ToolTip="{loc:T contactspage.cal-duraklat}">
                                                    <Grid>
                                                        <ui:SymbolIcon Symbol="Play24" FontSize="18"
                                                                       Visibility="{Binding Playback.IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        <ui:SymbolIcon Symbol="Pause24" FontSize="18"
                                                                       Visibility="{Binding Playback.IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource GhostButton}" ToolTip="{loc:T contactspage.10-saniye-ileri}"
                                                        Command="{Binding Playback.SkipForwardCommand}">
                                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                                                </Button>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                                       FontSize="{StaticResource TextSecondary}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding Playback.PositionText, Mode=OneWay}" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding Playback.DurationText, Mode=OneWay}" />
                                            </TextBlock>

                                            <!--
                                                Which of the three recordings is being heard.

                                                All three cover the same stretch of time, so this
                                                keeps the moment and changes only the voice. It
                                                opens on the whole conversation, because that is
                                                what somebody means when they say they want to
                                                hear a call; the single sides are there for
                                                pulling one voice out of a passage where the two
                                                talked over each other.
                                            -->
                                            <ui:Button Grid.Column="2" Appearance="Transparent"
                                                       Command="{Binding Playback.SwitchSpeakerCommand}"
                                                       ToolTip="{loc:T contactspage.tum-gorusme-sen-karsi-taraf-arasinda-gecis}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Playback.Channel}" Value="Me">
                                                                        <Setter Property="Background" Value="{StaticResource MeBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Playback.Channel}" Value="Them">
                                                                        <Setter Property="Background" Value="{StaticResource ThemBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="{StaticResource TextSecondary}"
                                                               Text="{Binding Playback.ChannelName}" />
                                                </StackPanel>
                                            </ui:Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="5" Text="{Binding PlaybackMessage}"
                                           Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           Visibility="{Binding PlaybackMessage, Converter={StaticResource NullToCollapsed}}" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ledger -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flag24" FontSize="16" Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T contactspage.defter}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
<Grid Margin="0,12,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasFlags, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Flags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SettingCard}" Padding="16,14">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Style="{StaticResource Pill}"
                                                                Margin="0,0,10,0" VerticalAlignment="Top">
                                                            <TextBlock Style="{StaticResource PillText}"
                                                                       Text="{Binding Kind}" />
                                                        </Border>

                                                        <TextBlock Grid.Column="1" Text="{Binding Summary}"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                                   FontSize="{StaticResource TextBody}" />

                                                        <TextBlock Grid.Column="2" Style="{StaticResource TimeLink}"
                                                                   Text="{Binding Timestamp}" Margin="10,0,0,0"
                                                                   VerticalAlignment="Top" />
                                                    </Grid>

                                                    <!-- The quote travels with the claim, always. A
                                                         ledger line without the words it rests on
                                                         is an accusation. -->
                                                    <Border Style="{StaticResource QuoteBlock}"
                                                            BorderBrush="{StaticResource ThemBrush}">
                                                        <TextBlock Style="{StaticResource QuoteText}"
                                                                   Text="{Binding Quote}" />
                                                    </Border>

                                                    <Border Style="{StaticResource QuoteBlock}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            Visibility="{Binding HasCounter, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel>
                                                            <TextBlock Text="{loc:T contactspage.daha-once}" Style="{StaticResource Caption}" />
                                                            <TextBlock Style="{StaticResource QuoteText}"
                                                                       Text="{Binding CounterQuote}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Text="{Binding Caveat}" Style="{StaticResource Caption}"
                                                               Margin="0,8,0,0" FontStyle="Italic"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                               Visibility="{Binding HasCaveat, Converter={StaticResource BoolToVisibility}}" />

                                                    <!--
                                                        The moment itself, as a file.

                                                        A claim about a conversation is worth what
                                                        its evidence is worth. "You said eighteen
                                                        thousand" is an argument; eight seconds of
                                                        somebody saying it is not. Cut from the
                                                        mixed recording so the exchange is audible
                                                        — a promise with the question that
                                                        prompted it removed is a different
                                                        promise.
                                                    -->
                                                    <ui:Button Content="{loc:T contactspage.sesi-disa-aktar}"
                                                               Appearance="Transparent"
                                                               HorizontalAlignment="Left"
                                                               Margin="0,10,0,0" Padding="8,4"
                                                               FontSize="{StaticResource TextCaption}"
                                                               Tag="{Binding}"
                                                               Click="ExportClip_Click">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="MusicNote224" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Style="{StaticResource EmptyState}"
                                        Visibility="{Binding HasFlags, Converter={StaticResource InverseBoolToVisibility}}">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="36" HorizontalAlignment="Center"
                                               Margin="0,0,0,14"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T contactspage.defter-bos}" />
                                <TextBlock Style="{StaticResource EmptyBody}"
                                           Text="{loc:T contactspage.bu-kisiyle-olan-gorusmelerde-tutulmamis-so}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- open commitments -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ClipboardTaskListLtr24" FontSize="16" Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T contactspage.acik-sozler}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
<Grid Margin="0,12,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding OpenCommitments.Count, Converter={StaticResource CountToVisibility}}">
                                <ItemsControl ItemsSource="{Binding OpenCommitments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SettingCard}" Padding="16,14">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Obligation}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               FontSize="{StaticResource TextBody}" />
                                                    <Border Style="{StaticResource QuoteBlock}"
                                                            BorderBrush="{StaticResource ThemBrush}">
                                                        <TextBlock Style="{StaticResource QuoteText}"
                                                                   Text="{Binding Quote}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Style="{StaticResource EmptyState}"
                                        Visibility="{Binding OpenCommitments.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                                <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T contactspage.acik-soz-yok}" />
                                <TextBlock Style="{StaticResource EmptyBody}"
                                           Text="{loc:T contactspage.bu-kisinin-verdigi-ve-hala-bekleyen-bir-so}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
