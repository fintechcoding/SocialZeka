<UserControl x:Class="VoiceTranscript.App.Views.ContactsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
             xmlns:controls="clr-namespace:VoiceTranscript.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ContactsViewModel}">

    <Grid Margin="{StaticResource PadPage}">
        <Grid.ColumnDefinitions>
            <!--
                Narrower, and the reader decides how narrow.

                A fixed 300 is a guess about a window somebody else is sizing: the names in it are
                short, the conversation beside it is not, and on a laptop the guess costs a fifth
                of the screen to show a column of first names. The bounds keep it usable at both
                ends; the splitter below makes the rest somebody's own business.
            -->
            <ColumnDefinition Width="232" MinWidth="170" MaxWidth="520" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Contact list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TextBox Grid.Row="0" Margin="0,0,0,12"
                        PlaceholderText="{loc:T contactspage.kisi-ara}"
                        Text="{Binding ContactFilter, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <ListBox Grid.Row="1" Style="{StaticResource CleanList}"
                     ItemsSource="{Binding Contacts}"
                     SelectedItem="{Binding SelectedContact}"
                     PreviewKeyDown="ContactList_KeyDown"
                     Visibility="{Binding HasContacts, Converter={StaticResource BoolToVisibility}}">

                <!--
                    Repairing a contact, on the contact.

                    These three exist because automatic attribution cannot be made reliable: all
                    the messengers offer is a window title, and a title is sometimes the person,
                    sometimes the conversation that was open, sometimes an unread counter. Wrong
                    names and duplicated people are therefore normal, not exceptional, and fixing
                    them has to be as ordinary as making them.

                    F2 renames, because that is what F2 does everywhere else in Windows and
                    somebody who has just spotted a misspelling will press it before looking for a
                    menu.
                -->
                <!--
                    The menu lives on the list, not on the item.

                    A ContextMenu inside an ItemContainerStyle's Setter.Value cannot carry compiled
                    Click handlers: the generated Connect() maps handlers by index over the file,
                    and a menu instantiated once per container breaks that mapping. It fails as an
                    InvalidCastException while the page is being built — caught here only because
                    the smoke test really constructs every screen.

                    On the list it is created once, and the EventSetter below guarantees the row
                    under the cursor is selected before it opens, so it always acts on what was
                    right-clicked.
                -->
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:T contactspage.yeniden-adlandir}" InputGestureText="F2" Click="RenameContact_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Rename24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:T contactspage.baska-kisiyle-birlestir}" Click="MergeContact_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="PeopleSwap24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{loc:T contactspage.kisiyi-sil}" Click="DeleteContact_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="ContactRow_RightClick" />

                        <!-- Double-click opens the person in their own window: their calls, a
                             search across everything they have said, the ledger, and notes. -->
                        <EventSetter Event="MouseDoubleClick" Handler="ContactRow_DoubleClick" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,12,0">
                                <Border Style="{StaticResource Avatar}"
                                        Background="{Binding Name, Converter={StaticResource NameBrush}}"
                                        Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Style="{StaticResource AvatarText}"
                                               Text="{Binding Name, Converter={StaticResource Initials}}" />
                                </Border>
                                <Border Width="36" Height="36" CornerRadius="18"
                                        Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding PhotoPath, Converter={StaticResource Photo}}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           FontSize="{StaticResource TextBody}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource CountPill}"
                                    Visibility="{Binding HasFlags, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource CountPillText}" Text="{Binding FlagCount}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Style="{StaticResource EmptyState}"
                        Visibility="{Binding HasContacts, Converter={StaticResource InverseBoolToVisibility}}">
                <ui:SymbolIcon Symbol="People24" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,14"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T contactspage.henuz-kisi-yok}" />
                <TextBlock Style="{StaticResource EmptyBody}"
                           Text="{loc:T contactspage.bir-gorusme-kaydedilip-kime-ait-oldugunu-s}" />
            </StackPanel>
        </Grid>

        <!-- The divider IS the handle: a separate one-pixel line beside a drag target is two
             things where the eye sees one. -->
        <GridSplitter Grid.Column="1" Width="9" Margin="12,0" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent"
                      ShowsPreview="False" Cursor="SizeWE"
                      ToolTip="{loc:T contactspage.surukleyerek-genislet}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Detail -->
        <Grid Grid.Column="2">

            <!-- Nothing selected. -->
            <StackPanel Style="{StaticResource EmptyState}"
                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                <ui:SymbolIcon Symbol="Person24" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,16"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T contactspage.bir-kisi-sec}" />
                <TextBlock Style="{StaticResource EmptyBody}"
                           Text="{loc:T contactspage.soldaki-listeden-birini-sectiginde-o-kisiy}" />
            </StackPanel>

            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Style="{StaticResource HeroCard}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource AvatarLarge}" Margin="0,0,16,0"
                                Background="{Binding SelectedContact.Name, Converter={StaticResource NameBrush}}">
                            <TextBlock Style="{StaticResource AvatarTextLarge}"
                                       Text="{Binding SelectedContact.Name, Converter={StaticResource Initials}}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedContact.Name}" FontWeight="SemiBold"
                                       FontSize="{StaticResource TextTitle}" />
                            <TextBlock Text="{Binding SelectedContact.Detail}" Style="{StaticResource Secondary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!--
                                Moving a call to another person lives in the call's own right-click
                                menu, not here.

                                It is still an ordinary repair — all the messengers offer for
                                attribution is a window title, and a title is sometimes the person,
                                sometimes the conversation that happened to be open, and sometimes
                                an unread counter — but this toolbar sits beside the contact
                                heading, where nothing on screen says which call it would act on.
                                A menu names its target by being opened on it.
                            -->
                            <!-- Two verbs, because they are two different jobs: audio → text
                                 costs hours and re-uploads, text → ledger costs a minute and
                                 never touches the audio. One "Yeniden işle" hid that choice. -->
                            <ui:Button Content="{loc:T contactspage.disa-aktar}" Margin="0,0,8,0" Click="Export_Click"
                                       ToolTip="{loc:T contactspage.bu-kisinin-gorusmelerini-obsidian-kasasina}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Save24" />
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Appearance="Danger" Click="DeleteContact_Click"
                                       ToolTip="{loc:T contactspage.bu-kisiye-ait-her-seyi-kalici-olarak-sil}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Three views of one contact. -->
                <TabControl Grid.Row="1" Padding="0,12,0,0">

                    <!-- calls and transcript -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Call24" FontSize="16" Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T contactspage.gorusmeler}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
<Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--
                                The call list, with its own filters above it.

                                A person you speak to often accumulates hundreds of conversations
                                and they all look the same in a list: a date and a duration. The
                                text box searches inside the transcripts of *this contact's*
                                calls, so "on sekiz bin" narrows two hundred rows to the one
                                where a number was agreed.
                            -->
                            <Grid Grid.Column="0" Margin="0,0,14,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ui:TextBox Grid.Row="0" Margin="0,0,0,6"
                                            PlaceholderText="{loc:T contactspage.bu-kisiyle-konusulanlarda-ara}"
                                            Text="{Binding CallFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}">
                                    <ui:TextBox.Icon>
                                        <ui:SymbolIcon Symbol="Search24" />
                                    </ui:TextBox.Icon>
                                </ui:TextBox>

                                <ComboBox Grid.Row="1" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Periods}"
                                          SelectedItem="{Binding CallPeriod}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource PeriodName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!--
                                    What the filters are hiding, and one click to stop hiding it.

                                    Without this line a filter left on from ten minutes ago looks
                                    exactly like a contact who has only had two conversations —
                                    and the natural conclusion is that recordings have gone
                                    missing.
                                -->
                                <Border Grid.Row="2" Margin="0,0,0,8"
                                        Visibility="{Binding IsFilteringCalls, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Style="{StaticResource Caption}"
                                                   Text="{Binding HiddenCallText}" />

                                        <ui:Button Grid.Column="1" Content="{loc:T contactspage.suzgeci-kaldir}"
                                                   Appearance="Transparent" Padding="6,2"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Command="{Binding ClearCallFiltersCommand}" />
                                    </Grid>
                                </Border>

                            <ListBox Grid.Row="3" Style="{StaticResource CleanList}"
                                     ItemsSource="{Binding Calls}" SelectedItem="{Binding SelectedCall}">

                                <!--
                                    The per-call actions, on the call itself.

                                    The toolbar above has the same commands, but a toolbar is the
                                    wrong place to look when the thing you have noticed is a
                                    particular row filed under the wrong person. Right-clicking the
                                    row is where a Windows user reaches first, and putting the
                                    action on the object removes the step of hunting for it.

                                    The menu is on the list rather than on the item: a ContextMenu
                                    inside an ItemContainerStyle's Setter.Value cannot carry
                                    compiled Click handlers, and fails while the page is built.
                                    The EventSetter selects the row under the cursor first, so the
                                    menu always acts on what was right-clicked — without it, "move
                                    this to somebody else" would quietly move a different call.
                                -->
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:T contactspage.gorusmeyi-ac}" Click="OpenCall_Click" FontWeight="SemiBold">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Open24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />

                                        <!-- Onto the first screen's important pile — the one part
                                             of this archive a person arranges themselves. -->
                                        <MenuItem Header="{loc:T contactspage.onemlilere-ekle}" Click="AddToBoard_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Board24" />
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <Separator />
                                        <MenuItem Header="{loc:T contactspage.baska-kisiye-tasi}" Click="MoveCall_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="PersonSwap24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <!-- Two different jobs, two different verbs. A single
                                             "Yeniden işle" hid the question the dialog would
                                             then ask anyway; the menu can answer it here. -->
                                        <MenuItem Header="{loc:T contactspage.yeniden-yaziya-cevir}" Click="Retranscribe_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ArrowSync24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{loc:T contactspage.yeniden-cozumle}" Click="Reanalyse_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Lightbulb24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{loc:T contactspage.ses-dosyasinin-yerini-ac}" Click="ShowInFolder_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="FolderOpen24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{loc:T contactspage.gorusmeyi-sil}" Click="DeleteCall_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="CallRow_RightClick" />

                                        <!-- Double-click opens the conversation on its own. The
                                             column beside a contact is the right shape for browsing
                                             and the wrong one for reading: a call somebody opened
                                             deliberately is one they mean to work through. -->
                                        <EventSetter Event="MouseDoubleClick" Handler="CallRow_DoubleClick" />
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontWeight="SemiBold"
                                                           FontSize="{StaticResource TextSecondary}"
                                                           Text="{Binding StartedAt, Converter={StaticResource RelativeDate}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Length}" VerticalAlignment="Center"
                                                           FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                                           FontSize="{StaticResource TextCaption}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <!-- Visible, not hidden in the right-click menu: the
                                                     user asked for a delete they could see. -->
                                                <ui:Button Grid.Column="2" Appearance="Transparent" Padding="4,0" Margin="6,-4,-6,-4"
                                                           ToolTip="{loc:T contactspage.gorusmeyi-sil}" Click="DeleteCall_Click">
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </ui:Button>
                                            </Grid>
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                                            <!-- The user's labels, on this list too: a call marked
                                                 "tehdit" must be findable wherever calls are. -->
                                            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,3,0,0"
                                                          Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Pill}" Margin="0,0,4,2"
                                                                Background="{Binding Converter={StaticResource TagBrush}}"
                                                                Cursor="Hand" MouseLeftButtonUp="TagPill_Click"
                                                                ToolTip="{loc:T contactspage.bu-etiketi-tasiyan-gorusmeleri-ara}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="{Binding Converter={StaticResource TagIcon}}"
                                                                               FontSize="11" Foreground="White" Margin="0,0,3,0"
                                                                               VerticalAlignment="Center" />
                                                                <TextBlock Style="{StaticResource PillText}"
                                                                           Foreground="White" Text="{Binding}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Grid>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--
                                    The conversation first, at full height; the machine's summary
                                    behind a tab. Stacked above the transcript the summary cost
                                    the one thing this pane is for — reading what was actually
                                    said — and the user put it plainly: "özet burda tab olsun,
                                    konuşmayı daraltıyor". The player stays outside the tabs:
                                    evidence is never behind a click.
                                -->
                                <TabControl Grid.Row="0" Style="{StaticResource SegmentedTabs}"
                                            Padding="0,10,0,0">
                                    <TabItem Header="{loc:T contactspage.konusma}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!--
                                                Who did the talking, thin, above the words. It came
                                                back out of the Özet tab by request — slimmed to one
                                                bar and one line, it costs the transcript almost
                                                nothing and answers its question at a glance.
                                            -->
                                            <StackPanel Grid.Row="0" Margin="0,0,0,10"
                                                        Visibility="{Binding HasTalkStats, Converter={StaticResource BoolToVisibility}}">
                                                <Grid Height="6" Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding TalkRatio, Converter={StaticResource RatioStar}, ConverterParameter=me}" />
                                                        <ColumnDefinition Width="{Binding TalkRatio, Converter={StaticResource RatioStar}, ConverterParameter=them}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource MeBrush}"
                                                            CornerRadius="3,0,0,3" />
                                                    <Border Grid.Column="1" Background="{DynamicResource ThemBrush}"
                                                            CornerRadius="0,3,3,0" />
                                                </Grid>

                                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                                    <Run Text="{Binding TalkSummary, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding InterruptionSummary, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Text="{Binding TranscriptMessage}"
                                                       Style="{StaticResource Secondary}" Margin="0,0,0,8"
                                                       Visibility="{Binding TranscriptMessage, Converter={StaticResource NullToCollapsed}}" />

                                            <!--
                                                The transcript.

                                                Speaker colour on the leading edge, the name beside
                                                it, and a clickable timestamp. Colour is never the
                                                only signal: the name is always written, so the
                                                transcript survives being printed or read by
                                                somebody who cannot tell the two colours apart.
                                            -->
                                            <ListBox Grid.Row="2" Style="{StaticResource CleanList}"
                                                     ItemsSource="{Binding Transcript}"
                                                     Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,12,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource ThemBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource MeBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <StackPanel Grid.Column="1" Width="92" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold"
                                                               FontSize="{StaticResource TextSecondary}"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Style="{StaticResource TimeLink}" Margin="0,2,0,0"
                                                               Text="{Binding Timestamp}"
                                                               ToolTip="{loc:T contactspage.bu-andan-itibaren-dinle}">
                                                        <TextBlock.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.PlayFromCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                          CommandParameter="{Binding StartMs}" />
                                                        </TextBlock.InputBindings>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                               FontSize="{StaticResource TextSecondary}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Warning}" Style="{StaticResource Caption}"
                                                               FontStyle="Italic" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="{loc:T contactspage.ozet}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <Border Style="{StaticResource Panel}"
                                                        Visibility="{Binding Summary, Converter={StaticResource NullToCollapsed}}">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                            <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" Margin="0,0,8,0"
                                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                            <TextBlock Text="{loc:T contactspage.ozet}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- The talk-share strip lives above the
                                                     transcript now, by request; this tab keeps
                                                     only what has no other home. -->

                                                <TextBlock Text="{loc:T contactspage.bu-gorusme-icin-ozet-yok-cozumleme-calisin}"
                                                           Margin="0,4,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Summary}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>

                                    <!-- The selected call's open suggestions — same rows as the
                                         call window, revised in when the action layer arrived.
                                         Yaptım/Gizle work here; routing keeps its dialogs there. -->
                                    <TabItem Header="{loc:T contactspage.aksiyonlar}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <Border Style="{StaticResource Panel}"
                                                        Visibility="{Binding HasCallActions, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                                                   Text="{loc:T contactspage.oneridir-sen-onaylamadan-hicbir-yere-yazil}" />

                                                        <ItemsControl ItemsSource="{Binding CallActions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderThickness="0,0,0,1" Padding="0,8"
                                                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <ui:SymbolIcon Grid.Column="0" Symbol="{Binding KindIcon}" FontSize="15"
                                                                                           Margin="0,2,10,0" VerticalAlignment="Top"
                                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                                                            <StackPanel Grid.Column="1">
                                                                                <TextBlock Text="{Binding Action}" TextWrapping="Wrap" />
                                                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}"
                                                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                                                           Visibility="{Binding Reason, Converter={StaticResource NullToCollapsed}}" />
                                                                                <TextBlock Text="{Binding DeadlineText}" Style="{StaticResource Caption}"
                                                                                           Margin="0,2,0,0"
                                                                                           Visibility="{Binding HasDeadline, Converter={StaticResource BoolToVisibility}}" />
                                                                            </StackPanel>

                                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                                                <ui:Button Content="{loc:T contactspage.yaptim}" Padding="8,3" Margin="0,0,4,0"
                                                                                           Click="CallActionDone_Click" />
                                                                                <ui:Button Content="{loc:T contactspage.gizle}" Padding="8,3" Appearance="Transparent"
                                                                                           Click="CallActionHide_Click"
                                                                                           ToolTip="{loc:T contactspage.bir-daha-onerilmez}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="{loc:T contactspage.bu-gorusme-icin-acik-oneri-yok-cozumleme-s}"
                                                           Margin="0,4,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCallActions}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>

                                <!--
                                    The player.

                                    Two mirrored waveforms: you above the line, the other party
                                    below. No recorder that captures a call as one mixed stream
                                    can draw this, because it does not know whose sound is whose
                                    at any moment. Here it is two files, so the shape is a fact.

                                    Outside the tabs, always in reach: evidence is never behind a
                                    click.
                                -->
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ledger -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Flag24" FontSize="16" Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T contactspage.defter}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
<Grid Margin="0,12,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasFlags, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Flags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SettingCard}" Padding="16,14">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Style="{StaticResource Pill}"
                                                                Margin="0,0,10,0" VerticalAlignment="Top">
                                                            <TextBlock Style="{StaticResource PillText}"
                                                                       Text="{Binding Kind}" />
                                                        </Border>

                                                        <TextBlock Grid.Column="1" Text="{Binding Summary}"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                                   FontSize="{StaticResource TextBody}" />

                                                        <!--
                                                            The timestamp plays the moment, and the
                                                            entry can be dismissed.

                                                            Both commands existed and neither was
                                                            bound to anything. The timestamp was
                                                            already drawn in the link style — accent
                                                            colour, hand cursor, underline on hover —
                                                            so it invited a click and answered with
                                                            nothing, on the one screen whose whole
                                                            argument is that every claim can be
                                                            checked against the recording.

                                                            Dismissal matters as much: without it
                                                            false positives pile up until the ledger
                                                            is noise and gets ignored, and the real
                                                            findings go with it.
                                                        -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    Margin="10,0,0,0" VerticalAlignment="Top">
                                                            <TextBlock Style="{StaticResource TimeLink}"
                                                                       Text="{Binding Timestamp}"
                                                                       ToolTip="{loc:T contactspage.bu-andan-itibaren-dinle}">
                                                                <TextBlock.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick"
                                                                                  Command="{Binding DataContext.PlayFlagCommand,
                                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                  CommandParameter="{Binding}" />
                                                                </TextBlock.InputBindings>
                                                            </TextBlock>

                                                            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                                    ToolTip="{loc:T contactspage.bu-kaydi-defterden-kaldir}"
                                                                    Command="{Binding DataContext.DismissFlagCommand,
                                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- The quote travels with the claim, always. A
                                                         ledger line without the words it rests on
                                                         is an accusation. -->
                                                    <Border Style="{StaticResource QuoteBlock}"
                                                            BorderBrush="{DynamicResource ThemBrush}">
                                                        <TextBlock Style="{StaticResource QuoteText}"
                                                                   Text="{Binding Quote}" />
                                                    </Border>

                                                    <Border Style="{StaticResource QuoteBlock}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            Visibility="{Binding HasCounter, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel>
                                                            <TextBlock Text="{loc:T contactspage.daha-once}" Style="{StaticResource Caption}" />
                                                            <TextBlock Style="{StaticResource QuoteText}"
                                                                       Text="{Binding CounterQuote}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Text="{Binding Caveat}" Style="{StaticResource Caption}"
                                                               Margin="0,8,0,0" FontStyle="Italic"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                               Visibility="{Binding HasCaveat, Converter={StaticResource BoolToVisibility}}" />

                                                    <!--
                                                        The moment itself, as a file.

                                                        A claim about a conversation is worth what
                                                        its evidence is worth. "You said eighteen
                                                        thousand" is an argument; eight seconds of
                                                        somebody saying it is not. Cut from the
                                                        mixed recording so the exchange is audible
                                                        — a promise with the question that
                                                        prompted it removed is a different
                                                        promise.
                                                    -->
                                                    <ui:Button Content="{loc:T contactspage.sesi-disa-aktar}"
                                                               Appearance="Transparent"
                                                               HorizontalAlignment="Left"
                                                               Margin="0,10,0,0" Padding="8,4"
                                                               FontSize="{StaticResource TextCaption}"
                                                               Tag="{Binding}"
                                                               Click="ExportClip_Click">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="MusicNote224" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Style="{StaticResource EmptyState}"
                                        Visibility="{Binding HasFlags, Converter={StaticResource InverseBoolToVisibility}}">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="36" HorizontalAlignment="Center"
                                               Margin="0,0,0,14"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T contactspage.defter-bos}" />
                                <TextBlock Style="{StaticResource EmptyBody}"
                                           Text="{loc:T contactspage.bu-kisiyle-olan-gorusmelerde-tutulmamis-so}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- open commitments -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ClipboardTaskListLtr24" FontSize="16" Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T contactspage.acik-sozler}" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
<Grid Margin="0,12,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding OpenCommitments.Count, Converter={StaticResource CountToVisibility}}">
                                <ItemsControl ItemsSource="{Binding OpenCommitments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SettingCard}" Padding="16,14">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Obligation}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               FontSize="{StaticResource TextBody}" />
                                                    <Border Style="{StaticResource QuoteBlock}"
                                                            BorderBrush="{DynamicResource ThemBrush}">
                                                        <TextBlock Style="{StaticResource QuoteText}"
                                                                   Text="{Binding Quote}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Style="{StaticResource EmptyState}"
                                        Visibility="{Binding OpenCommitments.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}">
                                <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T contactspage.acik-soz-yok}" />
                                <TextBlock Style="{StaticResource EmptyBody}"
                                           Text="{loc:T contactspage.bu-kisinin-verdigi-ve-hala-bekleyen-bir-so}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- Outside the tabs: audio started from the ledger used to play with no
                     pause, no scrubber and no position on screen. -->
                <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,10,0,0"
                        Visibility="{Binding Playback.IsLoaded, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Grid x:Name="WaveformHost" Height="40" Margin="0,0,0,8"
                              Background="Transparent"
                              controls:Scrubbable.Player="{Binding Playback}"
                              Cursor="Hand"
                              ToolTip="{loc:T contactspage.tikla-oradan-dinle}">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="1000" Height="68">
                                    <Polygon Points="{Binding Playback.MicShape}"
                                             Fill="{DynamicResource MeBrush}" Opacity="0.85" />
                                    <Polygon Points="{Binding Playback.FarShape}"
                                             Fill="{DynamicResource ThemBrush}" Opacity="0.85" />

                                    <!-- Centre line, so the two bands read as one timeline. -->
                                    <Line X1="0" Y1="34" X2="1000" Y2="34" StrokeThickness="0.6"
                                          Stroke="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                    <Line Y1="0" Y2="68" StrokeThickness="1.6"
                                          X1="{Binding Playback.PlayheadX}"
                                          X2="{Binding Playback.PlayheadX}"
                                          Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" ToolTip="{loc:T contactspage.10-saniye-geri}"
                                        Command="{Binding Playback.SkipBackCommand}">
                                    <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="16" />
                                </Button>

                                <Button Style="{StaticResource GhostButton}" Margin="2,0"
                                        Command="{Binding Playback.TogglePlayCommand}"
                                        ToolTip="{loc:T contactspage.cal-duraklat}">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Play24" FontSize="18"
                                                       Visibility="{Binding Playback.IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ui:SymbolIcon Symbol="Pause24" FontSize="18"
                                                       Visibility="{Binding Playback.IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource GhostButton}" ToolTip="{loc:T contactspage.10-saniye-ileri}"
                                        Command="{Binding Playback.SkipForwardCommand}">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                       FontSize="{StaticResource TextSecondary}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding Playback.PositionText, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Playback.DurationText, Mode=OneWay}" />
                            </TextBlock>

                            <!--
                                Which of the three recordings is being heard.

                                All three cover the same stretch of time, so this
                                keeps the moment and changes only the voice. It
                                opens on the whole conversation, because that is
                                what somebody means when they say they want to
                                hear a call; the single sides are there for
                                pulling one voice out of a passage where the two
                                talked over each other.
                            -->
                            <ui:Button Grid.Column="2" Appearance="Transparent"
                                       Command="{Binding Playback.SwitchSpeakerCommand}"
                                       ToolTip="{loc:T contactspage.tum-gorusme-sen-karsi-taraf-arasinda-gecis}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Playback.Channel}" Value="Me">
                                                        <Setter Property="Background" Value="{DynamicResource MeBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Playback.Channel}" Value="Them">
                                                        <Setter Property="Background" Value="{DynamicResource ThemBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="{StaticResource TextSecondary}"
                                               Text="{Binding Playback.ChannelName}" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3" Text="{Binding PlaybackMessage}"
                           Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Visibility="{Binding PlaybackMessage, Converter={StaticResource NullToCollapsed}}" />

            </Grid>
        </Grid>
    </Grid>
</UserControl>
