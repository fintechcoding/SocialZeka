<ui:FluentWindow x:Class="VoiceTranscript.App.Views.TagManagerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{loc:T tagmanagerwindow.etiketler}"
                 Width="560" Height="600" MinWidth="480" MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <!--
        The tag wardrobe: name, icon, colour — Outlook's category editor, for this archive.

        Rows here are definitions, not taggings. Deleting one never touches a conversation;
        the word keeps working, dressed in a hashed colour instead of a chosen one.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:T tagmanagerwindow.etiketler}" ShowMinimize="False" ShowMaximize="False" />

        <TextBlock Grid.Row="1" Margin="20,8,20,10" TextWrapping="Wrap"
                   Style="{StaticResource Caption}"
                   Text="{loc:T tagmanagerwindow.bu-liste-etiketlerin-gorunusudur-adi-simge}" />

        <Border Grid.Row="2" Margin="20,0,20,0" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Rows" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- The pill as it will actually look, updating as you edit. -->
                                <Border Grid.Column="0" CornerRadius="10" Padding="8,3"
                                        Margin="0,0,10,0" VerticalAlignment="Center"
                                        Background="{Binding Brush}">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="13"
                                                   Foreground="White" />
                                </Border>

                                <ui:TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{loc:T tagmanagerwindow.etiket-adi}" Margin="0,0,8,0"
                                            VerticalAlignment="Center" />

                                <ComboBox Grid.Column="2" Width="86" Margin="0,0,8,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding Icons}" SelectedItem="{Binding Icon}"
                                          ToolTip="{loc:T tagmanagerwindow.simge}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <ui:SymbolIcon Symbol="{Binding Converter={StaticResource SymbolFromName}}"
                                                           FontSize="15" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ComboBox Grid.Column="3" Width="120" Margin="0,0,8,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding Colors}" SelectedItem="{Binding ColorChoice}"
                                          ToolTip="{loc:T tagmanagerwindow.renk}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="12" Height="12" CornerRadius="2" Margin="0,0,6,0"
                                                        Background="{Binding Brush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ui:Button Grid.Column="4" Appearance="Transparent" Padding="6,4"
                                           Click="RemoveRow_Click" ToolTip="{loc:T tagmanagerwindow.tanimi-sil}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Delete24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="20,12,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0" Content="{loc:T tagmanagerwindow.yeni-etiket}" HorizontalAlignment="Left"
                       Click="AddRow_Click">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:Button Grid.Column="1" Content="{loc:T tagmanagerwindow.vazgec}" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <ui:Button Grid.Column="2" Content="{loc:T tagmanagerwindow.kaydet}" Appearance="Primary" IsDefault="True"
                       Click="Save_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
