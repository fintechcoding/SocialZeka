<UserControl x:Class="VoiceTranscript.App.Views.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CalendarViewModel}">

    <!--
        The month, full size, with the picked day unpacked beside it.

        The grid takes the room and the agenda column is fixed: a calendar is read as a shape
        first — which week is crowded, which is clear — and the shape needs the width. The
        agenda keeps its place so clicking through days compares them in the same spot.
    -->
    <Grid Margin="24,4,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Takvim" Style="{StaticResource PageTitle}" />

            <!-- Month navigation. The title doubles as the way home, like the mini calendar. -->
            <Grid Grid.Row="1" Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Appearance="Transparent" Padding="8,4"
                           Command="{Binding PrevMonthCommand}" ToolTip="Önceki ay">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ChevronLeft24" />
                    </ui:Button.Icon>
                </ui:Button>

                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                           FontSize="{StaticResource TextTitle}" MinWidth="150"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="8,0" />

                <ui:Button Grid.Column="2" Appearance="Transparent" Padding="8,4"
                           Command="{Binding NextMonthCommand}" ToolTip="Sonraki ay">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ChevronRight24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button Grid.Column="4" Content="Bugün" Command="{Binding TodayCommand}"
                           ToolTip="Bu aya dön ve bugünü seç" />
            </Grid>

            <UniformGrid Grid.Row="2" Columns="7" Margin="0,0,0,4">
                <TextBlock Text="Pzt" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                <TextBlock Text="Sal" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                <TextBlock Text="Çar" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                <TextBlock Text="Per" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                <TextBlock Text="Cum" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                <TextBlock Text="Cmt" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                <TextBlock Text="Paz" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            </UniformGrid>

            <ItemsControl Grid.Row="3" ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="4" Margin="1" Padding="6,4" BorderThickness="1"
                                Cursor="Hand" ClipToBounds="True"
                                MouseLeftButtonUp="Day_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </DataTrigger>

                                        <!-- Last, so the pick outdraws the today tint. -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="Background"
                                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,0,0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InMonth}" Value="False">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Up to three one-liners; the count line owns the rest. -->
                                <ItemsControl ItemsSource="{Binding Preview}" IsHitTestVisible="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                           FontSize="10" Margin="0,0,3,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding BrushKey, Converter={StaticResource BrushFromKey}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Line}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <!-- Suggestions stay visually weaker
                                                                     than anything the user wrote. -->
                                                                <DataTrigger Binding="{Binding IsSuggestion}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding MoreText}" Style="{StaticResource Caption}"
                                           Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- The picked day, unpacked. Every row is a way in, not just a report. -->
        <Border Grid.Column="1" Style="{StaticResource Panel}" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding SelectedDayHeader}" FontWeight="SemiBold"
                           FontSize="{StaticResource TextBody}" Margin="2,0,0,8"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Ayrıntı için bir güne tıkla." Style="{StaticResource Caption}"
                                   Margin="2,0"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />

                        <TextBlock Text="Bu günde bir şey yok." Style="{StaticResource Caption}"
                                   Margin="2,0"
                                   Visibility="{Binding SelectedDayIsEmpty, Converter={StaticResource BoolToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding Agenda}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" CornerRadius="4" Padding="8,6"
                                            Cursor="Hand" MouseLeftButtonUp="AgendaRow_Click"
                                            ToolTip="{Binding OpenHint}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                       Margin="0,1,8,0" VerticalAlignment="Top"
                                                       Foreground="{Binding BrushKey, Converter={StaticResource BrushFromKey}}" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Line}" TextWrapping="Wrap"
                                                           FontSize="{StaticResource TextSecondary}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSuggestion}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}"
                                                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
