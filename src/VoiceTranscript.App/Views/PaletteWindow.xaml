<ui:FluentWindow x:Class="VoiceTranscript.App.Views.PaletteWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Komutlar"
                 Width="560" Height="380"
                 WindowStartupLocation="Manual"
                 WindowStyle="None" ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic">

    <!--
        The Ctrl+K palette: one box, everything reachable — pages, verbs, people. Modeled on
        the reflex every modern Windows app has taught hands to expect; matching goes through
        the product's own Turkish folding so "isaret" finds "İşaretler".
    -->
    <Border CornerRadius="8" BorderThickness="1" Padding="10"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TextBox Grid.Row="0" x:Name="QueryBox" PlaceholderText="Komut ya da kişi ara…"
                        FontSize="{StaticResource TextBody}" TextChanged="Query_TextChanged"
                        PreviewKeyDown="Query_KeyDown">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <ListBox Grid.Row="1" x:Name="Results" Style="{StaticResource CleanList}"
                     Margin="0,8,0,0" MouseLeftButtonUp="Results_Click">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon}" FontSize="16"
                                           Margin="2,0,12,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</ui:FluentWindow>
