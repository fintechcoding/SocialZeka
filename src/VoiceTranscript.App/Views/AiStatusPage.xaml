<UserControl x:Class="VoiceTranscript.App.Views.AiStatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AiStatusViewModel}">

    <UserControl.Resources>
        <!--
            One row per service, in the order it will actually be tried.

            The number is the point of the row. Hosted transcription endpoints are attempted in
            sequence, so the second one is what runs when the first is out of credit — and somebody
            who configured three of them expressed a preference they have never been able to see.
        -->
        <DataTemplate x:Key="ServiceRow" DataType="{x:Type vm:AiServiceRow}">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                    <TextBlock Text="{Binding Order}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="{StaticResource TextCaption}" FontWeight="SemiBold" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />

                        <!-- Which one will actually run. Everything below it is a fallback. -->
                        <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="3"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="etkin" FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>

                        <!-- Said on every row that has it, not once at the top. The question
                             "does this conversation leave the machine" is asked per service. -->
                        <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="3"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                Visibility="{Binding SendsDataOffMachine, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ses makineden çıkar" FontSize="{StaticResource TextCaption}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Ellipse Grid.Column="2" Width="8" Height="8" Margin="12,0,8,0" VerticalAlignment="Center"
                         Fill="{Binding ReachBrushKey, Converter={StaticResource BrushFromKey}}" />

                <TextBlock Grid.Column="3" Text="{Binding ReachText}" VerticalAlignment="Center"
                           MinWidth="96" Style="{StaticResource Caption}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,18,24">
        <StackPanel MaxWidth="{StaticResource PageMeasure}" HorizontalAlignment="Left">

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Hangi yapay zekâ çalışıyor" FontWeight="SemiBold"
                               FontSize="{StaticResource TextSubtitle}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Text="Sıra, gerçekten denenecek sıradır. Üstteki yanıt vermezse bir alttakine geçilir." />
                </StackPanel>

                <!-- On demand, never on a timer. These are calls against services somebody is
                     paying for; polling them to keep a dot green would be spending their money
                     to decorate a screen. -->
                <!-- Beside the test, because the two are one gesture: test, see it fail, fix it.
                     Sending somebody to hunt for Settings in between is where people give up. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Content="Ayarla" Margin="0,0,8,0"
                           Command="{Binding OpenSettingsCommand}"
                           ToolTip="Bu servislerin ayarlarını açar.">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button Content="Bağlantıları sına"
                           Command="{Binding CheckCommand}"
                           IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBool}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="PlugConnected24" />
                    </ui:Button.Icon>
                </ui:Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="16" Margin="0,0,8,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Yazıya dökme" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Transcription}"
                                  ItemTemplate="{StaticResource ServiceRow}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:SymbolIcon Symbol="Lightbulb24" FontSize="16" Margin="0,0,8,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Çözümleme" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Switched off is a choice, not a fault, and it must not read as one. -->
                    <Border Padding="10" CornerRadius="4" Margin="0,0,0,6"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding AnalysisDisabled, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}"
                                   Text="Otomatik çözümleme kapalı. Görüşmeler yazıya dökülüyor ama özet ve defter çıkarılmıyor. Ayarlar → Çözümleme bölümünden açılır." />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Analysis}"
                                  ItemTemplate="{StaticResource ServiceRow}" />

                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Çözümleme yapılmazsa görüşme yine yazıya dökülür ve metin saklanır; sonradan bir servis bağlandığında yalnızca çözümleme tekrarlanır, ses yeniden işlenmez." />
                </StackPanel>
            </Border>

            <!--
                ==================== what it has actually cost ====================

                Two figures the application knew and never said.

                Transcription speed is the important one. On a machine without a usable GPU this
                runs several times slower than real time — a forty-seven minute call once took
                three and a half hours — and while that is happening a working application is
                indistinguishable from a hung one. Stating the measured multiple turns "it seems
                stuck" into "it is running at 0.4×, which for this hardware is expected".

                Token counts are the other. A hosted model spends real money silently, and the
                first notice used to be the monthly bill.
            -->
            <TextBlock Text="Kullanım" Style="{StaticResource GroupHeader}" Margin="0,20,0,0" />

            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Text="{Binding WindowName}" />

                        <!-- Three lengths rather than a calendar. The questions actually asked
                             here are "what has this week been like", "is it keeping up this
                             month", and "what has all of it cost". -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="7 gün" Margin="0,0,6,0" Command="{Binding ShowWeekCommand}" />
                            <ui:Button Content="30 gün" Margin="0,0,6,0" Command="{Binding ShowMonthCommand}" />
                            <ui:Button Content="Tümü" Command="{Binding ShowEverythingCommand}" />
                        </StackPanel>
                    </Grid>

                    <!--
                        One bar per day, scaled to the busiest day in view.

                        Scaled to the window rather than to a fixed maximum: the point is the shape
                        of this person's own weeks, and a scale chosen for a different archive would
                        flatten theirs into a line. Empty days are drawn as gaps rather than
                        skipped, because a fortnight of silence is a fact about the archive and
                        compressing it out would make a sporadic month look continuous.
                    -->
                    <Border Margin="0,0,0,14" Padding="12,10" CornerRadius="6"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding HasChart, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Günlük işlenen ses" Style="{StaticResource Caption}"
                                       Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding Days}" Height="96">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="14" Margin="2,0" VerticalAlignment="Bottom"
                                                CornerRadius="2,2,0,0"
                                                Height="{Binding Height}"
                                                ToolTip="{Binding Tooltip}"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{Binding Days[0].Label}" />

                                <TextBlock Grid.Column="1" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="bugün" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Yazıya dökme" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding TranscribeLine}" TextWrapping="Wrap" Margin="0,2,0,0" />

                        <TextBlock Text="{Binding SpeedLine}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding SpeedLine, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Style.Triggers>
                                        <!-- Below real time is a fact worth colouring: it means the
                                             backlog grows for as long as calls keep being made. -->
                                        <DataTrigger Binding="{Binding SpeedIsPoor}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Per engine, because "transcription is slow" is not actionable and
                             "the local model runs at 0.4× and the hosted one at 12×" is. -->
                        <ItemsControl ItemsSource="{Binding Engines}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Engine}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource Caption}" />

                                        <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                   Style="{StaticResource Caption}"
                                                   FontFamily="Consolas, Cascadia Mono, Segoe UI">
                                            <Run Text="{Binding Runs, Mode=OneWay}" /><Run Text=" görüşme · " /><Run
                                                Text="{Binding SpeedFactor, Mode=OneWay, StringFormat='{}{0:0.0}×'}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,12" />

                        <TextBlock Text="Çözümleme" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding AnalyseLine}" TextWrapping="Wrap" Margin="0,2,0,0" />

                        <!-- Questions are the same paid endpoint spent for a different reason, so
                             they are counted apart: a bill that looks too large can then be traced
                             to whichever of the two caused it. -->
                        <TextBlock Text="{Binding AskLine}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Style="{StaticResource Caption}"
                                   Visibility="{Binding AskLine, Converter={StaticResource NullToCollapsed}}" />

                        <TextBlock Text="{Binding FailureLine}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Style="{StaticResource Caption}"
                                   Visibility="{Binding FailureLine, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}"
                               Visibility="{Binding HasUsage, Converter={StaticResource InverseBoolToVisibility}}"
                               Text="Henüz ölçülecek bir iş yapılmadı. İlk görüşme işlendiğinde burada hız, süre ve jeton sayıları görünür." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
