<ui:FluentWindow x:Class="VoiceTranscript.App.Views.ModelPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{loc:T modelpickerwindow.model-sec}"
                 Width="620" Height="600" MinWidth="480" MinHeight="400"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:T modelpickerwindow.model-sec}" />

        <StackPanel Grid.Row="1" Margin="20,8,20,10">
            <TextBlock x:Name="ProviderLine" FontWeight="SemiBold" />

            <!--
                A search box rather than a long list alone.

                OpenRouter publishes several hundred models across dozens of vendors, and the one
                somebody wants is found by typing part of a name they half-remember — "haiku",
                "gemini", "qwen" — not by scrolling. The filter runs over the identifier, the
                display name and the price line together, because "ucuz" and "128k" are things
                people search for and neither is in the identifier.
            -->
            <ui:TextBox x:Name="SearchBox" Margin="0,10,0,0"
                        PlaceholderText="{loc:T modelpickerwindow.ara-ad-saglayici-ya-da-fiyat}"
                        TextChanged="SearchBox_TextChanged"
                        KeyDown="SearchBox_KeyDown" />
        </StackPanel>

        <Border Grid.Row="2" Margin="20,0,20,0" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <ListBox x:Name="ModelList" Style="{StaticResource CleanList}"
                         BorderThickness="0" Background="Transparent"
                         MouseDoubleClick="ModelList_DoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold"
                                               FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- The few worth trying first, marked in place rather than
                                         split into a separate list: a search that finds nothing in
                                         a short list looks exactly like a search that found
                                         nothing at all. -->
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="3"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{loc:T modelpickerwindow.onerilen}" FontSize="10"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="Busy" Orientation="Horizontal" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" />
                    <TextBlock Text="{loc:T modelpickerwindow.model-listesi-aliniyor}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="Problem" Visibility="Collapsed" Margin="24"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="20,12,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CountLine" Grid.Column="0" VerticalAlignment="Center"
                       Style="{StaticResource Caption}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="{loc:T modelpickerwindow.yenile}" Margin="0,0,8,0" Click="Refresh_Click" />
                <ui:Button Content="{loc:T modelpickerwindow.vazgec}" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
                <ui:Button Content="{loc:T modelpickerwindow.sec}" Appearance="Primary" Click="Choose_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
