<ui:FluentWindow x:Class="VoiceTranscript.App.Views.CallWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
                 xmlns:controls="clr-namespace:VoiceTranscript.App.Controls"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:CallWindowViewModel}"
                 Title="Görüşme"
                 Width="880" Height="720" MinWidth="640" MinHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" />

        <StackPanel Grid.Row="1" Margin="20,4,20,0">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource TextTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
        </StackPanel>

        <TabControl Grid.Row="2" Margin="20,14,20,0" Padding="0,14,0,0"
                    Style="{StaticResource SegmentedTabs}">

            <!-- ================= the conversation ================= -->
            <TabItem Header="Görüşme">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        What produced this text, and how sure it was.

                        A transcript is evidence, and evidence with unstated provenance is worth
                        less than it looks. The uncertain share is the honest measure of whether
                        these words can be leaned on — which is why the button beside it is the one
                        that produces them again, with a different engine if you like.
                    -->
                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="12,8" CornerRadius="6"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding QualityLine, Converter={StaticResource NullToCollapsed}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="15" Margin="0,0,10,0"
                                           VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QualityIsPoor}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>

                            <TextBlock Grid.Column="1" Text="{Binding QualityLine}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Style="{StaticResource Caption}" />

                            <ui:Button Grid.Column="2" Content="Yeniden çevir" Appearance="Transparent"
                                       Margin="10,0,0,0" Click="Retranscribe_Click"
                                       ToolTip="Bu görüşmeyi başka bir motorla baştan yazıya döker." />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,4,10,4"
                                  Visibility="{Binding HasTurns, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Turns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        Laid out as an exchange because that is what it was. Mine on
                                        the right, theirs on the left — the arrangement everyone
                                        already reads without being taught.

                                        Clicking a bubble plays from it. Checking a sentence against
                                        the audio is the one action this product asks people to
                                        perform, so it has to cost one click; anything more and the
                                        verification simply does not happen.
                                    -->
                                    <Grid Margin="0,3">
                                        <Border MaxWidth="520" Padding="12,9" CornerRadius="8"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="Turn_Click"
                                                ToolTip="Bu andan itibaren dinle. Sağ tıkla: kesit çıkar."
                                                HorizontalAlignment="{Binding IsMe, Converter={StaticResource SpeakerAlignment}}"
                                                Background="{Binding IsMe, Converter={StaticResource SpeakerBackground}}">

                                            <!--
                                                Cutting an exchange out of a call.

                                                The unit is a line plus the replies that followed
                                                it, because that is the unit people argue about. An
                                                answer on its own invites "you took that out of
                                                context", and the answer to that has to be built
                                                into what gets exported rather than argued about
                                                afterwards — so the menu counts replies, and the
                                                words are written beside the audio with the date on
                                                them.
                                            -->
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Ses kesiti çıkar">
                                                        <MenuItem Header="Yalnızca bu satır" Tag="0"
                                                                  Click="ExportExchange_Click" />
                                                        <MenuItem Header="Bu satır ve cevabı" Tag="1"
                                                                  Click="ExportExchange_Click" />
                                                        <MenuItem Header="Bu satır ve sonraki 3" Tag="3"
                                                                  Click="ExportExchange_Click" />
                                                        <MenuItem Header="Bu satır ve sonraki 5" Tag="5"
                                                                  Click="ExportExchange_Click" />
                                                        <MenuItem Header="Bu satır ve sonraki 10" Tag="10"
                                                                  Click="ExportExchange_Click" />
                                                    </MenuItem>

                                                    <Separator />

                                                    <MenuItem Header="Bu andan itibaren dinle"
                                                              Click="PlayFromHere_Click" />
                                                    <MenuItem Header="Metni kopyala"
                                                              Click="CopyTurn_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold"
                                                               FontSize="{StaticResource TextCaption}" />
                                                    <TextBlock Text="{Binding Time}" Margin="8,0,0,0"
                                                               FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                                               FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                                    <!-- Marked rather than hidden: an uncertain line
                                                         is still evidence, and pretending otherwise
                                                         would quietly drop part of the conversation. -->
                                                    <TextBlock Text="· belirsiz" Margin="6,0,0,0"
                                                               FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                               Visibility="{Binding LowConfidence, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <!-- Follows the player, so somebody reading
                                                             along does not lose their place after a
                                                             seek. -->
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="BorderThickness" Value="2" />
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Style="{StaticResource EmptyState}"
                                Visibility="{Binding HasTurns, Converter={StaticResource InverseBoolToVisibility}}">
                        <ui:SymbolIcon Symbol="DocumentText24" FontSize="32" HorizontalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource EmptyTitle}" Text="{Binding TranscriptMessage}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ================= what was extracted ================= -->
            <TabItem Header="Çözümleme">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,10,4">
                    <StackPanel>

                        <!--
                            An action rather than an empty page.

                            A conversation with a transcript and no analysis is the ordinary state
                            when no model was connected at the time, and it was a dead end: the tab
                            said nothing and offered nothing. Analysing again works from the text,
                            so it costs a minute rather than the hours transcription would.
                        -->
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10"
                                Visibility="{Binding HasLedger, Converter={StaticResource InverseBoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Bu görüşme çözümlenmemiş" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Text="Metin hazır. Çözümleme sözleri, değişen rakamları ve işaretleri çıkarır — ses yeniden işlenmez, yalnızca metin okunur." />
                                </StackPanel>

                                <ui:Button Grid.Column="1" Content="Çözümle" Appearance="Primary"
                                           Margin="14,0,0,0" VerticalAlignment="Center"
                                           Click="Analyse_Click"
                                           IsEnabled="{Binding HasTurns}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Lightbulb24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10"
                                Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Özet" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                           Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10"
                                Visibility="{Binding Commitments.Count, Converter={StaticResource CountToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Sözler" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Commitments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <TextBlock Text="{Binding Obligation}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Quote}" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}"
                                Visibility="{Binding Flags.Count, Converter={StaticResource CountToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="İşaretler" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Flags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Quote}" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Style="{StaticResource EmptyState}"
                                    Visibility="{Binding HasLedger, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource EmptyTitle}" Text="Bu görüşmeden çıkarılmış bir kayıt yok." />
                            <TextBlock Style="{StaticResource EmptyBody}"
                                       Text="Söz verilmemiş, rakam ya da tarih geçmemiş bir konuşmada bu normaldir." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= questions about this call ================= -->
            <TabItem Header="Sor">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,4,10,4">
                        <ItemsControl ItemsSource="{Binding Conversation}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" Padding="12,9" CornerRadius="8" MaxWidth="560"
                                            HorizontalAlignment="{Binding FromUser, Converter={StaticResource SpeakerAlignment}}"
                                            Background="{Binding FromUser, Converter={StaticResource SpeakerBackground}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />

                                            <!-- The quotes are not decoration. An answer without them
                                                 is this product doing the one thing it exists not to
                                                 do: telling somebody what happened and asking to be
                                                 believed. -->
                                            <ItemsControl ItemsSource="{Binding Citations}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasCitations, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,3,0,0" Padding="8,5" CornerRadius="4"
                                                                Cursor="Hand"
                                                                MouseLeftButtonUp="Citation_Click"
                                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                           Style="{StaticResource Caption}" />
                                                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                           Text="dinlemek için tıkla" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1" Text="{Binding AskProblem}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding AskProblem, Converter={StaticResource NullToCollapsed}}" />

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Margin="0,0,8,0"
                                    PlaceholderText="Bu görüşme hakkında sor — cevap alıntılarla gelir"
                                    Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                                    KeyDown="Question_KeyDown" />

                        <ui:Button Grid.Column="1" Content="Sor" Appearance="Primary"
                                   Command="{Binding AskCommand}"
                                   IsEnabled="{Binding IsAsking, Converter={StaticResource InverseBool}}" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= notes ================= -->
            <TabItem Header="Notlar">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Said plainly, because it is the one guarantee that makes notes worth
                         writing: reprocessing replaces the summary, the commitments and the flags,
                         and never touches this. -->
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,8"
                               Text="Buraya yazdıkların sana aittir. Görüşme yeniden çözümlense bile silinmez." />

                    <TextBox Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" Padding="10"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock Text="Kaydedildi" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Visibility="{Binding NoteSaved, Converter={StaticResource BoolToVisibility}}" />

                        <ui:Button Content="Notu kaydet" Appearance="Primary" Command="{Binding SaveNoteCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- The player stays put across tabs: somebody asking a question about a passage should
             not lose the passage by changing tab to ask. -->
        <Border Grid.Row="3" Margin="20,12,20,16" Padding="12,10" CornerRadius="6"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <StackPanel>

                <!--
                    What the pipeline is doing to this conversation, while it does it.

                    This strip replaced a dialog that said "close the window and open it again
                    to see the result" — the application describing its own missing feature.
                    Now the request is watched from the window that made it: stage, progress,
                    and on failure one readable sentence instead of silence.
                -->
                <Grid Margin="2,0,2,10"
                      Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16"
                                     Margin="0,0,10,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WorkStage}" FontSize="{StaticResource TextSecondary}" />
                        <ProgressBar Height="4" Margin="0,4,0,0"
                                     Minimum="0" Maximum="1" Value="{Binding WorkPercent}"
                                     IsIndeterminate="{Binding WorkIsIndeterminate}" />
                    </StackPanel>
                </Grid>

                <Border Margin="2,0,2,10" Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                        Visibility="{Binding WorkFailure, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="15" Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="{Binding WorkFailure}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Border>

                <!--
                    The timeline, and it is draggable.

                    Two mirrored waveforms: you above the line, the other party below. No recorder
                    that captures a call as one mixed stream can draw this, because it does not
                    know whose sound is whose at any moment; here it is two files, so the shape is
                    a fact rather than a guess.

                    Drawn here as well as on the contact page because this window is where somebody
                    reads a conversation properly, and reading involves going back. Without a
                    timeline the only way back is clicking a line you can still see — which fails
                    for exactly the passage you are hunting for, the one scrolled off the screen.
                -->
                <Grid Height="56" Margin="0,0,0,6" Background="Transparent" Cursor="Hand"
                      controls:Scrubbable.Player="{Binding Playback}"
                      ToolTip="Tıkla ya da sürükle — o andan dinlersin."
                      Visibility="{Binding Playback.IsLoaded, Converter={StaticResource BoolToVisibility}}">
                    <Viewbox Stretch="Fill">
                        <Canvas Width="1000" Height="68">
                            <Polygon Points="{Binding Playback.MicShape}"
                                     Fill="{StaticResource MeBrush}" Opacity="0.85" />
                            <Polygon Points="{Binding Playback.FarShape}"
                                     Fill="{StaticResource ThemBrush}" Opacity="0.85" />

                            <!-- Centre line, so the two bands read as one timeline. -->
                            <Line X1="0" Y1="34" X2="1000" Y2="34" StrokeThickness="0.6"
                                  Stroke="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <Line Y1="0" Y2="68" StrokeThickness="1.6"
                                  X1="{Binding Playback.PlayheadX}"
                                  X2="{Binding Playback.PlayheadX}"
                                  Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Canvas>
                    </Viewbox>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Transparent" Command="{Binding Playback.SkipBackCommand}"
                                   ToolTip="10 saniye geri">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <!--
                            One button that shows what it will do next. The old one drew a play
                            triangle at all times, so the only way to find out whether a silent
                            passage was playing was to press it and hear what changed.

                            Two icons in the Content with their visibility bound, rather than one
                            icon whose Symbol is swapped by a trigger. An element assigned to
                            ui:Button.Icon is held in a property rather than placed in the logical
                            tree, so a binding inside it has no DataContext to inherit and resolves
                            to nothing — the trigger would never fire and the pause state would be
                            invisible again, silently. Content is in the tree; this is the shape
                            the contact page already uses and it is known to work.
                        -->
                        <ui:Button Appearance="Transparent" Command="{Binding Playback.TogglePlayCommand}"
                                   ToolTip="Çal / duraklat">
                            <Grid>
                                <ui:SymbolIcon Symbol="Play24"
                                               Visibility="{Binding Playback.IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ui:SymbolIcon Symbol="Pause24"
                                               Visibility="{Binding Playback.IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </ui:Button>

                        <ui:Button Appearance="Transparent" Command="{Binding Playback.SkipForwardCommand}"
                                   ToolTip="10 saniye ileri">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <!--
                            Which voice, and it is a button rather than a label. The two sides are
                            recorded separately, so pulling one out of a passage where both talked
                            at once is possible here and nowhere else — but only if the control
                            says so by being pressable.
                        -->
                        <ui:Button Appearance="Transparent" Margin="8,0,0,0"
                                   Command="{Binding Playback.SwitchSpeakerCommand}"
                                   Content="{Binding Playback.ChannelName}"
                                   ToolTip="Tüm görüşme, sen, karşı taraf arasında geçiş yapar.">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="PersonVoice24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="14,0"
                               Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                               Text="{Binding TranscriptMessage}" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Playback.PositionText}"
                                   FontFamily="Consolas, Cascadia Mono, Segoe UI" />
                        <TextBlock Text=" / " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding Playback.DurationText}"
                                   FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
