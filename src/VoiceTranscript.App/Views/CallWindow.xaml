<ui:FluentWindow x:Class="VoiceTranscript.App.Views.CallWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
                 xmlns:controls="clr-namespace:VoiceTranscript.App.Controls"
                 xmlns:views="clr-namespace:VoiceTranscript.App.Views"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:CallWindowViewModel}"
                 Title="{loc:T callwindow.gorusme}"
                 Width="880" Height="720" MinWidth="640" MinHeight="560"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="30" Title="{Binding Title}" />

        <!-- One band under the title bar (which already shows the name — repeating it in 20pt
             spent a full line saying nothing new): the facts, the user's labels, and the two
             verbs a conversation being read most often needs. -->
        <StackPanel Grid.Row="1" Margin="20,0,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- One doorway for reminders: the dialog asks for the reason as well as
                         the day, so the card that comes back says why it came back. -->
                    <ui:Button Content="{loc:T callwindow.hatirlat}" Padding="10,4" Margin="0,0,6,0" Click="Remind_Click"
                               ToolTip="{loc:T callwindow.sebep-ve-tarihle-bir-hatirlatma-kurar-gunu}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Clock24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Content="{loc:T callwindow.onemlilere-ekle}" Padding="10,4" Click="ToBoard_Click"
                               ToolTip="{loc:T callwindow.ana-ekrandaki-onemli-gorusmeler-paneline-k}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Board24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <!-- Everything else a call can have done to it, where the call is read:
                         this is the window in which "wrong person / rubbish / delete" is decided. -->
                    <ui:DropDownButton Padding="8,4" Margin="6,0,0,0" ToolTip="{loc:T callwindow.diger-eylemler}">
                        <ui:DropDownButton.Icon>
                            <ui:SymbolIcon Symbol="MoreHorizontal24" />
                        </ui:DropDownButton.Icon>
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="{loc:T callwindow.baska-kisiye-tasi}" Click="Move_Click" />
                                <!-- The transcript list and the re-run lived beside the quality
                                     line; that band is gone, so they live here — and the count
                                     badge on the strip opens the same list one click nearer. -->
                                <MenuItem Header="{loc:T callwindow.dokumler}" Click="Versions_Click"
                                          ToolTip="{loc:T callwindow.bu-gorusmenin-butun-dokumleri-ve-hangi-mot}" />
                                <MenuItem Header="{loc:T callwindow.yeniden-yaziya-cevir}" Click="Retranscribe_Click"
                                          ToolTip="{loc:T callwindow.bu-gorusmeyi-baska-bir-motorla-bastan-yazi}" />
                                <MenuItem Header="{loc:T callwindow.yeniden-cozumle}" Click="Reanalyse_Click" />
                                <MenuItem Header="{loc:T callwindow.ses-dosyasinin-yerini-ac}" Click="ShowInFolder_Click" />
                                <Separator />
                                <MenuItem Header="{loc:T callwindow.gorusmeyi-sil}" Click="Delete_Click">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Delete24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </StackPanel>

                <!--
                    The user's labels on this conversation, on the same line as the date — one
                    band, not two. Their vocabulary, their spelling; a click on ✕ takes one off.
                    Wraps when labels multiply, so nothing is ever hidden to stay compact.
                -->
                <WrapPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Outlook dresses a category in an icon and a colour; so does a
                                 tag here. Both come from the user's own definitions, with a
                                 hashed colour for a word never defined. -->
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,4"
                                    Background="{Binding Converter={StaticResource TagBrush}}"
                                                                Cursor="Hand" MouseLeftButtonUp="TagPill_Click"
                                                                ToolTip="{loc:T callwindow.bu-etiketi-tasiyan-gorusmeleri-ara}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding Converter={StaticResource TagIcon}}"
                                                   FontSize="12" Foreground="White" Margin="0,0,4,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource PillText}" Foreground="White"
                                               Text="{Binding}" VerticalAlignment="Center" />
                                    <!-- Padded so the target is a fingertip, not a pinhead. -->
                                    <TextBlock Text="✕" FontSize="10" Foreground="White"
                                               Padding="7,3" Margin="2,-3,-6,-3"
                                               VerticalAlignment="Center" Cursor="Hand"
                                               ToolTip="{loc:T callwindow.etiketi-kaldir}"
                                               MouseLeftButtonUp="RemoveTag_Click" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Tag24" FontSize="14" Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Grid>
                        <!-- The dropdown is the Outlook category list: every suggestion wears
                             its own icon and colour, and clicking one tags the call there and
                             then — the styled pill IS the choice, not a preview of it. Typing
                             a brand-new word still works, committed with Enter or Etiketle. -->
                        <!-- Sized to the line the buttons make (30 px), not to the control's own
                             default: the box was the tallest thing on the band and set its height. -->
                        <ComboBox x:Name="TagBox" IsEditable="True" MinWidth="110" MinHeight="30" Padding="8,3"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding TagSuggestions}"
                                  Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}"
                                  DropDownClosed="TagBox_DropDownClosed"
                                  ToolTip="{loc:T callwindow.listeden-sec-ya-da-yaz-ve-enter-a-bas-orn}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Margin="0,2"
                                            HorizontalAlignment="Left"
                                            Background="{Binding Converter={StaticResource TagBrush}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding Converter={StaticResource TagIcon}}"
                                                           FontSize="12" Foreground="White" Margin="0,0,4,0"
                                                           VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource PillText}" Foreground="White"
                                                       Text="{Binding}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- The box looked like an empty mystery; the hint gives it a name.
                             HitTestVisible=False so it never steals a click from the box. -->
                        <TextBlock Text="{loc:T callwindow.etiket-ekle}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewTag}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- No "Etiketle" button: picking from the list already tags, and a typed
                         word commits with Enter — a button that repeats the Enter key was one
                         more control saying nothing new. -->

                    <!-- The wardrobe door: where tags get their icon and colour, and where the
                         default vocabulary is edited. Beside the box because the moment you
                         wish a tag looked different is the moment you are using one. -->
                    <ui:Button Margin="4,0,0,0" Padding="8,4" Appearance="Transparent"
                               Click="ManageTags_Click" ToolTip="{loc:T callwindow.etiketleri-duzenle-ad-simge-renk}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
                </WrapPanel>
            </Grid>

            <!-- The attention strip: visible on every tab, fed ONLY by the verified evidence
                 layers (pipeline flags and consistency findings — never the subjective
                 reading). It counts and points; it does not judge. One line, trimmed rather
                 than wrapped: it is a signpost to the Tutarlılık tab, and a signpost that
                 grows to two lines has taken the room the road needed. -->
            <Border Margin="0,6,0,0" Padding="12,6" CornerRadius="6" Cursor="Hand"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    Visibility="{Binding HasAttention, Converter={StaticResource BoolToVisibility}}"
                    MouseLeftButtonUp="Attention_Click"
                    ToolTip="{loc:T callwindow.tikla-tutarlilik-sekmesine-gider}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="16" Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{loc:T callwindow.dikkat-ceken-noktalar-var}" FontWeight="SemiBold" /><Run Text=" — " Foreground="{DynamicResource TextFillColorTertiaryBrush}" /><Run Text="{Binding AttentionLine, Mode=OneWay}" FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </TextBlock>
                </Grid>
            </Border>
        </StackPanel>

        <TabControl x:Name="MainTabs" Grid.Row="2" Margin="20,2,20,0" Padding="0,4,0,0"
                    Style="{StaticResource SegmentedTabs}">

            <!-- ================= the conversation ================= -->
            <TabItem Header="{loc:T callwindow.gorusme}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        One strip for everything said ABOUT the text, so the text gets the rest.

                        What produced these words and how sure it was — a transcript is evidence,
                        and evidence with unstated provenance is worth less than it looks; who did
                        the talking, with the seconds behind it; how many transcripts the call has
                        had; and which way to read the lines. These were three bands and ninety
                        pixels at the top of a window whose reader had asked for the words. Each
                        sentence keeps its full length in a tooltip when the strip must trim it.
                    -->
                    <Grid Grid.Row="0" Margin="0,0,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="15" Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding QualityLine, Converter={StaticResource NullToCollapsed}}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QualityIsPoor}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>

                        <TextBlock Grid.Column="1" Text="{Binding QualityLine}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding QualityLine}"
                                   Visibility="{Binding QualityLine, Converter={StaticResource NullToCollapsed}}" />

                        <!-- Who did the talking — the same thin bar the contacts page wears, here
                             at the user's request. Facts with seconds behind them; the
                             interruption line is a count, never a complaint. -->
                        <Grid Grid.Column="2" Width="72" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                              Visibility="{Binding HasTalkStats, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding TalkRatio, Converter={StaticResource RatioStar}, ConverterParameter=me}" />
                                <ColumnDefinition Width="{Binding TalkRatio, Converter={StaticResource RatioStar}, ConverterParameter=them}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource MeBrush}"
                                    CornerRadius="3,0,0,3" />
                            <Border Grid.Column="1" Background="{DynamicResource ThemBrush}"
                                    CornerRadius="0,3,3,0" />
                        </Grid>

                        <TextBlock Grid.Column="3" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasTalkStats, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.ToolTip>
                                <TextBlock>
                                    <Run Text="{Binding TalkSummary, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding InterruptionSummary, Mode=OneWay}" />
                                </TextBlock>
                            </TextBlock.ToolTip>
                            <Run Text="{Binding TalkSummary, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding InterruptionSummary, Mode=OneWay}" />
                        </TextBlock>

                        <!-- Every transcript this call has had, and the engine each came from. A
                             count that opens the list: a badge that only counted would be the
                             far-away button of complaint 5 in another coat. -->
                        <ui:Button Grid.Column="4" Appearance="Transparent" Padding="4,2" Margin="0,0,10,0"
                                   VerticalAlignment="Center" Click="Versions_Click"
                                   ToolTip="{loc:T callwindow.bu-gorusmenin-butun-dokumleri-ve-hangi-mot}"
                                   Visibility="{Binding TranscriptVersionCount, Converter={StaticResource PositiveToVisibility}}">
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Style="{StaticResource PillText}"
                                           Text="{Binding TranscriptVersionCount, StringFormat={loc:T callwindow.n-dokum}}" />
                            </Border>
                        </ui:Button>

                        <!-- Two ways of reading the same lines. The list is a chat, which is what
                             most calls are; the timeline puts each line at the moment it was said,
                             which is the only honest picture of a call where people talk over each
                             other. Remembered, because it is a preference and not a per-call
                             decision. -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="{loc:T callwindow.sohbet}" GroupName="ConversationView"
                                         Style="{StaticResource ChipButton}" Padding="10,3"
                                         IsChecked="{Binding TimelineView, Converter={StaticResource InverseBool}}"
                                         ToolTip="{loc:T callwindow.satirlar-alt-alta-sohbet-gibi}" />
                            <RadioButton Content="{loc:T callwindow.zaman-cizgisi}" GroupName="ConversationView"
                                         Style="{StaticResource ChipButton}" Padding="10,3" Margin="4,0,0,0"
                                         IsChecked="{Binding TimelineView}"
                                         ToolTip="{loc:T callwindow.her-satir-soylendigi-anda-iki-sutun}" />
                        </StackPanel>
                    </Grid>

                    <!-- A floor under the transcript: below 240 px it stops being a conversation
                         and becomes a keyhole, and the bands above should give way, not this. -->
                    <ScrollViewer Grid.Row="1" x:Name="TranscriptScroller" MinHeight="240"
                                  VerticalScrollBarVisibility="Auto" Padding="0,4,10,4"
                                  PreviewMouseWheel="OnTranscriptWheel" PreviewKeyDown="OnTranscriptKey"
                                  Visibility="{Binding HasTurns, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl x:Name="TranscriptTurns" ItemsSource="{Binding Turns}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TimelineView}" Value="True">
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate>
                                                        <views:TimelinePanel
                                                            RuleBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                            MineBrush="{DynamicResource MeBrush}"
                                                            TheirsBrush="{DynamicResource ThemBrush}" />
                                                    </ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        Laid out as an exchange because that is what it was. Mine on
                                        the right, theirs on the left — the arrangement everyone
                                        already reads without being taught.

                                        Clicking a bubble plays from it. Checking a sentence against
                                        the audio is the one action this product asks people to
                                        perform, so it has to cost one click; anything more and the
                                        verification simply does not happen.
                                    -->
                                    <Grid Margin="0,3">
                                        <Border MaxWidth="520" Padding="12,9" CornerRadius="8"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="Turn_Click"
                                                ToolTip="{loc:T callwindow.bu-andan-itibaren-dinle-sag-tikla-kesit-ci}"
                                                HorizontalAlignment="{Binding IsMe, Converter={StaticResource SpeakerAlignment}}"
                                                Background="{Binding IsMe, Converter={StaticResource SpeakerBackground}}">

                                            <!--
                                                Cutting an exchange out of a call.

                                                The unit is a line plus the replies that followed
                                                it, because that is the unit people argue about. An
                                                answer on its own invites "you took that out of
                                                context", and the answer to that has to be built
                                                into what gets exported rather than argued about
                                                afterwards — so the menu counts replies, and the
                                                words are written beside the audio with the date on
                                                them.
                                            -->
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:T callwindow.ses-kesiti-cikar}">
                                                        <MenuItem Header="{loc:T callwindow.yalnizca-bu-satir}" Tag="0"
                                                                  Click="ExportExchange_Click" />
                                                        <MenuItem Header="{loc:T callwindow.bu-satir-ve-cevabi}" Tag="1"
                                                                  Click="ExportExchange_Click" />
                                                        <MenuItem Header="{loc:T callwindow.bu-satir-ve-sonraki-3}" Tag="3"
                                                                  Click="ExportExchange_Click" />
                                                        <MenuItem Header="{loc:T callwindow.bu-satir-ve-sonraki-5}" Tag="5"
                                                                  Click="ExportExchange_Click" />
                                                        <MenuItem Header="{loc:T callwindow.bu-satir-ve-sonraki-10}" Tag="10"
                                                                  Click="ExportExchange_Click" />
                                                    </MenuItem>

                                                    <Separator />

                                                    <MenuItem Header="{loc:T callwindow.bu-andan-itibaren-dinle}"
                                                              Click="PlayFromHere_Click" />
                                                    <MenuItem Header="{loc:T callwindow.metni-kopyala}"
                                                              Click="CopyTurn_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold"
                                                               FontSize="{StaticResource TextCaption}" />
                                                    <TextBlock Text="{Binding Time}" Margin="8,0,0,0"
                                                               FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                                               FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                                    <!-- Marked rather than hidden: an uncertain line
                                                         is still evidence, and pretending otherwise
                                                         would quietly drop part of the conversation. -->
                                                    <TextBlock Text="{loc:T callwindow.belirsiz}" Margin="6,0,0,0"
                                                               FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                               Visibility="{Binding LowConfidence, Converter={StaticResource BoolToVisibility}}" />

                                                    <!-- Üst üste konuşma ve yankı. Aynı sebeple
                                                         işaretleniyor: ikisi de satırın nasıl
                                                         okunacağını değiştiriyor. Boşluğa söylenen
                                                         "tamam" onaydır, birinin üstüne söylenen
                                                         aynı kelime sözünü kesmektir. -->
                                                    <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="3"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding Note}"
                                                                   FontSize="{StaticResource TextCaption}"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <!-- Follows the player, so somebody reading
                                                             along does not lose their place after a
                                                             seek. -->
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="BorderThickness" Value="2" />
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Style="{StaticResource EmptyState}"
                                Visibility="{Binding HasTurns, Converter={StaticResource InverseBoolToVisibility}}">
                        <ui:SymbolIcon Symbol="DocumentText24" FontSize="32" HorizontalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource EmptyTitle}" Text="{Binding TranscriptMessage}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ================= what was extracted ================= -->
            <!-- ============ the analysis, one flat strip ============
                 First split into nested tabs, then flattened at the user's next look: two
                 stacked tab rows read as clutter. Every analysis surface now sits on the top
                 strip by its own name — and the subjective reading still cannot appear
                 mid-scroll between two pieces of evidence, because nothing scrolls past it. -->
            <TabItem Header="{loc:T callwindow.defter}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,10,4">
                    <StackPanel>

                        <!-- Complaint 7: the note stays, the tab says which text it read. -->
                        <StackPanel Margin="0,0,0,10"
                                    Visibility="{Binding IsSummaryStale, Converter={StaticResource BoolToVisibility}}">
                            <ui:InfoBar Severity="Warning" IsClosable="False" IsOpen="True"
                                        Title="{loc:T callwindow.ozet-ve-defter-onceki-dokumden}"
                                        Message="{Binding StaleDetail}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ui:Button Content="{loc:T callwindow.yeniden-cozumle}" Click="Reanalyse_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!--
                            What was just done to a row here, and the way back.

                            Said in the tab rather than as a toast: a ruling on a promise is the kind of act that
                            must not be one click away with no way back, and for as long as this line is on screen
                            it can be taken back with one.
                        -->
                        <Border Style="{StaticResource SettingCard}" Padding="10,6" Margin="0,0,0,10"
                                Visibility="{Binding LedgerUndo.Notice, Converter={StaticResource NullToCollapsed}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding LedgerUndo.Notice}" Style="{StaticResource Secondary}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <ui:Button Grid.Column="1" Content="{loc:T callwindow.geri-al}" Appearance="Transparent"
                                           Margin="8,0,0,0" Command="{Binding LedgerUndo.UndoCommand}"
                                           Visibility="{Binding LedgerUndo.CanUndo, Converter={StaticResource BoolToVisibility}}" />

                                <ui:Button Grid.Column="2" Content="✕" Appearance="Transparent" Padding="8,2"
                                           Command="{Binding LedgerUndo.ClearCommand}" />
                            </Grid>
                        </Border>

                        <!--
                            An action rather than an empty page.

                            A conversation with a transcript and no analysis is the ordinary state
                            when no model was connected at the time, and it was a dead end: the tab
                            said nothing and offered nothing. Analysing again works from the text,
                            so it costs a minute rather than the hours transcription would.
                        -->
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10"
                                Visibility="{Binding IsAnalysed, Converter={StaticResource InverseBoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T callwindow.bu-gorusme-cozumlenmemis}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Text="{loc:T callwindow.metin-hazir-cozumleme-sozleri-degisen-raka}" />
                                </StackPanel>

                                <ui:Button Grid.Column="1" Content="{loc:T callwindow.cozumle}" Appearance="Primary"
                                           Margin="14,0,0,0" VerticalAlignment="Center"
                                           Click="Analyse_Click"
                                           IsEnabled="{Binding HasTurns}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Lightbulb24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10"
                                Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:T callwindow.ozet}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                           Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10"
                                Visibility="{Binding Commitments.Count, Converter={StaticResource CountToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:T callwindow.sozler}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Commitments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Whose promise this is. "Sözler" without an owner reads as a
                                                             list of what you are owed; half of them may be what you owe. -->
                                                        <Border Grid.Column="0" CornerRadius="4" Padding="5,0" Margin="0,0,6,0"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource ThemBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ByMe}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource MeBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="White">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="O" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ByMe}" Value="True">
                                                                                <Setter Property="Text" Value="SEN" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- The user's wording when they gave one, the machine's otherwise;
                                                             the badge says which. -->
                                                        <TextBlock Grid.Column="1" Text="{Binding EffectiveObligation}" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Style="{StaticResource PillText}" Text="{loc:T callwindow.senin-duzeltmen}" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- The quote is the evidence; it plays. -->
                                                    <Border Background="Transparent" Cursor="Hand" Margin="0,2,0,0"
                                                            MouseLeftButtonUp="CommitmentQuote_Click"
                                                            ToolTip="{loc:T callwindow.alintiyi-dinle}">
                                                        <TextBlock Text="{Binding Quote}" Style="{StaticResource Caption}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <!--
                                                    The user's verbs, the same ones the ledger page has. Tutuldu is the one thing the
                                                    machine never concludes; ✎ and Ertele open the same dialog; Tutulmadı waits behind ⋯
                                                    because it is rare. Reddet stands 12 px apart — a ruling, not another look.
                                                -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                                    <ui:Button Content="{loc:T callwindow.tutuldu}" Appearance="Secondary" Padding="10,4"
                                                               ToolTip="{loc:T callwindow.bu-soz-tutuldu}"
                                                               Command="{Binding DataContext.FulfilCommitmentCommand,
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" />

                                                    <ui:Button Content="✎" Appearance="Transparent" Padding="8,4" Margin="6,0,0,0"
                                                               ToolTip="{loc:T callwindow.duzenle}" Click="PromiseEdit_Click" />

                                                    <ui:DropDownButton Padding="6,4" Margin="6,0,0,0"
                                                                       ToolTip="{loc:T callwindow.bu-sozle-ilgili-diger-kararlar}">
                                                        <ui:DropDownButton.Icon>
                                                            <ui:SymbolIcon Symbol="MoreHorizontal24" />
                                                        </ui:DropDownButton.Icon>
                                                        <ui:DropDownButton.Flyout>
                                                            <ContextMenu>
                                                                <MenuItem Header="{loc:T callwindow.ertele}" Click="PromiseEdit_Click" />
                                                                <MenuItem Header="{loc:T callwindow.tutulmadi}" Click="PromiseAbandon_Click" />
                                                            </ContextMenu>
                                                        </ui:DropDownButton.Flyout>
                                                    </ui:DropDownButton>

                                                    <ui:Button Content="{loc:T callwindow.reddet}" Appearance="Transparent" Padding="10,4" Margin="12,0,0,0"
                                                               ToolTip="{loc:T callwindow.bu-sozu-reddet}"
                                                               Command="{Binding DataContext.DismissCommitmentCommand,
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}"
                                Visibility="{Binding Flags.Count, Converter={StaticResource CountToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:T callwindow.isaretler}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Flags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                                    <Border Background="Transparent" Cursor="Hand" Margin="0,2,0,0"
                                                            MouseLeftButtonUp="FlagQuote_Click"
                                                            ToolTip="{loc:T callwindow.alintiyi-dinle}">
                                                        <TextBlock Text="{Binding Quote}" Style="{StaticResource Caption}"
                                                                   TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- A wrong finding is turned down here, and is not found again on the next run. -->
                                                <ui:Button Grid.Column="1" Content="{loc:T callwindow.reddet}" Appearance="Transparent"
                                                           Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Top"
                                                           ToolTip="{loc:T callwindow.bu-bulguyu-reddet}"
                                                           Command="{Binding DataContext.DismissFlagCommand,
                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Style="{StaticResource EmptyState}"
                                    Visibility="{Binding ShowEmptyLedger, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T callwindow.bu-gorusmeden-cikarilmis-bir-kayit-yok}" />
                            <TextBlock Style="{StaticResource EmptyBody}"
                                       Text="{loc:T callwindow.soz-verilmemis-rakam-ya-da-tarih-gecmemis}" />
                        </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!--
                            Aynam: what the user did while talking, in this one conversation.

                            The mirror page shows the curve across months; this is the report for
                            the call in front of them. Every figure is a count over a stated
                            denominator — their own speaking minutes, their own hundred words —
                            and the moments underneath are what a figure rests on. The other
                            party is not counted anywhere, and the tab says so rather than
                            leaving it to be assumed.
                        -->
                        <TabItem x:Name="MirrorTab" Header="{loc:T callwindow.aynam}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,10,4">
                                <StackPanel>

                        <!-- Complaint 7: the counts stay, the tab says which text they read. -->
                        <StackPanel Margin="0,0,0,10"
                                    Visibility="{Binding IsHabitsStale, Converter={StaticResource BoolToVisibility}}">
                            <ui:InfoBar Severity="Warning" IsClosable="False" IsOpen="True"
                                        Title="{loc:T callwindow.aynam-onceki-dokumden}"
                                        Message="{Binding StaleDetail}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ui:Button Content="{loc:T callwindow.yeniden-say}" Command="{Binding RecountCommand}"
                                           IsEnabled="{Binding IsRecounting, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T callwindow.bu-gorusmede-sen}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,8,0" TextWrapping="Wrap"
                                                   Text="{loc:T callwindow.karsi-taraf-sayilmaz}" />
                                    </StackPanel>

                                    <!-- The dictionary is the user's; a word added to it has to be
                                         answerable on the conversation in front of them. -->
                                    <ui:Button Grid.Column="1" VerticalAlignment="Center"
                                               Content="{loc:T callwindow.yeniden-say}"
                                               Command="{Binding RecountCommand}"
                                               IsEnabled="{Binding IsRecounting, Converter={StaticResource InverseBool}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <TextBlock Text="{Binding HabitLine}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           FontSize="{StaticResource TextBody}"
                                           Visibility="{Binding HabitLine, Converter={StaticResource NullToCollapsed}}" />

                                <TextBlock Text="{Binding HabitStamp}" Style="{StaticResource Caption}"
                                           Margin="0,8,0,0" HorizontalAlignment="Right"
                                           Visibility="{Binding HabitStamp, Converter={StaticResource NullToCollapsed}}" />

                                <StackPanel Style="{StaticResource EmptyState}"
                                            Visibility="{Binding HasHabits, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T callwindow.aynam-sayim-yok}" />
                                    <TextBlock Style="{StaticResource EmptyBody}" Text="{loc:T callwindow.aynam-sayim-yok-ne-yapmali}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ✎ The user's own line: what they meant not to say. Written in the intent
                             card, never by the machine, and absent when they wrote nothing. -->
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10"
                                Visibility="{Binding IntentText, Converter={StaticResource NullToCollapsed}}">
                            <StackPanel>
                                <TextBlock Text="{loc:T callwindow.niyet-karti}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding IntentText}" TextWrapping="Wrap" Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{loc:T callwindow.anlar}" Style="{StaticResource GroupHeader}" Margin="2,4,0,8"
                                   Visibility="{Binding HasHabitMoments, Converter={StaticResource BoolToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding HabitMoments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SettingCard}" Padding="14,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ui:Button Grid.Column="0" Appearance="Transparent" Padding="4,0"
                                                           Margin="0,0,8,0" ToolTip="{loc:T callwindow.alintiyi-dinle}"
                                                           Command="{Binding DataContext.PlayHabitMomentCommand,
                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Play24" FontSize="14" />
                                                        <TextBlock Text="{Binding Timestamp}" Style="{StaticResource Caption}"
                                                                   Margin="4,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ui:Button>

                                                <TextBlock Grid.Column="1" Text="{Binding Lexeme}" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,0"
                                                            Visibility="{Binding HasPill, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Style="{StaticResource PillText}" Text="{Binding Pill}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}">
                                                        <TextBlock Style="{StaticResource PillText}" Text="{Binding KindText}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <Border Style="{StaticResource QuoteBlock}" Margin="0,8,0,0"
                                                    Visibility="{Binding Context, Converter={StaticResource NullToCollapsed}}">
                                                <TextBlock Style="{StaticResource QuoteText}" Text="{Binding Context}" />
                                            </Border>

                                            <WrapPanel Margin="0,8,0,0">
                                                <ui:Button Content="{loc:T callwindow.dogru}" Margin="0,0,6,4"
                                                           Command="{Binding DataContext.HabitCorrectCommand,
                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Content="{loc:T callwindow.yanlis-duyulmus}" Margin="0,0,6,4"
                                                           Appearance="Secondary"
                                                           Command="{Binding DataContext.HabitMisheardCommand,
                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Content="{loc:T callwindow.bu-o-degil}" Margin="0,0,6,4"
                                                           Appearance="Secondary"
                                                           Command="{Binding DataContext.HabitNotThatCommand,
                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="ActionsTab" Header="{loc:T callwindow.aksiyonlar}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,10,4">
                                <StackPanel>

                        <!-- Complaint 7: the note stays, the tab says which text it read. -->
                        <StackPanel Margin="0,0,0,10"
                                    Visibility="{Binding IsActionsStale, Converter={StaticResource BoolToVisibility}}">
                            <ui:InfoBar Severity="Warning" IsClosable="False" IsOpen="True"
                                        Title="{loc:T callwindow.oneriler-onceki-dokumden}"
                                        Message="{Binding StaleDetail}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ui:Button Content="{loc:T callwindow.yeniden-cikar}" Command="{Binding ExtractActionsCommand}"
                                           IsEnabled="{Binding IsExtractingActions, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                        </StackPanel>

                        <!--
                            The user's proposed next moves. Suggestions, and the panel says so:
                            nothing here writes anywhere until the user clicks it there. Every
                            card rests on a verified, playable quote — an unanchored suggestion
                            was dropped before it got here.
                        -->
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T callwindow.onerilen-aksiyonlar}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,8,0"
                                                   Text="{loc:T callwindow.oneridir-sen-onaylamadan-hicbir-yere-yazil}" />
                                    </StackPanel>

                                    <!-- Manual trigger, because the automatic run only covers
                                         conversations analysed after the feature existed — the
                                         archive's older calls need a way in too. -->
                                    <ui:Button Grid.Column="1" VerticalAlignment="Center"
                                               Command="{Binding ExtractActionsCommand}"
                                               IsEnabled="{Binding IsExtractingActions, Converter={StaticResource InverseBool}}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="{loc:T callwindow.aksiyonlari-cikar}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasActions}" Value="True">
                                                        <Setter Property="Content" Value="{loc:T callwindow.yeniden-cikar}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="TaskListLtr24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                             Visibility="{Binding IsExtractingActions, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{Binding ActionsMessage}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding ActionsMessage, Converter={StaticResource NullToCollapsed}}" />

                                <ItemsControl ItemsSource="{Binding Actions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" Padding="0,8"
                                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="{Binding KindIcon}" FontSize="14"
                                                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Action}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding KindLabel}" Margin="10,0,0,0"
                                                                   Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DeadlineText, StringFormat='· {0}'}"
                                                                   Margin="6,0,0,0" Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding HasDeadline, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding Reason, Converter={StaticResource NullToCollapsed}}" />

                                                    <Border Background="Transparent" Cursor="Hand" Margin="0,4,0,0"
                                                            DataContext="{Binding Quote}"
                                                            MouseLeftButtonUp="Citation_Click"
                                                            ToolTip="{loc:T callwindow.dayandigi-ani-dinle}">
                                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   Text="{Binding Text, StringFormat='&quot;{0}&quot;'}" />
                                                    </Border>

                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <ui:Button Content="{loc:T callwindow.hatirlaticiya}" Appearance="Secondary" Padding="10,3"
                                                                   Margin="0,0,6,0" Click="ActionRemind_Click">
                                                            <ui:Button.Icon>
                                                                <ui:SymbolIcon Symbol="Clock24" />
                                                            </ui:Button.Icon>
                                                        </ui:Button>
                                                        <ui:Button Content="{loc:T callwindow.onemlilere}" Appearance="Secondary" Padding="10,3"
                                                                   Margin="0,0,6,0" Click="ActionBoard_Click">
                                                            <ui:Button.Icon>
                                                                <ui:SymbolIcon Symbol="Board24" />
                                                            </ui:Button.Icon>
                                                        </ui:Button>
                                                        <ui:Button Content="{loc:T callwindow.yaptim}" Appearance="Transparent" Padding="10,3"
                                                                   Margin="0,0,6,0" Click="ActionDone_Click" />
                                                        <ui:Button Content="{loc:T callwindow.gizle}" Appearance="Transparent" Padding="10,3"
                                                                   Click="ActionHide_Click"
                                                                   ToolTip="{loc:T callwindow.bu-oneri-bir-daha-gosterilmez}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding ActionsMessage}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding ActionsMessage, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="ConsistencyTab" Header="{loc:T callwindow.tutarlilik}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,10,4">
                                <StackPanel>

                        <!-- Complaint 7: the note stays, the tab says which text it read. -->
                        <StackPanel Margin="0,0,0,10"
                                    Visibility="{Binding IsConsistencyStale, Converter={StaticResource BoolToVisibility}}">
                            <ui:InfoBar Severity="Warning" IsClosable="False" IsOpen="True"
                                        Title="{loc:T callwindow.tutarlilik-onceki-dokumden}"
                                        Message="{Binding StaleDetail}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ui:Button Content="{loc:T callwindow.yeniden-denetle}" Command="{Binding CheckConsistencyCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!--
                            The consistency check. Not a lie detector, and the section says so:
                            every row below carries a quote that was machine-verified against
                            the transcript, plays on click, and the warning note exists only
                            when findings survived that verification. The user judges.
                        -->
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T callwindow.tutarlilik}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,8,0"
                                                   Text="{loc:T callwindow.celiski-cevapsiz-soru-ve-zaman-uyumsuzlukl}" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="1" Content="{loc:T callwindow.tutarliligi-denetle}"
                                               VerticalAlignment="Center"
                                               Command="{Binding CheckConsistencyCommand}"
                                               IsEnabled="{Binding IsCheckingConsistency, Converter={StaticResource InverseBool}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Search24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <!-- The price, before the spend: this is the app's most
                                     expensive single click, and it says so up front. -->
                                <TextBlock Text="{Binding ConsistencyCostLine}" Style="{StaticResource Caption}"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding ConsistencyCostLine, Converter={StaticResource NullToCollapsed}}" />

                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                             Visibility="{Binding IsCheckingConsistency, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{Binding ConsistencyProblem}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Visibility="{Binding ConsistencyProblem, Converter={StaticResource NullToCollapsed}}" />

                                <!-- The justified warning to the user — only ever shown standing
                                     on verified findings, and honest about what it is. -->
                                <Border CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                        Visibility="{Binding ConsistencyWarning, Converter={StaticResource NullToCollapsed}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <ui:SymbolIcon Symbol="Warning24" FontSize="14" Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            <TextBlock Text="{loc:T callwindow.uyari-notu}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ConsistencyWarning}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                   Text="{loc:T callwindow.bu-bir-modelin-gozlemidir-hukum-degildir}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding ConsistencyMessage}" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding ConsistencyMessage, Converter={StaticResource NullToCollapsed}}" />

                                <ItemsControl ItemsSource="{Binding ConsistencyFindings}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" Padding="0,8"
                                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="{Binding KindIcon}" FontSize="14"
                                                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ConfidenceLabel}" Margin="10,0,0,0"
                                                                   Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:T callwindow.ses-net-degil}" Margin="6,0,0,0"
                                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                                   Visibility="{Binding AudioUnclear, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                                    <!-- The evidence, playable: this is the product's spine. -->
                                                    <Border Background="Transparent" Cursor="Hand" Margin="0,4,0,0"
                                                            DataContext="{Binding Quote}"
                                                            MouseLeftButtonUp="Citation_Click"
                                                            ToolTip="{loc:T callwindow.bu-ani-dinlemek-icin-tikla}">
                                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   Text="{Binding Text, StringFormat='&quot;{0}&quot;'}" />
                                                    </Border>

                                                    <StackPanel Visibility="{Binding HasCounter, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding CounterHeading}" Style="{StaticResource Caption}"
                                                                   Margin="0,4,0,0" />
                                                        <Border Background="Transparent" Cursor="Hand"
                                                                DataContext="{Binding CounterQuote}"
                                                                MouseLeftButtonUp="ConsistencyCounter_Click"
                                                                ToolTip="{loc:T callwindow.karsi-ifadeye-git}">
                                                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                       Text="{Binding Text, StringFormat='&quot;{0}&quot;'}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- The advice made executable: two clicks
                                                         from the finding to a dated reminder. -->
                                                    <ui:Button Content="{loc:T callwindow.hatirlatici-kur}" Appearance="Transparent"
                                                               Padding="8,2" Margin="0,6,0,0"
                                                               HorizontalAlignment="Left"
                                                               Click="ConsistencyRemind_Click"
                                                               ToolTip="{loc:T callwindow.sebep-bulgudan-hazir-gelir-gunu-sen-secers}">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="Clock24" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- What held together — the tool observes, it does not prosecute. -->
                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding ConsistencyObservations.Count, Converter={StaticResource CountToVisibility}}">
                                    <TextBlock Text="{loc:T callwindow.tutarli-gorunen-noktalar}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding ConsistencyObservations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="13" Margin="0,2,6,0"
                                                                   VerticalAlignment="Top"
                                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="640"
                                                               Style="{StaticResource Caption}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Text="{Binding ConsistencyStamp}" Style="{StaticResource Caption}"
                                           Margin="0,8,0,0" HorizontalAlignment="Right"
                                           Visibility="{Binding ConsistencyStamp, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Border>

                        <!--
                            The opt-in assessment. The user asked for a plain opinion as a
                            switch, and got one — packaged as an opinion: hatted, signed, its
                            level qualitative, and every asserted tactic playable because its
                            quote verified. Off means not just empty but absent.
                        -->
                        <Border Style="{StaticResource Panel}" Margin="0,10,0,0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding DeceptionEnabled, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T callwindow.yalan-ve-manipulasyon-degerlendirmesi}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" FontStyle="Italic" Margin="0,2,8,0"
                                                   Text="{loc:T callwindow.modelin-gorusudur-metinden-cikarim-gercegi}" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="1" VerticalAlignment="Center"
                                               Command="{Binding RunDeceptionCommand}"
                                               IsEnabled="{Binding IsDeceptionRunning, Converter={StaticResource InverseBool}}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="Değerlendir" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDeception}" Value="True">
                                                        <Setter Property="Content" Value="Yeniden değerlendir" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="ShieldError24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                             Visibility="{Binding IsDeceptionRunning, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{Binding DeceptionProblem}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Visibility="{Binding DeceptionProblem, Converter={StaticResource NullToCollapsed}}" />

                                <StackPanel Visibility="{Binding HasDeception, Converter={StaticResource BoolToVisibility}}">
                                    <!-- Complaint 7: the note stays, the tab says which text it read. -->
                                    <StackPanel Margin="0,0,0,10"
                                                Visibility="{Binding IsDeceptionStale, Converter={StaticResource BoolToVisibility}}">
                                        <ui:InfoBar Severity="Warning" IsClosable="False" IsOpen="True"
                                                    Title="{loc:T callwindow.degerlendirme-onceki-dokumden}"
                                                    Message="{Binding StaleDetail}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <ui:Button Content="{loc:T callwindow.yeniden-degerlendir}" Command="{Binding RunDeceptionCommand}"
                                                       IsEnabled="{Binding IsDeceptionRunning, Converter={StaticResource InverseBool}}" />
                                            <ui:Button Content="{loc:T callwindow.notu-sil}" Appearance="Transparent" Margin="8,0,0,0"
                                                       Command="{Binding DeleteDeceptionCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DeceptionLevelLine}" FontWeight="SemiBold" Margin="0,10,0,0" />

                                    <TextBlock Text="{Binding Deception.Assessment}" TextWrapping="Wrap" Margin="0,6,0,0" />

                                    <ItemsControl ItemsSource="{Binding Deception.Tactics}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,0,1" Padding="0,8"
                                                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding TacticLabel}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SpeakerLabel}" Style="{StaticResource Caption}"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding Quote}" Style="{StaticResource Caption}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0" Cursor="Hand"
                                                                   TextDecorations="Underline"
                                                                   MouseLeftButtonUp="DeceptionQuote_Click"
                                                                   ToolTip="{loc:T callwindow.tikla-bu-ani-calar}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding DeceptionStamp}" Style="{StaticResource Caption}"
                                               Margin="0,8,0,0" HorizontalAlignment="Right"
                                               Visibility="{Binding DeceptionStamp, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!--
                            The model's free reading — the one deliberately subjective surface,
                            at the user's explicit request. Its own tab, still signed and hatted,
                            so it can never be mistaken for the evidence in the tabs beside it;
                            and a dead end in the data model, so it never leaks anywhere else.
                            The whole tab disappears when the setting is off.
                        -->
                        <TabItem Header="{loc:T callwindow.okuma}"
                                 Visibility="{Binding CommentaryEnabled, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,10,4">
                                <StackPanel>

                        <!-- Complaint 7: the note stays, the tab says which text it read. -->
                        <StackPanel Margin="0,0,0,10"
                                    Visibility="{Binding IsReadingStale, Converter={StaticResource BoolToVisibility}}">
                            <ui:InfoBar Severity="Warning" IsClosable="False" IsOpen="True"
                                        Title="{loc:T callwindow.okuma-onceki-dokumden}"
                                        Message="{Binding StaleDetail}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ui:Button Content="{loc:T callwindow.yeniden-oku}" Command="{Binding RunReadingCommand}"
                                           IsEnabled="{Binding IsReadingRunning, Converter={StaticResource InverseBool}}" />
                                <ui:Button Content="{loc:T callwindow.notu-sil}" Appearance="Transparent" Margin="8,0,0,0"
                                           Command="{Binding DeleteReadingCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T callwindow.modelin-okumasi}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" FontStyle="Italic" Margin="0,2,8,0"
                                                   Text="{loc:T callwindow.oznel-yorumdur-bulgu-degildir-kanit-icin-d}" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="1" VerticalAlignment="Center"
                                               Command="{Binding RunReadingCommand}"
                                               IsEnabled="{Binding IsReadingRunning, Converter={StaticResource InverseBool}}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="{loc:T callwindow.okumasini-iste}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasReading}" Value="True">
                                                        <Setter Property="Content" Value="{loc:T callwindow.yeniden-oku}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="BookOpen24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <TextBlock Text="{Binding ConsistencyCostLine}" Style="{StaticResource Caption}"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding ConsistencyCostLine, Converter={StaticResource NullToCollapsed}}" />

                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                             Visibility="{Binding IsReadingRunning, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{Binding ReadingProblem}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Visibility="{Binding ReadingProblem, Converter={StaticResource NullToCollapsed}}" />

                                <StackPanel Visibility="{Binding HasReading, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Reading.GeneralReading}" TextWrapping="Wrap"
                                               Margin="0,10,0,0"
                                               Visibility="{Binding Reading.GeneralReading, Converter={StaticResource NullToCollapsed}}" />

                                    <TextBlock Text="{loc:T callwindow.muzakere-durumu}" FontWeight="SemiBold" Margin="0,10,0,2"
                                               Visibility="{Binding Reading.NegotiationState, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Text="{Binding Reading.NegotiationState}" TextWrapping="Wrap"
                                               Visibility="{Binding Reading.NegotiationState, Converter={StaticResource NullToCollapsed}}" />

                                    <TextBlock Text="{loc:T callwindow.uslup-gozlemleri}" FontWeight="SemiBold" Margin="0,10,0,2"
                                               Visibility="{Binding Reading.StyleObservations.Count, Converter={StaticResource CountToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Reading.StyleObservations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                    <Border Background="Transparent" Cursor="Hand"
                                                            MouseLeftButtonUp="ReadingQuote_Click"
                                                            Visibility="{Binding Quote, Converter={StaticResource NullToCollapsed}}">
                                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   Text="{Binding Quote, StringFormat='&quot;{0}&quot;'}" />
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{loc:T callwindow.riskli-noktalar}" FontWeight="SemiBold" Margin="0,10,0,2"
                                               Visibility="{Binding Reading.RiskPoints.Count, Converter={StaticResource CountToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Reading.RiskPoints}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Warning24" FontSize="13" Margin="0,2,6,0"
                                                                       VerticalAlignment="Top"
                                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="640" />
                                                    </StackPanel>
                                                    <Border Background="Transparent" Cursor="Hand" Margin="19,0,0,0"
                                                            MouseLeftButtonUp="ReadingQuote_Click"
                                                            Visibility="{Binding Quote, Converter={StaticResource NullToCollapsed}}">
                                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   Text="{Binding Quote, StringFormat='&quot;{0}&quot;'}" />
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{loc:T callwindow.cozulmeyenler}" FontWeight="SemiBold" Margin="0,10,0,2"
                                               Visibility="{Binding Reading.Unresolved.Count, Converter={StaticResource CountToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Reading.Unresolved}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- The mandatory counter-reading: a single narrative never
                                         stands alone in this product, even a chosen one. -->
                                    <TextBlock Text="{loc:T callwindow.baska-bir-okuma}" FontWeight="SemiBold" Margin="0,10,0,2" />
                                    <TextBlock Text="{Binding Reading.CounterReading}" TextWrapping="Wrap"
                                               FontStyle="Italic" />

                                    <TextBlock Text="{loc:T callwindow.sorulabilecek-sorular}" FontWeight="SemiBold" Margin="0,10,0,2"
                                               Visibility="{Binding Reading.SuggestedQuestions.Count, Converter={StaticResource CountToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Reading.SuggestedQuestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="•" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="640" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding ReadingStamp}" Style="{StaticResource Caption}"
                                               Margin="0,10,0,0" HorizontalAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

            <!-- ================= questions about this call ================= -->
            <TabItem Header="{loc:T callwindow.sor}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,4,10,4">
                        <ItemsControl ItemsSource="{Binding Conversation}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" Padding="12,9" CornerRadius="8" MaxWidth="560"
                                            HorizontalAlignment="{Binding FromUser, Converter={StaticResource SpeakerAlignment}}"
                                            Background="{Binding FromUser, Converter={StaticResource SpeakerBackground}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />

                                            <!-- The quotes are not decoration. An answer without them
                                                 is this product doing the one thing it exists not to
                                                 do: telling somebody what happened and asking to be
                                                 believed. -->
                                            <ItemsControl ItemsSource="{Binding Citations}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasCitations, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,3,0,0" Padding="8,5" CornerRadius="4"
                                                                Cursor="Hand"
                                                                MouseLeftButtonUp="Citation_Click"
                                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                           Style="{StaticResource Caption}" />
                                                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                           Text="{loc:T callwindow.dinlemek-icin-tikla}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1" Text="{Binding AskProblem}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding AskProblem, Converter={StaticResource NullToCollapsed}}" />

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Margin="0,0,8,0"
                                    PlaceholderText="{loc:T callwindow.bu-gorusme-hakkinda-sor-cevap-alintilarla}"
                                    Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                                    KeyDown="Question_KeyDown" />

                        <ui:Button Grid.Column="1" Content="{loc:T callwindow.sor}" Appearance="Primary"
                                   Command="{Binding AskCommand}"
                                   IsEnabled="{Binding IsAsking, Converter={StaticResource InverseBool}}" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= notes ================= -->
            <TabItem Header="{loc:T callwindow.notlar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Said plainly, because it is the one guarantee that makes notes worth
                         writing: reprocessing replaces the summary, the commitments and the flags,
                         and never touches this. -->
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,8"
                               Text="{loc:T callwindow.buraya-yazdiklarin-sana-aittir-gorusme-yen}" />

                    <TextBox Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" Padding="10"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock Text="{loc:T callwindow.kaydedildi}" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Visibility="{Binding NoteSaved, Converter={StaticResource BoolToVisibility}}" />

                        <ui:Button Content="{loc:T callwindow.notu-kaydet}" Appearance="Primary" Command="{Binding SaveNoteCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- The player stays put across tabs: somebody asking a question about a passage should
             not lose the passage by changing tab to ask.

             Gone altogether while there is nothing to play: an empty transport row was forty
             pixels the transcript wanted, on every call whose audio is missing. It comes back
             for the pipeline's own strips, because this is where a re-run reports. -->
        <Border Grid.Row="3" Margin="20,4,20,8" Padding="8,4" CornerRadius="6"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Playback.IsLoaded}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWorking}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WorkFailure, Converter={StaticResource NullToCollapsed}}"
                                     Value="Visible">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>

                <!-- One slot above the transport, three tenants: the waveform, or the pipeline's
                     progress, or its failure with the retry beside it. They used to stack, and a
                     call being transcribed again pushed the words up by two more bands. -->
                <Grid>

                    <!--
                        What the pipeline is doing to this conversation, while it does it.

                        This strip replaced a dialog that said "close the window and open it again
                        to see the result" — the application describing its own missing feature.
                        Now the request is watched from the window that made it: stage, progress,
                        and on failure one readable sentence instead of silence.
                    -->
                    <Grid Margin="2,0,2,4"
                          Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="16" Height="16"
                                         Margin="0,0,10,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WorkStage}" FontSize="{StaticResource TextSecondary}" />
                            <ProgressBar Height="4" Margin="0,4,0,0"
                                         Minimum="0" Maximum="1" Value="{Binding WorkPercent}"
                                         IsIndeterminate="{Binding WorkIsIndeterminate}" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="2,0,2,4" Padding="10,6" CornerRadius="6"
                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                            Visibility="{Binding WorkFailure, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="15" Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="{Binding WorkFailure}" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource TextSecondary}" />
                            <!-- The fix, beside the failure. -->
                            <ui:Button Content="{loc:T callwindow.tekrar-dene}" Appearance="Secondary" Padding="10,3"
                                       Margin="12,0,0,0" VerticalAlignment="Center" Click="Retranscribe_Click" />
                        </StackPanel>
                    </Border>

                    <!--
                        The timeline, and it is draggable.

                        Two mirrored waveforms: you above the line, the other party below. No recorder
                        that captures a call as one mixed stream can draw this, because it does not
                        know whose sound is whose at any moment; here it is two files, so the shape is
                        a fact rather than a guess.

                        Drawn here as well as on the contact page because this window is where somebody
                        reads a conversation properly, and reading involves going back. Without a
                        timeline the only way back is clicking a line you can still see — which fails
                        for exactly the passage you are hunting for, the one scrolled off the screen.
                    -->
                    <Grid Height="28" Margin="0,0,0,4" Background="Transparent" Cursor="Hand"
                          controls:Scrubbable.Player="{Binding Playback}"
                          ToolTip="{loc:T callwindow.tikla-ya-da-surukle-o-andan-dinlersin}">
                        <!-- Shown only when it is the slot's turn: no audio, a run in progress, a
                             failure, or the reader folding it away all give the row to somebody else. -->
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Playback.IsLoaded}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WorkFailure, Converter={StaticResource NullToCollapsed}}"
                                                 Value="Visible">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=PlayerFold}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Viewbox Stretch="Fill">
                            <Canvas Width="1000" Height="68">
                                <Polygon Points="{Binding Playback.MicShape}"
                                         Fill="{DynamicResource MeBrush}" Opacity="0.85" />
                                <Polygon Points="{Binding Playback.FarShape}"
                                         Fill="{DynamicResource ThemBrush}" Opacity="0.85" />

                                <!-- Centre line, so the two bands read as one timeline. -->
                                <Line X1="0" Y1="34" X2="1000" Y2="34" StrokeThickness="0.6"
                                      Stroke="{DynamicResource DividerStrokeColorDefaultBrush}" />

                                <Line Y1="0" Y2="68" StrokeThickness="1.6"
                                      X1="{Binding Playback.PlayheadX}"
                                      X2="{Binding Playback.PlayheadX}"
                                      Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Padded to the icon, not to a text button's default: the transport row
                             sets the player's folded height, and 32 px of button for a 16 px
                             glyph was a third of it. -->
                        <ui:Button Appearance="Transparent" Padding="8,3" Command="{Binding Playback.SkipBackCommand}"
                                   ToolTip="{loc:T callwindow.10-saniye-geri}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <!--
                            One button that shows what it will do next. The old one drew a play
                            triangle at all times, so the only way to find out whether a silent
                            passage was playing was to press it and hear what changed.

                            Two icons in the Content with their visibility bound, rather than one
                            icon whose Symbol is swapped by a trigger. An element assigned to
                            ui:Button.Icon is held in a property rather than placed in the logical
                            tree, so a binding inside it has no DataContext to inherit and resolves
                            to nothing — the trigger would never fire and the pause state would be
                            invisible again, silently. Content is in the tree; this is the shape
                            the contact page already uses and it is known to work.
                        -->
                        <ui:Button Appearance="Transparent" Padding="8,3" Command="{Binding Playback.TogglePlayCommand}"
                                   ToolTip="{loc:T callwindow.cal-duraklat}">
                            <Grid>
                                <ui:SymbolIcon Symbol="Play24"
                                               Visibility="{Binding Playback.IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ui:SymbolIcon Symbol="Pause24"
                                               Visibility="{Binding Playback.IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </ui:Button>

                        <ui:Button Appearance="Transparent" Padding="8,3" Command="{Binding Playback.SkipForwardCommand}"
                                   ToolTip="{loc:T callwindow.10-saniye-ileri}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <!--
                            Which voice, and it is a button rather than a label. The two sides are
                            recorded separately, so pulling one out of a passage where both talked
                            at once is possible here and nowhere else — but only if the control
                            says so by being pressable.
                        -->
                        <ui:Button Appearance="Transparent" Padding="8,3" Margin="8,0,0,0"
                                   Command="{Binding Playback.SwitchSpeakerCommand}"
                                   Content="{Binding Playback.ChannelName}"
                                   ToolTip="{loc:T callwindow.tum-gorusme-sen-karsi-taraf-arasinda-gecis}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="PersonVoice24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="14,0"
                               Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                               Text="{Binding TranscriptMessage}" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Playback.PositionText}"
                                   FontFamily="Consolas, Cascadia Mono, Segoe UI" />
                        <TextBlock Text=" / " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding Playback.DurationText}"
                                   FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- The fold. The waveform is for going back; somebody reading straight
                         through can hand its rows to the transcript and take them back later. -->
                    <ToggleButton x:Name="PlayerFold" Grid.Column="3" Padding="6,3" Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  ToolTip="{loc:T callwindow.dalgayi-katla-ya-da-ac}"
                                  Visibility="{Binding Playback.IsLoaded, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="14"
                                           Visibility="{Binding IsChecked, ElementName=PlayerFold, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ui:SymbolIcon Symbol="ChevronUp24" FontSize="14"
                                           Visibility="{Binding IsChecked, ElementName=PlayerFold, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </ToggleButton>
                </Grid>
            </StackPanel>
        </Border>

        <!-- In-window dialog layer: Dialogs.ConfirmAsync/InfoAsync present here, over
             everything, instead of the Win32-gray MessageBox. -->
        <ContentPresenter x:Name="DialogHost" Grid.RowSpan="99" Grid.ColumnSpan="99"
                          Panel.ZIndex="9999" />
    </Grid>
</ui:FluentWindow>
