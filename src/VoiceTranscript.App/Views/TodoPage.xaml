<UserControl x:Class="VoiceTranscript.App.Views.TodoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
             xmlns:controls="clr-namespace:VoiceTranscript.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TodoViewModel}">

    <UserControl.Resources>
        <!-- One row. The checkbox is the verb; the text is a way into the conversation. -->
        <DataTemplate x:Key="TodoRow" DataType="{x:Type vm:TodoEntry}">
            <!--
                The line itself opens the conversation.

                The verb used to be a single small button at the far right edge of a wide row,
                separated from the words it belonged to by the width of the window — reachable in
                the sense that a target is reachable, not in the sense that anybody would aim for
                it. The text is the thing being read, so the text is the thing that is clicked;
                the buttons stay for the actions that are not "show me this".
            -->
            <Border Background="Transparent" CornerRadius="4" Padding="6,5" Margin="0,1"
                    Cursor="{Binding HasCall, Converter={StaticResource HandWhenTrue}}"
                    MouseLeftButtonUp="Row_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding IsDone, Mode=OneWay}" VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock TextWrapping="Wrap" FontSize="{StaticResource TextBody}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0">
                            <Run Text="{Binding Glyph, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding SourceText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ContactName, Mode=OneWay}" />
                        </TextBlock>

                        <!--
                            ⌂ The sentence the suggestion rests on, and ▸ to hear it.

                            Every suggestion in this product is anchored to a verbatim, verified
                            quote and to the millisecond it was said — that is why "quote" and
                            "quote_start_ms" are NOT NULL. This screen used to read neither, so
                            it showed the machine's proposal with no way to check what was
                            actually said short of opening the conversation and hunting.

                            Only suggestions get this block. A note the user typed has no moment
                            in any conversation, and a row that borrowed one would be claiming
                            evidence it does not have — so the quoted bar is itself the boundary
                            between the machine's ground and the user's own writing.
                        -->
                        <Grid Margin="0,2,0,0"
                              Visibility="{Binding HasQuote, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Column="0" Appearance="Transparent" Padding="4,0" Margin="0,6,6,0"
                                       VerticalAlignment="Top"
                                       ToolTip="{loc:T todopage.soylendigi-ani-dinle}"
                                       Command="{Binding DataContext.PlayQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="14" />
                                    <TextBlock Text="{Binding QuoteTimestamp}" Style="{StaticResource Caption}"
                                               Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <Border Grid.Column="1" Style="{StaticResource QuoteBlock}">
                                <TextBlock Style="{StaticResource QuoteText}" Text="{Binding Quote}" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Due date and verbs in one group, so the row ends where the row ends. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DueText}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="12,0,4,0" />

                        <ui:Button Appearance="Transparent" Padding="6,2" Margin="2,0,0,0"
                                   ToolTip="{loc:T todopage.oneriyi-reddet}"
                                   Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                        </ui:Button>

                        <ui:Button Appearance="Transparent" Padding="6,2" Margin="2,0,0,0"
                                   ToolTip="{loc:T todopage.sil}"
                                   Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PadPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:T todopage.yapilacaklar}" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                   Text="{loc:T todopage.aciklama}" />

        <!-- Writing one down. Enter adds; the date and the person are both optional. -->
        <Border Grid.Row="2" Style="{StaticResource SettingCard}" Margin="0,4,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0" Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{loc:T todopage.yeni-ornek}" VerticalAlignment="Center">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>

                <!--
                    Who it is about, if it is about anybody.

                    The column has been there since the table was written and the list has always
                    shown the name it joins; there was simply no way to fill it, so every note the
                    user typed reached the list with the person's half of the row empty. Left
                    optional: a note to self is a whole to-do.
                -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding ContactChoices}"
                          SelectedItem="{Binding NewContact}" DisplayMemberPath="Name"
                          MinWidth="150" Margin="10,0,0,0" VerticalAlignment="Center"
                          ToolTip="{loc:T todopage.bu-yapilacagi-bir-kisiye-bagla}" />

                <DatePicker Grid.Column="2" SelectedDate="{Binding NewDue}" Margin="10,0,0,0" MinWidth="140"
                            VerticalAlignment="Center" />

                <ui:Button Grid.Column="3" Content="{loc:T todopage.ekle}" Appearance="Primary" Margin="10,0,0,0"
                           Command="{Binding AddCommand}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!--
            What just happened, and the way back — the shared strip, not a copy of it.

            Refusing a suggestion is permanent: it is recorded so the same one is never proposed
            again. That is exactly the kind of act that must not be one click away with no way
            back, and exactly the kind that should not raise a dialog either — so it happens, it
            is said quietly, and it can be undone for as long as this line is on screen.

            The copy that stood here bound UndoDismissCommand and ClearNoticeCommand: a third
            name for the two verbs the ledger and the promises already had, on a page that
            behaves identically to both.
        -->
        <controls:UndoBar Grid.Row="3" Slot="{Binding Undo}" Margin="0,0,0,8" />

        <!--
            Which source, for when the blended list is not the question being asked.

            A WrapPanel, not a row: there are already four things here and a narrow window pushed
            the last of them off the edge, where a filter is not merely hard to reach but
            invisible — the page then looks like it has three filters and one of them is stuck on.
        -->
        <WrapPanel Grid.Row="4" Margin="0,0,0,10">
            <ui:Button Content="{loc:T todopage.hepsi}" Margin="0,0,6,6" Command="{Binding ShowAllSourcesCommand}"
                       Appearance="{Binding Source, Converter={StaticResource FilterAppearance}, ConverterParameter=All}" />
            <ui:Button Content="{loc:T todopage.onerilenler}" Margin="0,0,6,6" Command="{Binding ShowSuggestionsCommand}"
                       Appearance="{Binding Source, Converter={StaticResource FilterAppearance}, ConverterParameter=Suggestions}" />
            <ui:Button Content="{loc:T todopage.kendi-yazdiklarim}" Margin="0,0,6,6" Command="{Binding ShowMineCommand}"
                       Appearance="{Binding Source, Converter={StaticResource FilterAppearance}, ConverterParameter=Mine}" />

            <!-- The finished section's switch belongs with the other filters, and says its count:
                 "did Yaptım leave a trace" is answered here, not at the bottom of a scrolled list. -->
            <CheckBox Content="{Binding ShowDoneText}" IsChecked="{Binding ShowDone}"
                      Margin="12,0,0,6" VerticalAlignment="Center" />
        </WrapPanel>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- An empty list is the first thing somebody sees on a new machine, and one
                     grey line saying "yok" tells them nothing about what would be here. -->
                <StackPanel Style="{StaticResource EmptyState}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="ClipboardTaskListLtr24" FontSize="38" HorizontalAlignment="Center"
                                   Margin="0,0,0,14"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T todopage.bos-baslik}" />
                    <TextBlock Style="{StaticResource EmptyBody}" Text="{loc:T todopage.bos}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasOverdue, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:T todopage.gecikmis}" Style="{StaticResource GroupHeader}" Margin="4,0,0,4"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <ItemsControl ItemsSource="{Binding Overdue}" ItemTemplate="{StaticResource TodoRow}" Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasToday, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:T todopage.bugun}" Style="{StaticResource GroupHeader}" Margin="4,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Today}" ItemTemplate="{StaticResource TodoRow}" Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasUpcoming, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:T todopage.yaklasan}" Style="{StaticResource GroupHeader}" Margin="4,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Upcoming}" ItemTemplate="{StaticResource TodoRow}" Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasUndated, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:T todopage.tarihsiz}" Style="{StaticResource GroupHeader}" Margin="4,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Undated}" ItemTemplate="{StaticResource TodoRow}" Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasDone, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:T todopage.bitenler}" Style="{StaticResource GroupHeader}" Margin="4,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource TodoRow}" Margin="0,0,0,12" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
