<ui:FluentWindow x:Class="VoiceTranscript.App.Views.MergeContactWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{loc:T mergecontactwindow.kisileri-birlestir}"
                 Width="460" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <StackPanel Margin="0,0,0,16">
        <ui:TitleBar Title="{loc:T mergecontactwindow.kisileri-birlestir}" />

        <StackPanel Margin="20,8,20,0">
            <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

            <TextBlock Text="{loc:T mergecontactwindow.hangi-kisi-buraya-katilsin}" Margin="0,16,0,6" FontWeight="SemiBold" />

            <ui:TextBox x:Name="SearchBox" PlaceholderText="{loc:T mergecontactwindow.kisi-ara}" TextChanged="SearchBox_TextChanged" />

            <ListBox x:Name="ContactList" MaxHeight="240" Margin="0,6,0,0"
                     SelectionChanged="ContactList_SelectionChanged"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,3">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Said before rather than after, because it cannot be undone from inside the
                 application: the absorbed contact stops existing. -->
            <Border Margin="0,14,0,0" Padding="12" CornerRadius="4"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning24" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" MaxWidth="360" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="{loc:T mergecontactwindow.vazgec}" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
                <ui:Button x:Name="MergeButton" Content="{loc:T mergecontactwindow.birlestir}" Appearance="Primary"
                           IsEnabled="False" Click="Merge_Click" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
