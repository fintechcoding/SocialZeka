<Window x:Class="VoiceTranscript.App.Views.TranscriptVersionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VoiceTranscript.App"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{loc:T transcriptversions.baslik}"
        Width="620" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <!--
        Every transcript this conversation has had, with the engine that produced it.

        The reason this screen exists is a question that could not be answered: which engine hears
        my calls better. Each run overwrote the last, so comparing two of them meant reading a log
        and re-running one by hand — and on the call that prompted this, the audio had been
        rewritten between the two runs, which made the comparison meaningless without anything
        saying so.

        The figures are the screen. A list of engine names would be a list of names; what decides
        the question is how many words came back, how many lines the engine itself was unsure
        about, and how much of the audible speech it covered at all.
    -->
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:T transcriptversions.baslik}" Style="{StaticResource PageTitle}" />

        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}" Margin="0,2,0,14"
                   Text="{loc:T transcriptversions.aciklama}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="Versions">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SettingCard}" Margin="0,0,0,8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Engine}" FontWeight="SemiBold"
                                                       FontSize="{StaticResource TextBody}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource PillText}"
                                                           Text="{loc:T transcriptversions.su-an-kullanilan}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding When}" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />

                                        <TextBlock Text="{Binding Figures}" Style="{StaticResource Caption}"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="1" Content="{loc:T transcriptversions.bunu-kullan}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisibility}}"
                                               Click="Restore_Click" Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="EmptyState" Style="{StaticResource EmptyState}" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource EmptyTitle}" Text="{loc:T transcriptversions.bos-baslik}" />
                    <TextBlock Style="{StaticResource EmptyBody}" Text="{loc:T transcriptversions.bos-govde}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--
            Said out loud, because putting an older transcript back does not put the ledger back.
            The entries quote the words they were made from, and silently repointing a quote at
            different words is the one thing this product must not do.
        -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="{loc:T transcriptversions.defter-uyarisi}" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="380" />

            <ui:Button Content="{loc:T transcriptversions.kapat}" Appearance="Primary" MinWidth="96"
                       Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
