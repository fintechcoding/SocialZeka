<UserControl x:Class="VoiceTranscript.App.Views.MirrorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoiceTranscript.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:VoiceTranscript.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MirrorViewModel}">

    <UserControl.Resources>
        <!--
            One card: the figure, the same figure over the window before, and an arrow.

            No colour anywhere. A green number beside a habit is the machine saying the user did
            well, which is exactly the judgement this product does not make. Up, down, level — the
            direction is measured, the meaning is the reader's.
        -->
        <DataTemplate x:Key="MirrorStatTemplate" DataType="{x:Type vm:MirrorStat}">
            <Border Style="{StaticResource SettingCard}" Padding="14,10" Margin="0,0,8,8"
                    MinWidth="158" MaxWidth="200">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding Value}" />
                        <TextBlock Text="{Binding Arrow}" Style="{StaticResource Caption}"
                                   Margin="6,0,0,6" VerticalAlignment="Bottom" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Label}" />

                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Previous}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Caption}"
                               Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            One counted moment. The words are the evidence, the ▸ plays them, and the three
            buttons are the only place a count is ever overruled — by a person who listened.
        -->
        <DataTemplate x:Key="MirrorMomentTemplate" DataType="{x:Type vm:MirrorMoment}">
            <Border Style="{StaticResource SettingCard}" Padding="14,10" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" Appearance="Transparent" Padding="4,0" Margin="0,0,8,0"
                                   ToolTip="{loc:T mirrorpage.ani-dinle}"
                                   Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="14" />
                                <TextBlock Text="{Binding Timestamp}" Style="{StaticResource Caption}"
                                           Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>

                        <TextBlock Grid.Column="1" Text="{Binding Head}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,0"
                                    Visibility="{Binding HasPill, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource PillText}" Text="{Binding Pill}" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock Style="{StaticResource PillText}" Text="{Binding KindText}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- The line it was said in. A disclosure has none: only its shape was counted. -->
                    <Border Style="{StaticResource QuoteBlock}" Margin="0,8,0,0"
                            Visibility="{Binding Context, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Style="{StaticResource QuoteText}" Text="{Binding Context}" />
                    </Border>

                    <WrapPanel Margin="0,8,0,0">
                        <ui:Button Content="{loc:T mirrorpage.dogru}" Margin="0,0,6,4"
                                   Command="{Binding DataContext.CorrectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{loc:T mirrorpage.yanlis-duyulmus}" Margin="0,0,6,4" Appearance="Secondary"
                                   Command="{Binding DataContext.MisheardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{loc:T mirrorpage.bu-o-degil}" Margin="0,0,6,4" Appearance="Secondary"
                                   Command="{Binding DataContext.NotThatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Every layer of the curve is positioned in absolute coordinates the layout worked out. -->
        <Style x:Key="CanvasPlaced" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}" />
            <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PadPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{loc:T mirrorpage.aynam}" Style="{StaticResource PageTitle}" />

            <ComboBox Grid.Column="1" ItemsSource="{Binding ContactChoices}" SelectedItem="{Binding SelectedContact}"
                      DisplayMemberPath="Name" MinWidth="170" VerticalAlignment="Center" Margin="12,0,0,0"
                      ToolTip="{loc:T mirrorpage.kisiye-gore-suz}" />

            <ComboBox Grid.Column="2" ItemsSource="{Binding EngineChoices}" SelectedItem="{Binding EngineChoice}"
                      MinWidth="150" VerticalAlignment="Center" Margin="8,0,0,0"
                      ToolTip="{loc:T mirrorpage.motora-gore-suz}" />
        </Grid>

        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}" Text="{loc:T mirrorpage.aciklama}" />

        <!-- How far back. The window before this one, of the same length, is what "önceki" means. -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <ui:Button Margin="0,0,6,6" Content="{loc:T mirrorpage.son-3-ay}"
                       Command="{Binding SetPeriodCommand}" CommandParameter="ThreeMonths"
                       Appearance="{Binding Period, Converter={StaticResource FilterAppearance}, ConverterParameter=ThreeMonths}" />
            <ui:Button Margin="0,0,6,6" Content="{loc:T mirrorpage.son-6-ay}"
                       Command="{Binding SetPeriodCommand}" CommandParameter="SixMonths"
                       Appearance="{Binding Period, Converter={StaticResource FilterAppearance}, ConverterParameter=SixMonths}" />
            <ui:Button Margin="0,0,6,6" Content="{loc:T mirrorpage.son-1-yil}"
                       Command="{Binding SetPeriodCommand}" CommandParameter="OneYear"
                       Appearance="{Binding Period, Converter={StaticResource FilterAppearance}, ConverterParameter=OneYear}" />
            <ui:Button Margin="0,0,6,6" Content="{loc:T mirrorpage.hepsi}"
                       Command="{Binding SetPeriodCommand}" CommandParameter="All"
                       Appearance="{Binding Period, Converter={StaticResource FilterAppearance}, ConverterParameter=All}" />

            <TextBlock Text="{Binding PeriodSummary}" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" Margin="14,0,0,6" />
        </WrapPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ⌂ Evidence: every one of these is a count over a denominator that is named. -->
                <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource MirrorStatTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="{loc:T mirrorpage.karsi-taraf-sayilmaz}" Style="{StaticResource Caption}"
                           Margin="2,2,0,0" TextWrapping="Wrap" />

                <!-- The honesty figure, and the three measures this page refuses to show. -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="{Binding PrecisionLine}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="2,0,0,0" />

                    <WrapPanel Margin="0,2,0,0">
                        <TextBlock Text="{loc:T mirrorpage.olculmeyenler}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="2,0,0,0" />
                        <ui:HyperlinkButton Content="{loc:T mirrorpage.sive-olculmuyor}" Padding="6,0"
                                            Command="{Binding ExplainCommand}" CommandParameter="sive" />
                        <ui:HyperlinkButton Content="{loc:T mirrorpage.rol-olculmuyor}" Padding="6,0"
                                            Command="{Binding ExplainCommand}" CommandParameter="rol" />
                        <ui:HyperlinkButton Content="{loc:T mirrorpage.duygu-olculmuyor}" Padding="6,0"
                                            Command="{Binding ExplainCommand}" CommandParameter="duygu" />
                    </WrapPanel>
                </StackPanel>

                <!-- ⌂ The curve. One dot per conversation, one line per engine. -->
                <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                    <StackPanel>
                        <WrapPanel>
                            <ui:Button Margin="0,0,6,6" Content="{loc:T mirrorpage.metrik-kufur}"
                                       Command="{Binding SetMetricCommand}" CommandParameter="Profanity"
                                       Appearance="{Binding Metric, Converter={StaticResource FilterAppearance}, ConverterParameter=Profanity}" />
                            <ui:Button Margin="0,0,6,6" Content="{loc:T mirrorpage.metrik-dolgu}"
                                       Command="{Binding SetMetricCommand}" CommandParameter="Filler"
                                       Appearance="{Binding Metric, Converter={StaticResource FilterAppearance}, ConverterParameter=Filler}" />
                            <ui:Button Margin="0,0,6,6" Content="{loc:T mirrorpage.metrik-hiz}"
                                       Command="{Binding SetMetricCommand}" CommandParameter="SpeechRate"
                                       Appearance="{Binding Metric, Converter={StaticResource FilterAppearance}, ConverterParameter=SpeechRate}" />
                            <ui:Button Margin="0,0,6,6" Content="{loc:T mirrorpage.metrik-pay}"
                                       Command="{Binding SetMetricCommand}" CommandParameter="TalkShare"
                                       Appearance="{Binding Metric, Converter={StaticResource FilterAppearance}, ConverterParameter=TalkShare}" />
                            <ui:Button Margin="0,0,6,6" Content="{loc:T mirrorpage.metrik-kesme}"
                                       Command="{Binding SetMetricCommand}" CommandParameter="Interruptions"
                                       Appearance="{Binding Metric, Converter={StaticResource FilterAppearance}, ConverterParameter=Interruptions}" />
                            <ui:Button Margin="0,0,6,6" Content="{loc:T mirrorpage.metrik-bilgi}"
                                       Command="{Binding SetMetricCommand}" CommandParameter="Disclosures"
                                       Appearance="{Binding Metric, Converter={StaticResource FilterAppearance}, ConverterParameter=Disclosures}" />
                        </WrapPanel>

                        <Grid Margin="0,8,0,0" HorizontalAlignment="Left"
                              Visibility="{Binding HasDots, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- The value axis: zero, half and a rounded ceiling. -->
                            <ItemsControl Grid.Column="0" Height="192" ItemsSource="{Binding ValueTicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter" BasedOn="{StaticResource CanvasPlaced}" />
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}"
                                                   Width="44" TextAlignment="Right" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Grid.Column="1" Width="900" Height="192" HorizontalAlignment="Left">

                                <!-- The floor of the axis, so a dot at zero has something to sit on. -->
                                <Border VerticalAlignment="Top" Height="170"
                                        BorderThickness="1,0,0,1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />

                                <!-- Where the engine changed. The curve is not drawn across one. -->
                                <ItemsControl ItemsSource="{Binding Breaks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="0" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Line X1="0" X2="0" Y1="0" Y2="{Binding Height}"
                                                  StrokeThickness="1" StrokeDashArray="3 3"
                                                  ToolTip="{Binding Tip}"
                                                  Stroke="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Runs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Polyline Points="{Binding Points}" StrokeThickness="1.6"
                                                      Stroke="{DynamicResource MeBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Dots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter" BasedOn="{StaticResource CanvasPlaced}" />
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Hollow where the call was likely without headphones: on
                                                 such a recording the attribution of a line is not trusted,
                                                 so the dot is drawn but not filled in. -->
                                            <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}"
                                                     Cursor="Hand" ToolTip="{Binding Tip}"
                                                     StrokeThickness="1.6"
                                                     Stroke="{DynamicResource MeBrush}"
                                                     MouseLeftButtonUp="Dot_Click">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource MeBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Hollow}" Value="True">
                                                                <!-- Transparent, not null: a hollow dot must still
                                                                     be clickable, and a null fill is not hit-tested. -->
                                                                <Setter Property="Fill" Value="Transparent" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding MonthTicks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter" BasedOn="{StaticResource CanvasPlaced}" />
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>

                        <TextBlock Text="{loc:T mirrorpage.egri-aciklama}" Style="{StaticResource Caption}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="{Binding CurveNote}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Visibility="{Binding CurveNote, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <!-- ⌂ The moments themselves. Nothing here is a conclusion; the user listens. -->
                <Grid Margin="0,14,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding MomentsHeader}" Style="{StaticResource GroupHeader}"
                               VerticalAlignment="Center" />

                    <CheckBox Grid.Column="1" Content="{loc:T mirrorpage.yalniz-dinlenmemisler}"
                              IsChecked="{Binding OnlyUnheard}" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="{Binding UncertainNote}" Style="{StaticResource Caption}" Margin="2,0,0,8"
                           TextWrapping="Wrap"
                           Visibility="{Binding UncertainNote, Converter={StaticResource NullToCollapsed}}" />

                <TextBlock Text="{Binding MomentsNote}" Style="{StaticResource Caption}" Margin="2,0,0,8"
                           TextWrapping="Wrap"
                           Visibility="{Binding MomentsNote, Converter={StaticResource NullToCollapsed}}" />

                <ItemsControl ItemsSource="{Binding Moments}" ItemTemplate="{StaticResource MirrorMomentTemplate}" />

                <TextBlock Text="{loc:T mirrorpage.bos}" Style="{StaticResource Caption}" Margin="2,4,0,16"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasMoments, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
