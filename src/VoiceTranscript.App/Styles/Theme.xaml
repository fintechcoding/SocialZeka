<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Design tokens.

        Every colour comes from the Windows Fluent palette rather than a hand-picked hex, so the
        window follows the user's own light or dark setting and their chosen accent colour. That
        is the difference between an application that looks like it belongs on the desktop and
        one that looks like a website someone pasted into a window frame.

        The type and spacing scales match the Windows 11 Settings app: 14 for body, 20 for a
        group header, 28 for a page title, and multiples of four for spacing.
    -->

    <sys:Double x:Key="TextCaption">12</sys:Double>
    <sys:Double x:Key="TextSecondary">13</sys:Double>
    <sys:Double x:Key="TextBody">14</sys:Double>
    <sys:Double x:Key="TextSubtitle">16</sys:Double>
    <sys:Double x:Key="TextTitle">20</sys:Double>
    <sys:Double x:Key="TextDisplay">28</sys:Double>

    <Thickness x:Key="PadCard">16,12</Thickness>

    <!-- One inset for every page. Seven different ones meant the left edge and the title moved
         a few pixels on every navigation, which reads as the window frame jumping. -->
    <Thickness x:Key="PadPage">24,4,24,16</Thickness>

    <!--
        How wide page content is allowed to grow.
        Three different values were in use — 1000, 860, 760 — so the left edge of the text moved
        depending on which page it was on, which is exactly the kind of thing that is invisible
        until it is fixed and then obvious.
    -->
    <sys:Double x:Key="PageMeasure">900</sys:Double>

    <CornerRadius x:Key="RadiusCard">4</CornerRadius>

    <!--
        The three colours that carry meaning rather than decoration.

        These are fixed rather than taken from the system palette, and deliberately so. The
        speaker stripe is an identity: if it borrowed the user's accent colour, "me" would be
        blue on one machine and orange on another, and a screenshot of a transcript would stop
        being readable. They are chosen to sit legibly on both a light and a dark card, and the
        stripe is never the only signal — the speaker's name is written beside it.
    -->
    <SolidColorBrush x:Key="MeBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="ThemBrush" Color="#7A7574" />
    <SolidColorBrush x:Key="GoodBrush" Color="#0F7B0F" />

    <!-- Text roles, straight from the system palette. -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- 14 under the subtitle rather than 24: it was the widest gap on every page, and the first
         card sat ten pixels lower than the eye expected — on every page, so fixed on every page. -->
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- Group header above a run of setting cards, as Windows 11 Settings uses. -->
    <Style x:Key="GroupHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!--
        Setting row.

        The shape every Windows 11 settings page uses: a bordered card holding an icon, a title
        with a line of explanation, and the control itself on the trailing edge. Consistent rows
        are most of why those pages feel orderly, and they let each option carry a sentence of
        explanation without the page turning into prose.
    -->
    <Style x:Key="SettingCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource PadCard}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Same surface, used for content rather than a control row. -->
    <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource SettingCard}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!--
        List rows.

        Selection uses the system accent as a leading bar rather than a filled block, matching
        the navigation pattern Windows itself uses and keeping dense lists readable.
    -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <Border x:Name="Accent" Width="3" Height="18" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CleanList" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <!-- Left-rail navigation, same selection language as the lists. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Accent" Width="3" Height="16" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Empty states. Every list needs one, or a fresh install just looks broken. -->
    <Style x:Key="EmptyState" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="400" />
        <Setter Property="Margin" Value="24,48,24,24" />
    </Style>

    <Style x:Key="EmptyTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="EmptyBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!--
        ============================ tabs ============================

        A segmented control rather than the default tab strip.

        The stock strip marks the selected tab with a hairline and a barely warmer background,
        which at a glance is no mark at all: on the call window somebody could not tell whether
        they were looking at the conversation or at the analysis without reading the content and
        working backwards. Tabs are navigation, and navigation that has to be deduced is broken.

        So the selected tab is a filled pill with a solid border and semibold text, and the rest
        are quiet. The difference survives a squint, which is the only test that matters.
    -->
    <Style x:Key="SegmentedTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource TextBody}" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Pill" CornerRadius="6" Padding="14,7" Background="Transparent"
                            BorderThickness="1" BorderBrush="Transparent"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Label" ContentSource="Header"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pill" Property="Background"
                                    Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            <Setter TargetName="Pill" Property="BorderBrush"
                                    Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The strip the pills sit on, with a rule under it.

        The rule matters more than it looks: without a line the tabs float over the content and a
        reader has no cue about which region the selection governs. With one, the pill visibly
        belongs to the panel below it.
    -->
    <Style x:Key="SegmentedTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentedTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="0,0,0,8"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <TabPanel IsItemsHost="True" Panel.ZIndex="1" KeyboardNavigation.TabIndex="1" />
                        </Border>

                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
