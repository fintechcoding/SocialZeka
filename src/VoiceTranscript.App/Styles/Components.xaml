<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        The pieces the application is assembled from.

        Tokens and text roles live in Theme.xaml; this file is the parts bin. Everything here is
        defined once so that a contact avatar, a state pill or a statistic reads identically on
        every screen — which is most of what separates an application that looks designed from
        one that looks assembled.
    -->

    <!-- ==================== surfaces ==================== -->

    <!--
        A card that responds to the pointer.

        Used wherever a card is actually clickable. The lift is deliberately small: at this size
        a strong hover reads as a button and invites a click on a surface that is mostly
        information, while no hover at all leaves the user unsure anything will happen.
    -->
    <Style x:Key="HoverCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The hero surface at the top of a page: slightly larger radius, more presence. -->
    <Style x:Key="HeroCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- A hairline between rows, at the exact weight Windows uses. -->
    <Style x:Key="Hairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <!-- ==================== avatars ==================== -->

    <!--
        Contact avatar.

        Initials on a colour derived from the name, so the same person is the same colour on
        every screen and in every session without storing anything. A list of names alone is
        much slower to scan — the colour is what lets the eye find somebody before it reads.
    -->
    <Style x:Key="Avatar" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AvatarLarge" TargetType="Border" BasedOn="{StaticResource Avatar}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
    </Style>

    <Style x:Key="AvatarText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AvatarTextLarge" TargetType="TextBlock" BasedOn="{StaticResource AvatarText}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- ==================== pills and badges ==================== -->

    <!--
        A small rounded label carrying one fact: which application, what state, how many flags.
        Neutral by default; the caller sets the background when the fact has a colour.
    -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Same shape, but for a count that needs to be noticed. -->
    <Style x:Key="CountPill" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="MinWidth" Value="22" />
    </Style>

    <Style x:Key="CountPillText" TargetType="TextBlock" BasedOn="{StaticResource PillText}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- ==================== statistics ==================== -->

    <!--
        A single number with its label.
        Deliberately no chrome of its own: several of these sit in one card, and giving each a
        border would turn a summary into a grid of boxes.
    -->
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ==================== level meter ==================== -->

    <!--
        The two bars shown while recording.

        This is the answer to "is it actually picking up sound", given while there is still time
        to do something about it. Everything else in the application can only report it
        afterwards, which is exactly when it is useless.
    -->
    <Style x:Key="MeterTrack" TargetType="Border">
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="MeterFill" TargetType="Border">
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ==================== transcript ==================== -->

    <!--
        A quoted line of speech.
        The bar on the leading edge does the work of quotation marks at a glance, and carries the
        speaker's colour so a ledger entry says who said it without a second label.
    -->
    <Style x:Key="QuoteBlock" TargetType="Border">
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Padding" Value="12,2,0,2" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="QuoteText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Timestamps are clickable everywhere: they seek the recording to that moment. -->
    <Style x:Key="TimeLink" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}" />
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== toolbars ==================== -->

    <Style x:Key="Toolbar" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,0,0,12" />
    </Style>

    <!-- A borderless icon button for a toolbar or a row's trailing edge. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== filter chips ==================== -->

    <!--
        A filter chip.

        Rounded and low-contrast until selected, then filled with the accent. Chips rather than a
        dropdown because the counts have to be visible before clicking: the first thing somebody
        wants from a ledger is the size of the problem, not a menu.
    -->
    <Style x:Key="ChipButton" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{StaticResource TextSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface" CornerRadius="16" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush"
                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== motion ==================== -->

    <!--
        Page entrance.

        Applied to each page host, so switching sections has a moment of movement instead of a
        hard cut. The duration is deliberately short: long enough to read as a transition rather
        than a flicker, short enough that somebody moving quickly between sections never waits
        for it. Anything more elaborate becomes tiring in an application used every day.
    -->
    <Style x:Key="PageHost" TargetType="UserControl">
        <Setter Property="RenderTransformOrigin" Value="0.5,0" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.16" />
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                From="10" To="0" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Page entrance.

        A short fade with a few pixels of travel. Long enough to register as a transition rather
        than a flicker, short enough that somebody moving quickly between pages never waits for
        it. Anything more elaborate becomes tiring in an application used every day.
    -->
    <Storyboard x:Key="PageEnter">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.16" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="8" To="0" Duration="0:0:0.20">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- The slow pulse on the recording indicator. Attention without alarm. -->
    <Storyboard x:Key="RecordingPulse" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0.25" Duration="0:0:0.9" AutoReverse="True">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

</ResourceDictionary>
